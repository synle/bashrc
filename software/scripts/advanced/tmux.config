#""""""""""""""""""""""""""""""""""""""""""""""""
# Terminal & Environment
#""""""""""""""""""""""""""""""""""""""""""""""""
## enable 256-color and true color support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

## reduce escape key delay (faster vim mode switching)
set -sg escape-time 10

## increase repeat timeout for key bindings
set -g repeat-time 600

## enable focus events (needed by vim/neovim autoread)
set -g focus-events on

## start window/pane numbering at 1 (matches keyboard layout)
set -g base-index 1
setw -g pane-base-index 1

## renumber windows when one is closed
set -g renumber-windows on

#""""""""""""""""""""""""""""""""""""""""""""""""
# Status bar - minimal, show tab numbers
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g status on
set -g status-style "bg=default,fg=white"
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "
set -g window-status-current-style "bg=white,fg=black"
set -g status-left ""
set -g status-right ""

## scroll history
set -g history-limit 30000

##  Window options
set -g monitor-activity off

## mouse support
set -g mouse on

## clipboard - use system clipboard for copy/paste
set -g set-clipboard on
set -g allow-passthrough on
## `copy` is an interactive bash function, not a binary - tmux runs every
## copy-pipe/run target through `sh -c` with no profile, so it must go through
## the sy-tmux-copy shim (written by tmux.js) which sources the profile first.
bind -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "sy-tmux-copy"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "sy-tmux-copy"

## prefix+y to capture entire visible pane to system clipboard
bind y capture-pane -p \; run "tmux capture-pane -p | sy-tmux-copy" \; display "Pane copied to clipboard"

## pane borders - active pane has bright border
set -g pane-border-style "fg=colour240"
set -g pane-active-border-style "fg=white,bold"
set -g pane-border-lines heavy

## Autorename sanely.
setw -g automatic-rename on

## new window in current path
bind c new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Prefix chords (ctrl+b then key) - see docs/editor-keybindings.md
#   [ copy mode (vim scroll/search)   , rename window   c new window
#   w window switcher                 x kill pane       n / p next / prev window
# All tmux defaults; only mode-keys is pinned so copy mode is vim, not emacs.
#""""""""""""""""""""""""""""""""""""""""""""""""
setw -g mode-keys vi

#""""""""""""""""""""""""""""""""""""""""""""""""
# Copy mode, vim-style. mode-keys vi alone does NOT give vim selection keys:
# stock tmux binds Space=begin-selection, Enter=copy, and v=rectangle-toggle,
# so `v` starts a block selection instead of a visual one and `y` does nothing.
# These bindings restore the vim mapping: v visual, C-v block, y yank.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi V send-keys -X select-line
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "sy-tmux-copy"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "sy-tmux-copy"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Splitting (matches Windows Terminal: alt+d vertical, alt+' horizontal)
# prefix+' mirrors the stock prefix+" split, but inherits the current folder.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind v split-window -c "#{pane_current_path}" -h
bind s split-window -c "#{pane_current_path}" -v
bind d split-window -h
bind "'" split-window -c "#{pane_current_path}" -v
bind -n M-d split-window -c "#{pane_current_path}" -h
bind -n M-S-d split-window -c "#{pane_current_path}" -v
bind -n M-"'" split-window -c "#{pane_current_path}" -v

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (matches Windows Terminal: alt+arrow)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (prefix + arrow) - restores tmux's stock select-pane. Resize
# is deliberately NOT bound here: tmux already ships prefix+ctrl-arrow (by 1)
# and prefix+alt-arrow (by 5), both repeatable, plus mouse border drag.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind Left select-pane -L
bind Right select-pane -R
bind Up select-pane -U
bind Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Close pane / window (matches Windows Terminal: alt+w close pane, alt+q close window)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-w kill-pane
bind -n M-q confirm-before -p "kill window? (y/n)" kill-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# Tabs / windows (matches Windows Terminal: alt+t new tab, alt+shift+[/] prev/next)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-t new-window -c "#{pane_current_path}"
bind -n M-"}" next-window
bind -n M-"{" previous-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# New window (matches Terminator: alt+n)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-n new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Find / search (matches Terminator/Windows Terminal: alt+f)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-f copy-mode \; send-keys /

#""""""""""""""""""""""""""""""""""""""""""""""""
# Switch to window by index (matches Windows Terminal: alt+1-9)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-1 select-window -t 0
bind -n M-2 select-window -t 1
bind -n M-3 select-window -t 2
bind -n M-4 select-window -t 3
bind -n M-5 select-window -t 4
bind -n M-6 select-window -t 5
bind -n M-7 select-window -t 6
bind -n M-8 select-window -t 7
bind -n M-9 select-window -t 8

#""""""""""""""""""""""""""""""""""""""""""""""""
# Rename window (matches Terminator/Windows Terminal: f2)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n F2 command-prompt -I "#W" "rename-window '%%'"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Toggle fullscreen pane (matches Windows Terminal: alt+\ / f11)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-\\ resize-pane -Z
bind -n F11 resize-pane -Z

#""""""""""""""""""""""""""""""""""""""""""""""""
# Plugins (managed by tpm - prefix+I to install)
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'

## tmux-resurrect: save/restore sessions across tmux server restarts
## prefix+Ctrl-s to save, prefix+Ctrl-r to restore
set -g @resurrect-capture-pane-contents 'on'

## initialize tpm (must be last line)
run -b '~/.tmux/plugins/tpm/tpm'
