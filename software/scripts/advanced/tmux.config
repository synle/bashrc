#""""""""""""""""""""""""""""""""""""""""""""""""
# Terminal & Environment
#""""""""""""""""""""""""""""""""""""""""""""""""
## enable 256-color and true color support
set -g default-terminal "tmux-256color"
## RGB on every outer terminal, not just xterm-256color: Ghostty reports
## TERM=xterm-ghostty, which an `xterm-256color:Tc` override never matched.
set -as terminal-features ",*:RGB"

## pass modified keys (shift+enter, ctrl+enter, etc) through to the app as CSI u
## without this tmux flattens shift+enter into a plain CR and opencode submits instead
## of inserting a newline
set -s extended-keys on
set -as terminal-features ",*:extkeys"

## let OSC 8 hyperlinks emitted by CLIs (ls --hyperlink, gh, etc) pass through to
## the outer terminal so they render clickable. tmux 3.4+; terminals without OSC 8
## support ignore the sequence.
set -as terminal-features ",*:hyperlinks"

## reduce escape key delay (faster vim mode switching)
set -sg escape-time 10

## increase repeat timeout for key bindings
set -g repeat-time 600

## enable focus events (needed by vim/neovim autoread)
set -g focus-events on

## start window/pane numbering at 1 (matches keyboard layout)
set -g base-index 1
setw -g pane-base-index 1

## renumber windows when one is closed
set -g renumber-windows on

#""""""""""""""""""""""""""""""""""""""""""""""""
# Status bar - minimal, show tab numbers
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g status on
set -g status-style "bg=default,fg=white"
## Explicit hex, not named colors: a terminal theme remaps `red` / `white` (a light
## theme turned them into dark red + grey, which was hard to read).
set -g window-status-current-style "bg=#e0201b,fg=#ffffff,bold"
## Inactive tabs are dimmed to a mid grey so the red current tab stands out.
## Mid grey (not near-black/near-white) stays readable on dark and light themes.
set -g window-status-style "fg=#8a8a8a"

## Tab label: `T<index>·<name>`, where <name> is the window's creation time
## (hh:mm:ss, stamped into @tab_time by the hooks below) until the window is
## renamed (rename-window turns automatic-rename off, then #W wins). The auto name
## is always the shell (`bash`), so it is never shown. Then `(N)` pane count when
## split, then `*` when a pane is zoomed (alt+z / alt+\ / F11).
## e.g. `T1·15:41:03` / `T4·logs (3) *`. Colors stay the normal tab colors.
## tmux has no window-creation-time format, hence the hooks; it also has no
## sub-second clock, so milliseconds are not available.
set-hook -g after-new-window 'run-shell "tmux set -w -t #{window_id} @tab_time $(date +%H:%M:%S)"'
set-hook -g session-created 'run-shell "tmux set -w -t #{window_id} @tab_time $(date +%H:%M:%S)"'

## Hide the status bar while a session has a single tab; show it again at 2+.
## `status` takes no format, so hooks re-evaluate it whenever the tab count
## changes. Array indexes keep these from replacing the @tab_time hooks above.
set-hook -g after-new-window[1] 'if -F "#{==:#{session_windows},1}" "set status off" "set status on"'
set-hook -g session-created[1] 'if -F "#{==:#{session_windows},1}" "set status off" "set status on"'
set-hook -g window-unlinked[1] 'if -F "#{==:#{session_windows},1}" "set status off" "set status on"'
set-hook -g client-session-changed[1] 'if -F "#{==:#{session_windows},1}" "set status off" "set status on"'
## tight tab row: no separator, and each label carries ONE leading space and
## no trailing one, so neighbours sit one column apart: [ T1·shell] T2·logs
set -g window-status-separator ""
set -g window-status-format " T#I·#{?automatic-rename,#{@tab_time},#W}#{?#{>:#{window_panes},1}, (#{window_panes}),}#{?window_zoomed_flag, *,}"
set -g window-status-current-format " T#I·#{?automatic-rename,#{@tab_time},#W}#{?#{>:#{window_panes},1}, (#{window_panes}),}#{?window_zoomed_flag, *,}"
set -g status-left ""
## session name badge at the right end of the tab row - DISABLED: the session
## name now leads every pane title as a badge (below), which
## stays visible at one window where this bar is hidden. Kept for reference.
## status-right must stay explicitly empty: dropping the line entirely brings
## back tmux's default (pane title + clock + date).
# set -g status-right "#[bg=#d0d0d0,fg=#000000,bold] #S #[default]"
set -g status-right ""

## scroll history
set -g history-limit 30000

##  Window options
set -g monitor-activity off

## mouse support
set -g mouse on

## clipboard - use system clipboard for copy/paste
set -g set-clipboard on
set -g allow-passthrough on

## OSC 52 - the only clipboard path that survives ssh and a headless host, where
## copy() has no pbcopy/wl-copy/xclip to hand off to and can only write its file
## history. tmux emits it solely when the OUTER terminal's terminfo carries an
## `Ms` capability, which ncurses ships for xterm-256color / tmux-256color but
## not for screen-256color or an unknown $TERM - so force it on every terminal.
## Terminals that do not implement OSC 52 ignore the sequence.
set -ga terminal-overrides ",*:Ms=\\E]52;%p1%s;%p2%s\\007"

## `copy` is an interactive bash function, not a binary - tmux runs every
## copy-pipe/run target through `sh -c` with no profile, so it must go through
## the sy-tmux-copy shim (written by tmux.js) which sources the profile first.
## Absolute path, not a bare name: the tmux SERVER's PATH is inherited from
## whatever started it, which is not always a profile-loaded shell.
bind -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"

## prefix+y used to copy only the VISIBLE screen. It now matches alt+y (whole
## scrollback, below) so every prefix+<key> does what alt+<key> does.
## NO leading `capture-pane -p` here: `-p` writes the pane to the COMMAND's
## stdout, and a key binding's stdout is the attached client's terminal, which
## tmux refuses with "Can't write to client" (verified on tmux 3.6a). Inside
## `run-shell` the same command has a pipe for stdout, so it works there - and
## that is the only copy that was ever doing anything. run-shell inherits
## TMUX_PANE from the pane the key was pressed in, so the default target is
## already the right pane.

## prefix+y / prefix+Y / alt+y copy the pane's WHOLE scrollback (-S - = oldest line), not
## just the visible screen. -J joins wrapped lines so long lines paste intact.
## On macOS, cmd+y reaches here too: Ghostty sends ESC y for it
## (ghostty-keys.common.jsonc), since cmd itself never reaches tmux.
## alt+y overrides bash yank-pop and vim alt+y redo inside tmux
## (vim alt+shift+z still redoes).
bind y run "tmux capture-pane -p -J -S - | $HOME/.local/bin/sy-tmux-copy --trim" \; display "Scrollback copied to clipboard"
bind Y run "tmux capture-pane -p -J -S - | $HOME/.local/bin/sy-tmux-copy --trim" \; display "Scrollback copied to clipboard"
bind -n M-y run "tmux capture-pane -p -J -S - | $HOME/.local/bin/sy-tmux-copy --trim" \; display "Scrollback copied to clipboard"

## pane borders - active pane border matches the red current-tab highlight
## (explicit hex so a light terminal theme cannot remap it); others stay dim.
set -g pane-border-style "fg=colour240"
set -g pane-active-border-style "fg=#e0201b,bold"
set -g pane-border-lines heavy

## Pane title bar on each split - two badges, then the pane part:
##   [ <session> ][ T<n> ] <pane>·<folder>·<command>
##   session  badge: black on gray #b2b2b2 - which workspace (any window count)
##   T<n>     badge: white on dark teal #004d4d (9.7:1) - which window/tab
## Badges, not plain colored text: both fg and bg are explicit hex, so they
## read the same on a dark or a light terminal theme (plain fg text on the
## theme's own background loses contrast on one of the two). Each badge has a
## clearly different fill from the white/black terminal background.
##   pane     red on the active pane, default elsewhere - `<pane#>` on a split;
##            a single-pane window shows the window name instead (@tab_time
##            until renamed, then #W), since the status bar is hidden at one tab
##   pane name badge: white on purple #5f00af - only when set (alt+shift+F2,
##            see below); sits right after T<n>, everything else follows
## The number after T<n> is the one shift+alt+1-9 jumps to.
## Badges, all black text on an explicit-hex background (named colors get
## remapped to low contrast by light terminal themes, same as the red tab):
##   ZOOM   blue    pane is zoomed - zoom hides the other panes and their
##                  borders, so the title bar is all that is left
##   PREFIX yellow  ctrl+b waits for its next key (active pane only)
##   COPY   green   pane is in copy mode (alt+g / prefix+g / alt+f)
## They ride on the title bar because the status bar is hidden at one tab.
## `#,` escapes the commas inside #{?...}.
set -g pane-border-status top
set -g pane-border-format " #[bg=#b2b2b2,fg=#000000,bold] #S #[default]#[bg=#004d4d,fg=#ffffff,bold] T#I #[default]#{?@pane_name,#[bg=#5f00af#,fg=#ffffff#,bold] #{@pane_name} #[default],} #{?pane_active,#[fg=#e0201b#,bold],}#{?#{==:#{window_panes},1},#{?automatic-rename,#{@tab_time},#W},#{pane_index}}·#{b:pane_current_path}·#{pane_current_command} #{?window_zoomed_flag,#[bg=#5fafff#,fg=#000000#,bold] ZOOM #[default] ,}#{?#{&&:#{pane_active},#{client_prefix}},#[bg=#ffd700#,fg=#000000#,bold] PREFIX #[default] ,}#{?pane_in_mode,#[bg=#2ecc40#,fg=#000000#,bold] COPY #[default] ,}"

## Dim inactive panes: default-colored text in unfocused panes turns mid grey so
## the focused pane stands out. Foreground only - a background tint would look
## wrong on either a light or a dark terminal theme. Colored program output keeps
## its own colors.
set -g window-style "fg=#8a8a8a"
set -g window-active-style "fg=default"

## Autorename sanely.
setw -g automatic-rename on

## Forward the active window's name to the OUTER terminal's tab/title bar.
## tmux swallows OSC 0/2 title escapes emitted inside a pane, so without this
## the outer tab (ghostty, etc.) never reflects what a pane is doing. With
## set-titles on, tmux redraws the outer title from set-titles-string whenever
## the active window or its name changes. #S·#W leads with the session name so
## the outer tab says WHICH workspace it is (visible even when tmux's own bar
## is hidden at one window), then the window name, which set_terminal_title
## (~/.local/bin) rewrites per agent milestone via `tmux rename-window`, so the
## tab tracks the live task state.
set -g set-titles on
set -g set-titles-string "#S·#W"

## new window in current path. prefix+n joins stock prefix+c as an alias - it
## overrides stock prefix+n (next-window), which now lives on prefix+. instead.
bind c new-window -c "#{pane_current_path}"
bind n new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Prefix chords (ctrl+b then key) - see docs/editor-keybindings.md
#   [ copy mode (vim scroll/search)   , / . prev / next window
#   w / Tab window switcher           x kill pane      c / n new window
#   r rename window
# Mostly tmux defaults; mode-keys is pinned so copy mode is vim, not emacs,
# , / . are rebound from rename-window / move-window to window navigation,
# n is rebound from next-window to new-window, and r from refresh-client to
# rename-window.
#""""""""""""""""""""""""""""""""""""""""""""""""
setw -g mode-keys vi

## Copy-mode colors. tmux's defaults use the terminal's PALETTE yellow / cyan /
## magenta, which a light theme remaps to washed-out tints - the yellow
## selection was hard to read. Explicit hex for both fg and bg reads the same
## on dark and light themes (contrast measured, WCAG):
##   selection + cursor line  white bold on blue #004a9f   8.5:1
##   search matches           black on amber #ffaf00       11.4:1
##   current match            black bold on pink #ff5fd7   7.9:1
## Blue for the selection keeps it clear of the amber/pink match colors, the
## red active-pane title, and the green COPY badge. mode-style also colors the
## choose-tree (alt+m) cursor row.
setw -g mode-style "bg=#004a9f,fg=#ffffff,bold"
setw -g copy-mode-match-style "bg=#ffaf00,fg=#000000"
setw -g copy-mode-current-match-style "bg=#ff5fd7,fg=#000000,bold"
## right-click menu highlighted item - same blue as the copy selection, for
## the same reason (default is palette yellow). tmux 3.4+.
set -g menu-selected-style "bg=#004a9f,fg=#ffffff,bold"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Copy mode, vim-style. mode-keys vi alone does NOT give vim selection keys:
# stock tmux binds Space=begin-selection, Enter=copy, and v=rectangle-toggle,
# so `v` starts a block selection instead of a visual one and `y` does nothing.
# These bindings restore the vim mapping: v visual, C-v block, y yank.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi V send-keys -X select-line
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Splitting (matches Windows Terminal: alt+d vertical, alt+' horizontal)
# prefix+' mirrors the stock prefix+" split, but inherits the current folder.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind v split-window -c "#{pane_current_path}" -h
bind s split-window -c "#{pane_current_path}" -v
bind d split-window -c "#{pane_current_path}" -h
bind "'" split-window -c "#{pane_current_path}" -v
bind -n M-d split-window -c "#{pane_current_path}" -h
bind -n M-S-d split-window -c "#{pane_current_path}" -v
bind -n M-"'" split-window -c "#{pane_current_path}" -v

## alt+0 promotes the current split into a window of its own (stock prefix+!).
## alt+0 is free precisely because `base-index 1` means there is no window 0, so
## it sits at the end of the alt+1-9 window-index row without colliding.
## The inverse has no key - run `join-pane -s <window>` from the prefix prompt.
bind -n M-0 break-pane

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (matches Windows Terminal: alt+arrow)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (prefix + arrow) - restores tmux's stock select-pane.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind Left select-pane -L
bind Right select-pane -R
bind Up select-pane -U
bind Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Resize panes (prefix + alt-arrow and prefix + ctrl-arrow). tmux's stock steps
# are 5 cells (alt) and 1 cell (ctrl), which take too many repeats to cross a
# wide pane - both are overridden to the same step so either chord moves the
# border the same distance. Mouse border drag still works.
# -r keeps them repeatable: hold the prefix once, then tap arrows.
# The step is <<RESIZE_PANE_CELLS>>, substituted from TMUX_CONFIG in tmux.js.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -r M-Left resize-pane -L <<RESIZE_PANE_CELLS>>
bind -r M-Right resize-pane -R <<RESIZE_PANE_CELLS>>
bind -r M-Up resize-pane -U <<RESIZE_PANE_CELLS>>
bind -r M-Down resize-pane -D <<RESIZE_PANE_CELLS>>
bind -r C-Left resize-pane -L <<RESIZE_PANE_CELLS>>
bind -r C-Right resize-pane -R <<RESIZE_PANE_CELLS>>
bind -r C-Up resize-pane -U <<RESIZE_PANE_CELLS>>
bind -r C-Down resize-pane -D <<RESIZE_PANE_CELLS>>

#""""""""""""""""""""""""""""""""""""""""""""""""
# Close pane / window (matches Windows Terminal: alt+w close pane, alt+q close window)
# alt+x is an alias for alt+w - same kill-pane, whichever finger gets there first.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-w kill-pane
bind -n M-x kill-pane
bind -n M-q confirm-before -p "kill window? (y/n)" kill-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# Tabs / windows (matches Windows Terminal: alt+t new tab, alt+shift+[/] prev/next)
# alt+tab / alt+shift+tab are the prev/next pair that actually fires on macOS+Ghostty.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-t new-window -c "#{pane_current_path}"
bind -n M-"}" next-window
bind -n M-"{" previous-window

## alt+tab / alt+shift+tab are the pair that actually fires on macOS+Ghostty. The
## M-{ / M-} bindings above are kept for other terminals but were verified NOT to
## match there: tmux forwards the raw ESC { / ESC } to the pane instead of
## consuming them, so the shifted-bracket chord is a no-op on this setup.
## Tab has no such problem - it collides with no escape-sequence introducer, unlike
## `[` (CSI) and `]` (OSC). BTab and S-Tab are both bound because tmux's key name
## for a back-tab depends on how the terminal reports it.
bind -n M-Tab next-window
bind -n M-BTab previous-window
bind -n M-S-Tab previous-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# Prev / next window on prefix+, and prefix+. - the unshifted keys under < and >,
# so the direction matches the arrow printed on the keycap. -r makes them
# repeatable: hold the prefix once, then tap , or . to walk the window list.
# These override tmux's stock prefix+, (rename-window) and prefix+. (move-window)
# - rename moves to prefix+r (plus F2 / alt+F2), and move-window is reachable
# from the prefix+: prompt.
# alt+, / alt+. are the same pair without the prefix, for walking several windows
# in a row. They join alt+tab / alt+shift+tab above rather than replacing it -
# same action, and whichever chord the terminal leaves alone will fire.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -r "," previous-window
bind -r "." next-window
bind -n M-, previous-window
bind -n M-. next-window

## alt+[ / alt+] are the same pair again. `[` and `]` are the CSI / OSC
## introducers, so tmux only resolves ESC [ / ESC ] as M-[ / M-] when nothing
## follows within escape-time; a real CSI/OSC sequence still parses normally.
## If a terminal splits a CSI sequence across reads, an arrow key could misfire
## as prev-window - drop these two lines if that ever shows up.
bind -n M-[ previous-window
bind -n M-] next-window
## prefix+[ / prefix+] match alt+[ / alt+]. Overrides stock prefix+[ (copy mode
## - now prefix+g, matching alt+g) and prefix+] (paste-buffer - the system
## clipboard paste covers it; `paste-buffer` stays on the prefix+: prompt).
bind -r [ previous-window
bind -r ] next-window

## prefix+Tab opens the same window/session switcher as stock prefix+w
## (choose-tree -Zw: -Z zooms the chooser pane, -w starts it collapsed to
## windows). Tab is unbound in tmux's stock prefix table, so this is a pure
## addition - prefix+w keeps working. It mirrors the alt+Tab window-walk above,
## and pairs with the alt-tab muscle memory for "show me the windows".
bind Tab choose-tree -Zw

## alt+m opens the same switcher without the prefix. `m` is unshifted and
## collides with no escape-sequence introducer, so it fires where the shifted
## chords do not. With 2+ sessions it starts collapsed to sessions (-s, one row
## each - fastest to scan); with one session it lists that session's windows
## (-w), since a single collapsed session row would just be an extra keypress.
bind -n M-m if -F "#{>:#{server_sessions},1}" "choose-tree -Zs" "choose-tree -Zw"
## prefix+m matches alt+m. Overrides stock prefix+m (mark pane, rarely used;
## `select-pane -m` stays on the prefix+: prompt).
bind m if -F "#{>:#{server_sessions},1}" "choose-tree -Zs" "choose-tree -Zw"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Key palette (alt+p, and prefix+? which stock tmux already uses for help).
# Stock prefix+? runs `list-keys -N`, which prints ONLY bindings carrying a -N
# note - so every chord in this file is invisible in the built-in help. The
# sy-tmux-keys shim (written by tmux.js) lists BOTH tables in full and pipes
# them through fzf, falling back to less where fzf is not on the server's PATH.
# -E closes the popup when the filter exits, so esc leaves no stray pane.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-p display-popup -E -w 80% -h 80% -T " tmux keys " "$HOME/.local/bin/sy-tmux-keys"
bind ? display-popup -E -w 80% -h 80% -T " tmux keys " "$HOME/.local/bin/sy-tmux-keys"

#""""""""""""""""""""""""""""""""""""""""""""""""
# URL picker (alt+u / alt+b - option+u / option+b on macOS - and prefix+u).
# With mouse on, tmux eats plain clicks, so a URL
# printed as plain text is not clickable. sy-tmux-urls (written by tmux.js)
# scrapes the pane's scrollback for http(s) URLs, newest first, lets fzf pick
# one or many (tab), and opens each in the default browser. #{pane_id} is the
# pane the key was pressed in - the popup itself is a different pane.
# alt+b ("browser") overrides bash backward-word inside tmux.
# Holding shift while clicking also bypasses tmux mouse capture in most
# terminals, so the terminal's own link handling works too.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-u display-popup -E -w 80% -h 60% -T " open url " "$HOME/.local/bin/sy-tmux-urls #{pane_id}"
bind -n M-b display-popup -E -w 80% -h 60% -T " open url " "$HOME/.local/bin/sy-tmux-urls #{pane_id}"
bind u display-popup -E -w 80% -h 60% -T " open url " "$HOME/.local/bin/sy-tmux-urls #{pane_id}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# New window (matches Terminator: alt+n)
# alt+t (above) and alt+/ do the same thing - three chords for one action, kept
# because each survives a different terminal: alt+n is the Terminator default,
# alt+t the Windows Terminal one, and alt+/ needs no letter key at all.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-n new-window -c "#{pane_current_path}"
bind -n M-/ new-window -c "#{pane_current_path}"
## prefix+/ matches alt+/. Overrides stock prefix+/ (describe-key, reachable as
## `list-keys` / the prefix+? palette).
bind / new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Find / search (matches Terminator/Windows Terminal: alt+f)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-f copy-mode \; send-keys /

## alt+g enters plain vim copy mode (same as prefix+g) without opening search -
## for scrolling back and selecting long output (v / V / C-v, then y).
bind -n M-g copy-mode
## alt+shift+g: same, escape hatch for when an app inside the pane takes alt+g.
bind -n M-G copy-mode
## prefix+g matches alt+g - the copy-mode chord now that prefix+[ walks windows.
## g is unbound in the stock prefix table, so this is a pure addition.
bind g copy-mode

#""""""""""""""""""""""""""""""""""""""""""""""""
# Switch to window by index (matches Windows Terminal: alt+1-9)
# Targets are 1-based to match `base-index 1` above - alt+1 is window 1, not 0.
# NOT ctrl+1-9: a terminal encodes those as legacy control characters, not as a
# distinct chord - ctrl+1 arrives as a bare `1`, ctrl+2 as NUL, ctrl+3 as ESC,
# ctrl+4 as FS. tmux therefore has nothing to match, and binding them would also
# shadow ESC. Verified on Ghostty + macOS; `set -s extended-keys on` does not
# help, because the terminal never emits the CSI-u form in the first place.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

#""""""""""""""""""""""""""""""""""""""""""""""""
# Focus pane by number: shift+alt+1-9 (shift+option+1-9 on macOS)
# The number is the one in each pane's title bar (pane-base-index 1 above).
# shift+digit reaches tmux as the SHIFTED character on a US layout, so the
# chord arrives as M-! / M-@ / ... / M-( - bound below. With extended-keys a
# terminal may instead report M-S-1..9, or keep the shift AND the shifted
# character (M-S-! ... M-S-(): Ghostty does both depending on mode. All three
# spellings are bound; an unbound one falls through to the pane, where bash
# reads ESC ! as complete-command ("Display all N possibilities?"). Other
# layouts shift digits to different characters; those keep prefix+q.
# `:.N` targets pane N of the CURRENT window; a missing pane is a no-op.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-! select-pane -t :.1
bind -n M-@ select-pane -t :.2
bind -n 'M-#' select-pane -t :.3
bind -n 'M-$' select-pane -t :.4
bind -n M-% select-pane -t :.5
bind -n M-^ select-pane -t :.6
bind -n M-& select-pane -t :.7
bind -n M-* select-pane -t :.8
bind -n M-( select-pane -t :.9
bind -n M-S-1 select-pane -t :.1
bind -n M-S-2 select-pane -t :.2
bind -n M-S-3 select-pane -t :.3
bind -n M-S-4 select-pane -t :.4
bind -n M-S-5 select-pane -t :.5
bind -n M-S-6 select-pane -t :.6
bind -n M-S-7 select-pane -t :.7
bind -n M-S-8 select-pane -t :.8
bind -n M-S-9 select-pane -t :.9
bind -n M-S-! select-pane -t :.1
bind -n M-S-@ select-pane -t :.2
bind -n 'M-S-#' select-pane -t :.3
bind -n 'M-S-$' select-pane -t :.4
bind -n M-S-% select-pane -t :.5
bind -n M-S-^ select-pane -t :.6
bind -n M-S-& select-pane -t :.7
bind -n M-S-* select-pane -t :.8
bind -n M-S-( select-pane -t :.9

## prefix then shift+1-9 (ctrl+b, then ! @ # ...): same pane jump, for terminals
## or layouts where the alt chord never reaches tmux. Replaces six stock prefix
## keys, each still reachable elsewhere: ! break-pane (alt+0), # list-buffers
## (prefix =), $ rename-session (prefix+F6), % split (alt+d /
## prefix v), & kill-window (alt+q), ( previous session (alt+m switcher).
bind ! select-pane -t :.1
bind @ select-pane -t :.2
bind '#' select-pane -t :.3
bind '$' select-pane -t :.4
bind % select-pane -t :.5
bind ^ select-pane -t :.6
bind & select-pane -t :.7
bind * select-pane -t :.8
bind ( select-pane -t :.9

#""""""""""""""""""""""""""""""""""""""""""""""""
# Rename window (matches Terminator/Windows Terminal: f2)
# alt+F2 is the one that works under Ghostty, which binds bare F2 to its own
# prompt_tab_title (ghostty-keys.common.jsonc) and consumes it before tmux sees
# it. Plain F2 is kept for terminals that leave the key alone.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n F2 command-prompt -I "#W" "rename-window '%%'"
bind -n M-F2 command-prompt -I "#W" "rename-window '%%'"

## alt+; renames the current window - the no-function-key chord, pairing with the
## alt+/ new-window above. `;` is unshifted, so it survives terminals that never
## deliver an alt+SHIFT+key chord at all.
## command-prompt takes AT MOST ONE template argument: a second one
## ("rename-window '%%'" followed by anything else) is rejected outright with
## `too many arguments`, the binding is never created, and the error prints on
## every server start.
bind -n M-";" command-prompt -I "#W" "rename-window '%%'"

## prefix+r renames too - the chord that survives a terminal or remote host
## swallowing alt and F-keys. This OVERRIDES stock prefix+r (refresh-client);
## a manual client redraw is rare and still reachable as `refresh-client` from
## the prefix+: prompt. Needed because prefix+, - tmux's own rename chord - is
## rebound to previous-window above.
bind r command-prompt -I "#W" "rename-window '%%'"
## prefix+F2 renames the window too, matching F2 / alt+F2 for anyone who
## reaches for the function key after the prefix. Unbound in stock tmux.
bind F2 command-prompt -I "#W" "rename-window '%%'"

## alt+shift+F2 (shift+option+F2 on macOS) renames the current PANE (split) -
## F2 is the window, shift narrows it to the pane. ctrl+shift+F2 and
## prefix+shift+F2 do the same; a modified function key arrives as its own CSI
## sequence, so tmux matches it directly - no terminal remap needed.
## The name lives in the pane option @pane_name, NOT tmux's pane_title: apps in
## the pane (vim, ssh, the shell prompt) overwrite pane_title via OSC 2 all the
## time, which would silently replace a name you typed. The pane title bar
## shows @pane_name after the pane number; submitting an empty name clears it.
bind -n M-S-F2 command-prompt -p "pane name:" -I "#{@pane_name}" "set -p @pane_name '%%'"
bind -n C-S-F2 command-prompt -p "pane name:" -I "#{@pane_name}" "set -p @pane_name '%%'"
bind S-F2 command-prompt -p "pane name:" -I "#{@pane_name}" "set -p @pane_name '%%'"

## Right-click menu - on a pane's title bar (MouseDown3Border) and inside a
## pane (MouseDown3Pane, replacing tmux's stock pane menu; a click on the
## title row is usually reported as a pane click). select-pane -t = first
## focuses the clicked split so every item acts on it. Grouped by scope, widest
## first - session, tab (window), pane split - for both rename and close:
##   rename: s session (prefix+F6)  t tab (F2)  p pane split (alt+shift+F2)
##   close:  S session  T tab  P pane split - each confirms first
## then splits (h v) and Break Pane to New Tab (b - alt+0, greyed out with one
## pane), swap / zoom (u d z), Open URLs (o - alt+u), Export Workspace (e -
## workspace_export, last), Find in Scrollback (f - same as
## alt+f), Copy Mode (g - vim scroll/select,
## same as alt+g), and Copy All Scrollback (y - same
## as alt+y: whole history, wrapped lines joined). The pane menu keeps the stock
## mouse-mode guard: when the app in the pane (vim, htop) owns the mouse the
## click passes through to it; hold alt/option to force the menu.
## Both lines share one item list - the PANE_MENU_ITEMS placeholder,
## substituted from TMUX_CONFIG in tmux.js - edit it there.
bind -n MouseDown3Border select-pane -t = \; display-menu -T "#[align=centre]#S · T#I · pane #{pane_index}" -t = -x M -y M <<PANE_MENU_ITEMS>>
bind -n MouseDown3Pane if -F -t = "#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}" { select-pane -t = ; send-keys -M } { select-pane -t = ; display-menu -T "#[align=centre]#S · T#I · pane #{pane_index}" -t = -x M -y M <<PANE_MENU_ITEMS>> }

## Right-click a TAB in the status bar (MouseDown3Status) - replaces tmux's
## stock window menu (Kill / Respawn / Mark and friends) with a short one.
## select-window -t = first focuses the clicked tab, so every item acts on it.
##   New Tab    n  - always appended after the last tab (-a -t {end}),
##                   never into a gap left by a closed one
##   New Tab (2 Vertical Split)   v - new tab split left | right (alt+d)
##   New Tab (2 Horizontal Split) h - new tab split top / bottom (alt+')
## Split names follow this repo (docs/editor-keybindings.md): vertical = the
## divider is vertical, panes side by side - tmux's own -h flag.
##   Rename Tab t  - same prompt as F2
##   Move Left / Right  l / r - swap with the neighbour, focus follows
##   Find in Scrollback (Active Pane) f - / search prompt in the clicked
##                   tab's focused split (same as alt+f)
##   Copy Mode (vim keys, Active Pane) g - vim scroll/select in the clicked
##                   tab's focused split (same as alt+g)
##   Copy Scrollback (Active Pane) y - whole history of the clicked tab's
##                   focused split only (same capture as alt+y)
##   Open URLs (Active Pane) o - fzf URL picker for that split (alt+u)
##   Export Workspace e - prompts for the path (prefilled ~/tmux_workspace_<stamp>.json);
##                   the file name becomes the session name (sy-tmux-export ->
##                   workspace_export; reopen with workspace_create <path>)
##   Close Tab  T  - last, confirms first (same key as the pane menu)
## Move items grey out ("-" prefix) when the session has a single tab.
bind -n MouseDown3Status select-window -t = \; display-menu -T "#[align=centre]T#I · #W" -t = -x W -y W "New Tab" n { new-window -a -t "{end}" -c "#{pane_current_path}" } "New Tab (2 Vertical Split)" v { new-window -a -t "{end}" -c "#{pane_current_path}" ; split-window -h -c "#{pane_current_path}" } "New Tab (2 Horizontal Split)" h { new-window -a -t "{end}" -c "#{pane_current_path}" ; split-window -v -c "#{pane_current_path}" } "" "Rename Tab" t { command-prompt -p "window name:" -I "#W" "rename-window '%%'" } "#{?#{>:#{session_windows},1},,-}Move Left" l { swap-window -d -t -1 } "#{?#{>:#{session_windows},1},,-}Move Right" r { swap-window -d -t +1 } "" "Find in Scrollback (Active Pane)" f { copy-mode ; send-keys / } "Copy Mode (vim keys, Active Pane)" g { copy-mode } "Copy Scrollback (Active Pane)" y { run "tmux capture-pane -p -J -S - -t #{pane_id} | $HOME/.local/bin/sy-tmux-copy --trim" ; display "Scrollback copied to clipboard" } "Open URLs (Active Pane)" o { display-popup -E -w 80% -h 60% -T " open url " "$HOME/.local/bin/sy-tmux-urls #{pane_id}" } "" "Export Workspace" e { run "$HOME/.local/bin/sy-tmux-export '#{session_name}'" } "" "Close Tab" T { confirm-before -p "close window T#I and all its panes? (y/n)" kill-window }
## prefix+F6 is the ONE session-rename chord (stock prefix+$ now jumps to pane
## 4). Prefix only, never bare F6: OpenCode binds F6 to its own session_rename
## (opencode-keys.common.jsonc), and a root binding would steal it from every
## opencode running inside tmux.
bind F6 command-prompt -p "session name:" -I "#S" "rename-session '%%'"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Toggle fullscreen pane (matches Windows Terminal: alt+\ / f11)
# alt+z mirrors the stock prefix+z chord without needing the prefix. tmux zoom is
# a binary toggle - it has no zoom levels, so there is no separate in/out key.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-\\ resize-pane -Z
bind -n F11 resize-pane -Z
bind -n M-z resize-pane -Z
## prefix+\ matches alt+\ (stock prefix+z keeps working). Unbound in stock tmux.
bind '\' resize-pane -Z

#""""""""""""""""""""""""""""""""""""""""""""""""
# Plugins (managed by tpm - prefix+I to install)
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'

## tmux-resurrect: save/restore sessions across tmux server restarts
## prefix+Ctrl-s to save, prefix+Ctrl-r to restore
set -g @resurrect-capture-pane-contents 'on'

## initialize tpm (must be last line)
run -b '~/.tmux/plugins/tpm/tpm'
