#""""""""""""""""""""""""""""""""""""""""""""""""
# Terminal & Environment
#""""""""""""""""""""""""""""""""""""""""""""""""
## enable 256-color and true color support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

## pass modified keys (shift+enter, ctrl+enter, etc) through to the app as CSI u
## without this tmux flattens shift+enter into a plain CR and opencode submits instead
## of inserting a newline
set -s extended-keys on
set -as terminal-features ",xterm*:extkeys"
set -as terminal-features ",*:extkeys"

## reduce escape key delay (faster vim mode switching)
set -sg escape-time 10

## increase repeat timeout for key bindings
set -g repeat-time 600

## enable focus events (needed by vim/neovim autoread)
set -g focus-events on

## start window/pane numbering at 1 (matches keyboard layout)
set -g base-index 1
setw -g pane-base-index 1

## renumber windows when one is closed
set -g renumber-windows on

#""""""""""""""""""""""""""""""""""""""""""""""""
# Status bar - minimal, show tab numbers
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g status on
set -g status-style "bg=default,fg=white"
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "
set -g window-status-current-style "bg=white,fg=black"
set -g status-left ""
set -g status-right ""

## scroll history
set -g history-limit 30000

##  Window options
set -g monitor-activity off

## mouse support
set -g mouse on

## clipboard - use system clipboard for copy/paste
set -g set-clipboard on
set -g allow-passthrough on

## OSC 52 - the only clipboard path that survives ssh and a headless host, where
## copy() has no pbcopy/wl-copy/xclip to hand off to and can only write its file
## history. tmux emits it solely when the OUTER terminal's terminfo carries an
## `Ms` capability, which ncurses ships for xterm-256color / tmux-256color but
## not for screen-256color or an unknown $TERM - so force it on every terminal.
## Terminals that do not implement OSC 52 ignore the sequence.
set -ga terminal-overrides ",*:Ms=\\E]52;%p1%s;%p2%s\\007"

## `copy` is an interactive bash function, not a binary - tmux runs every
## copy-pipe/run target through `sh -c` with no profile, so it must go through
## the sy-tmux-copy shim (written by tmux.js) which sources the profile first.
## Absolute path, not a bare name: the tmux SERVER's PATH is inherited from
## whatever started it, which is not always a profile-loaded shell.
bind -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"

## prefix+y to capture entire visible pane to system clipboard.
## NO leading `capture-pane -p` here: `-p` writes the pane to the COMMAND's
## stdout, and a key binding's stdout is the attached client's terminal, which
## tmux refuses with "Can't write to client" (verified on tmux 3.6a). Inside
## `run-shell` the same command has a pipe for stdout, so it works there - and
## that is the only copy that was ever doing anything. run-shell inherits
## TMUX_PANE from the pane the key was pressed in, so the default target is
## already the right pane.
bind y run "tmux capture-pane -p | $HOME/.local/bin/sy-tmux-copy" \; display "Pane copied to clipboard"

## pane borders - active pane has bright border
set -g pane-border-style "fg=colour240"
set -g pane-active-border-style "fg=white,bold"
set -g pane-border-lines heavy

## Autorename sanely.
setw -g automatic-rename on

## new window in current path. prefix+n joins stock prefix+c as an alias - it
## overrides stock prefix+n (next-window), which now lives on prefix+. instead.
bind c new-window -c "#{pane_current_path}"
bind n new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Prefix chords (ctrl+b then key) - see docs/editor-keybindings.md
#   [ copy mode (vim scroll/search)   , / . prev / next window
#   w / Tab window switcher           x kill pane      c / n new window
#   r rename window
# Mostly tmux defaults; mode-keys is pinned so copy mode is vim, not emacs,
# , / . are rebound from rename-window / move-window to window navigation,
# n is rebound from next-window to new-window, and r from refresh-client to
# rename-window.
#""""""""""""""""""""""""""""""""""""""""""""""""
setw -g mode-keys vi

#""""""""""""""""""""""""""""""""""""""""""""""""
# Copy mode, vim-style. mode-keys vi alone does NOT give vim selection keys:
# stock tmux binds Space=begin-selection, Enter=copy, and v=rectangle-toggle,
# so `v` starts a block selection instead of a visual one and `y` does nothing.
# These bindings restore the vim mapping: v visual, C-v block, y yank.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi V send-keys -X select-line
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "$HOME/.local/bin/sy-tmux-copy"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Splitting (matches Windows Terminal: alt+d vertical, alt+' horizontal)
# prefix+' mirrors the stock prefix+" split, but inherits the current folder.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind v split-window -c "#{pane_current_path}" -h
bind s split-window -c "#{pane_current_path}" -v
bind d split-window -h
bind "'" split-window -c "#{pane_current_path}" -v
bind -n M-d split-window -c "#{pane_current_path}" -h
bind -n M-S-d split-window -c "#{pane_current_path}" -v
bind -n M-"'" split-window -c "#{pane_current_path}" -v

## alt+0 promotes the current split into a window of its own (stock prefix+!).
## alt+0 is free precisely because `base-index 1` means there is no window 0, so
## it sits at the end of the alt+1-9 window-index row without colliding.
## The inverse has no key - run `join-pane -s <window>` from the prefix prompt.
bind -n M-0 break-pane

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (matches Windows Terminal: alt+arrow)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Navigate panes (prefix + arrow) - restores tmux's stock select-pane.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind Left select-pane -L
bind Right select-pane -R
bind Up select-pane -U
bind Down select-pane -D

#""""""""""""""""""""""""""""""""""""""""""""""""
# Resize panes (prefix + alt-arrow and prefix + ctrl-arrow). tmux's stock steps
# are 5 cells (alt) and 1 cell (ctrl), which take too many repeats to cross a
# wide pane - both are overridden to the same step so either chord moves the
# border the same distance. Mouse border drag still works.
# -r keeps them repeatable: hold the prefix once, then tap arrows.
# The step is <<RESIZE_PANE_CELLS>>, substituted from TMUX_CONFIG in tmux.js.#""""""""""""""""""""""""""""""""""""""""""""""""
bind -r M-Left resize-pane -L <<RESIZE_PANE_CELLS>>
bind -r M-Right resize-pane -R <<RESIZE_PANE_CELLS>>
bind -r M-Up resize-pane -U <<RESIZE_PANE_CELLS>>
bind -r M-Down resize-pane -D <<RESIZE_PANE_CELLS>>
bind -r C-Left resize-pane -L <<RESIZE_PANE_CELLS>>
bind -r C-Right resize-pane -R <<RESIZE_PANE_CELLS>>
bind -r C-Up resize-pane -U <<RESIZE_PANE_CELLS>>
bind -r C-Down resize-pane -D <<RESIZE_PANE_CELLS>>

#""""""""""""""""""""""""""""""""""""""""""""""""
# Close pane / window (matches Windows Terminal: alt+w close pane, alt+q close window)
# alt+x is an alias for alt+w - same kill-pane, whichever finger gets there first.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-w kill-pane
bind -n M-x kill-pane
bind -n M-q confirm-before -p "kill window? (y/n)" kill-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# Tabs / windows (matches Windows Terminal: alt+t new tab, alt+shift+[/] prev/next)
# alt+tab / alt+shift+tab are the prev/next pair that actually fires on macOS+Ghostty.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-t new-window -c "#{pane_current_path}"
bind -n M-"}" next-window
bind -n M-"{" previous-window

## alt+tab / alt+shift+tab are the pair that actually fires on macOS+Ghostty. The
## M-{ / M-} bindings above are kept for other terminals but were verified NOT to
## match there: tmux forwards the raw ESC { / ESC } to the pane instead of
## consuming them, so the shifted-bracket chord is a no-op on this setup.
## Tab has no such problem - it collides with no escape-sequence introducer, unlike
## `[` (CSI) and `]` (OSC). BTab and S-Tab are both bound because tmux's key name
## for a back-tab depends on how the terminal reports it.
bind -n M-Tab next-window
bind -n M-BTab previous-window
bind -n M-S-Tab previous-window

#""""""""""""""""""""""""""""""""""""""""""""""""
# Prev / next window on prefix+, and prefix+. - the unshifted keys under < and >,
# so the direction matches the arrow printed on the keycap. -r makes them
# repeatable: hold the prefix once, then tap , or . to walk the window list.
# These override tmux's stock prefix+, (rename-window) and prefix+. (move-window)
# - rename moves to prefix+r (plus F2 / alt+F2), and move-window is reachable
# from the prefix+: prompt.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -r "," previous-window
bind -r "." next-window

## prefix+Tab opens the same window/session switcher as stock prefix+w
## (choose-tree -Zw: -Z zooms the chooser pane, -w starts it collapsed to
## windows). Tab is unbound in tmux's stock prefix table, so this is a pure
## addition - prefix+w keeps working. It mirrors the alt+Tab window-walk above,
## and pairs with the alt-tab muscle memory for "show me the windows".
bind Tab choose-tree -Zw

#""""""""""""""""""""""""""""""""""""""""""""""""
# New window (matches Terminator: alt+n)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-n new-window -c "#{pane_current_path}"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Find / search (matches Terminator/Windows Terminal: alt+f)
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-f copy-mode \; send-keys /

#""""""""""""""""""""""""""""""""""""""""""""""""
# Switch to window by index (matches Windows Terminal: alt+1-9)
# Targets are 1-based to match `base-index 1` above - alt+1 is window 1, not 0.
# NOT ctrl+1-9: a terminal encodes those as legacy control characters, not as a
# distinct chord - ctrl+1 arrives as a bare `1`, ctrl+2 as NUL, ctrl+3 as ESC,
# ctrl+4 as FS. tmux therefore has nothing to match, and binding them would also
# shadow ESC. Verified on Ghostty + macOS; `set -s extended-keys on` does not
# help, because the terminal never emits the CSI-u form in the first place.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

#""""""""""""""""""""""""""""""""""""""""""""""""
# Rename window (matches Terminator/Windows Terminal: f2)
# alt+F2 is the one that works under Ghostty, which binds bare F2 to its own
# prompt_tab_title (ghostty-keys.common.jsonc) and consumes it before tmux sees
# it. Plain F2 is kept for terminals that leave the key alone.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n F2 command-prompt -I "#W" "rename-window '%%'"
bind -n M-F2 command-prompt -I "#W" "rename-window '%%'"

## prefix+r renames too - the chord that survives a terminal or remote host
## swallowing alt and F-keys. This OVERRIDES stock prefix+r (refresh-client);
## a manual client redraw is rare and still reachable as `refresh-client` from
## the prefix+: prompt. Needed because prefix+, - tmux's own rename chord - is
## rebound to previous-window above.
bind r command-prompt -I "#W" "rename-window '%%'"

#""""""""""""""""""""""""""""""""""""""""""""""""
# Toggle fullscreen pane (matches Windows Terminal: alt+\ / f11)
# alt+z mirrors the stock prefix+z chord without needing the prefix. tmux zoom is
# a binary toggle - it has no zoom levels, so there is no separate in/out key.
#""""""""""""""""""""""""""""""""""""""""""""""""
bind -n M-\\ resize-pane -Z
bind -n F11 resize-pane -Z
bind -n M-z resize-pane -Z

#""""""""""""""""""""""""""""""""""""""""""""""""
# Plugins (managed by tpm - prefix+I to install)
#""""""""""""""""""""""""""""""""""""""""""""""""
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'

## tmux-resurrect: save/restore sessions across tmux server restarts
## prefix+Ctrl-s to save, prefix+Ctrl-r to restore
set -g @resurrect-capture-pane-contents 'on'

## initialize tpm (must be last line)
run -b '~/.tmux/plugins/tpm/tpm'
