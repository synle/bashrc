{
  // --- Session ---
  "session": { "trust_all_worktrees": true }, // Skip workspace trust prompts — trust all projects. Values: true, false

  // --- Editor Behavior ---
  "hard_tabs": false, // Use spaces instead of tabs for indentation. Values: true (tabs), false (spaces)
  "soft_wrap": "editor_width", // Wrap lines at preferred_line_length. Values: "none", "editor_width", "preferred_line_length"
  "auto_indent_on_paste": true, // Auto-indent pasted code to match surrounding context. Values: true, false
  "linked_edits": true, // Rename matching HTML/JSX tags when editing one. Values: true, false
  "multi_cursor_modifier": "cmd_or_ctrl", // Key for adding cursors via click. Values: "alt", "cmd_or_ctrl"
  "colorize_brackets": true, // Color-code matching bracket pairs. Values: true, false
  "show_whitespaces": "all", // Show whitespace characters as dots. Values: "all", "selection", "none", "boundary"
  "ensure_final_newline_on_save": true, // Always end files with a newline on save. Values: true, false
  "remove_trailing_whitespace_on_save": true, // Strip trailing whitespace on save. Values: true, false
  "format_on_save": "on", // Auto-format code on save. Values: "on", "off"
  "vim_mode": false, // Enable vim keybindings. Values: true, false
  "edit_predictions": { "disabled_globs": ["**/*"] }, // Fallback only — disables inline AI completions everywhere (Zed's analog of VS Code's editor.lightbulb.enabled=off and copilot disable), so a machine with no reachable Ollama never talks to Zed's cloud Zeta. zed.js REPLACES this whole key with an `{provider: "ollama", ...}` block when getAutocompleteProvider() finds a FIM-capable host. Renamed from `inline_completions` in Zed v0.169+. Values: array of glob patterns where completions are disabled
  "show_completions_on_input": true, // Auto-trigger completions on typing. Values: true, false

  // --- Search ---
  "search": { "include_ignored": false }, // Don't search gitignored files. Values: true, false

  // --- UI ---
  "cursor_blink": false, // Disable cursor blink animation. Values: true, false
  "minimap": { "show": "never" }, // Disable the code minimap sidebar. Values: true, false
  "scrollbar": { "show": "auto" }, // Scrollbar visibility. Values: "auto", "system", "always", "never"
  "gutter": {
    "line_numbers": true, // Show line numbers in the gutter. Values: true, false
    "folds": false, // Hide fold/collapse icons in the gutter. Values: true, false
  },
  "indent_guides": { "enabled": false }, // Hide vertical indent guide lines. Values: true, false
  "toolbar": {
    "breadcrumbs": false, // Hide breadcrumb navigation at top of editor. Values: true, false
    "quick_actions": false, // Hide quick action buttons in the toolbar. Values: true, false
  },
  "tabs": {
    "close_position": "right", // Position of the tab close button. Values: "left", "right"
    "git_status": false, // Hide git status indicators on tabs. Values: true, false
  },
  "max_tabs": 10, // Cap concurrent tabs per pane — mirrors VS Code's workbench.editor.limit.value=10. Values: integer
  "restore_on_startup": "none", // Don't restore the previous session — mirrors VS Code's files.hotExit=off. Values: "last_workspace", "last_session", "none"

  // --- Dock positions (override Zed defaults: project_panel="right", agent="left") ---
  // Match VS Code / Sublime convention: file tree on the LEFT, agent/AI on the RIGHT.
  "project_panel": { "dock": "left" }, // File tree dock side. Values: "left", "right"
  "outline_panel": { "dock": "left" }, // Symbol outline dock side — pair with the file tree. Values: "left", "right"
  "agent": {
    "dock": "right", // Agent / AI panel dock side. Values: "left", "right", "bottom"
    "tool_permissions": { "default": "allow" }, // Auto-approve agent tool actions without prompting (Zed v0.224.0+ analog of VS Code's claudeCode.allowDangerouslySkipPermissions). Values: "confirm", "allow", "deny"
  },

  // --- Terminal ---
  "terminal": {
    "max_scroll_history_lines": 200000, // EDITOR_CONFIGS.terminalScrollback
    "shell": { "program": "bash" }, // Default to bash — mirrors VS Code's terminal.integrated.defaultProfile.{linux,osx}=bash. Values: { program } or { with_arguments } or "system"
    "option_as_meta": false, // Send alt-key chords to Zed's keymap instead of the shell as Meta — pairs with the OS_KEY+X auto-mirror in zed.js so chords like alt+\ fire from terminal focus. Values: true, false
  },

  // --- AI ---
  // Agent panel ON: zed.js auto-registers `language_models.ollama` (local 127.0.0.1
  // with auto_discover) and `language_models.openai_compatible["Ollama (sy-omen45l)"]`
  // (remote, models enumerated from /api/tags) when those hosts are reachable, then
  // pins `agent.default_model` to the best provider. Inline edit predictions are wired
  // to Ollama too — zed.js overwrites the `edit_predictions` key near the top of this
  // file with an Ollama FIM provider when one is reachable, and leaves the
  // `disabled_globs: ["**/*"]` fallback in place (inline AI fully off, never Zeta) when
  // none is.
  //
  // External agents: zed.js also injects `agent_servers` from whichever ACP-capable LLM
  // CLIs are installed, so the agent panel's `+` menu lists our own configured installs
  // rather than copies Zed downloads for itself. `opencode acp` and `copilot --acp` speak
  // ACP natively and become `"type": "custom"` entries pointing at absolute binary paths;
  // Claude Code has no ACP mode, so it becomes a `"type": "registry"` entry on Zed's
  // built-in `claude-acp` id carrying `CLAUDE_CODE_EXECUTABLE`. That key is deliberately
  // absent here — the paths are machine-specific, so it is written on local deploys only
  // and never baked into the prebuilt artifacts.
  "disable_ai": false, // Enable Zed agent / AI features so Ollama providers populate the agent panel. Values: true, false

  // --- Performance & Telemetry ---
  "telemetry": {
    "diagnostics": false, // Disable sending crash reports. Values: true, false
    "metrics": false, // Disable sending usage metrics. Values: true, false
  },
  "auto_update": false, // Disable automatic updates. Values: true, false

  // --- Git ---
  // Only `git_gutter` is a valid key under Zed's `git` block. `enabled` and `autoFetch`
  // were never supported (linter rejects them) — git integration is always on; remotes
  // are managed by the user.
  "git": {
    "git_gutter": "hide", // Hide git diff indicators in the gutter. Values: "tracked_files", "hide"
  },

  // --- Extensions ---
  // NOTE: THIS IS THE ONE PLACE ZED EXTENSIONS GET REGISTERED AND AUTO-INSTALLED.
  // Add an extension id below and Zed downloads + enables it on next launch — no manual
  // trip through the extension browser, and every machine this repo provisions ends up
  // with the same set. Find ids at https://zed.dev/extensions (the id is the url slug,
  // not the display name). Removing a line here does NOT uninstall an already-installed
  // extension; do that from Zed's extension panel.
  //
  // Zed bundles only: bash, c, cpp, css, diff, go, gomod, gowork, json, jsonc, markdown,
  // python, rust, tsx, typescript, javascript, jsdoc, regex, yaml, gitcommit
  // (crates/languages/src/lib.rs `built_in_languages`). Everything below is a real gap for
  // this repo's file mix — each entry maps to files actually tracked here. Note `css` is
  // bundled but `scss` is NOT, and `html` is an extension despite shipping in the Zed repo.
  // Any language added here MUST also get a `languages` formatter pin below, otherwise
  // `format_on_save` routes it to prettier and fails with UndefinedParserError.
  "auto_install_extensions": {
    "material-icon-theme": true, // Auto-install Material Icon Theme extension. Values: true, false
    "html": true, // webapp/ + *.html — grammar plus vscode-html-language-server
    "git-firefly": true, // git.gitconfig, .gitignore, .gitattributes, rebase todo (grammar only)
    "make": true, // Makefile — every dev verb lives there (grammar only)
    "toml": true, // advanced/starship-config.toml (grammar only)
    "dockerfile": true, // .devcontainer/Dockerfile — grammar plus dockerfile-language-server
    "scss": true, // webapp *.scss — grammar plus vscode-css-language-server
    "xml": true, // windows/classic_start.config.xml (grammar only)
    "ini": true, // metadata *.config files read as ini/conf (grammar only)
    "log": true, // $BASHRC_TEMP_DIR run.log / fullsetup.log debugging (grammar only)
  },
  "icon_theme": "Material Icon Theme", // File icon theme for sidebar. Values: any installed icon theme name

  // --- Formatters (per-language) ---
  // Prettier handles JS/TS/JSON/CSS/HTML/MD/YAML — same set as VS Code's vs-code-config.jsonc.
  // Every non-Prettier language MUST be pinned to `language_server` explicitly. Otherwise
  // Zed's default `formatter: "auto"` + global `prettier.allowed: true` routes the file
  // to prettier, which fails with UndefinedParserError on Rust/Python/Go (prettier doesn't
  // support them). Symmetric: every Prettier-supported language gets `formatter: "prettier"`;
  // every native-LSP language gets `formatter: "language_server"`.
  //
  // Only languages that ship with Zed, or that `auto_install_extensions` above guarantees,
  // are listed. An entry for a language with no installed grammar makes Zed emit
  // `No language with this name is installed.`, so the two blocks move together: adding a
  // language here requires its extension above, and vice versa. Extension-only languages
  // with no formatter (TOML, XML, Make, ini, LOG, the Git Config family) are pinned to
  // `language_server` — none ship one, and the pin degrades to a no-op instead of handing
  // the file to prettier. Same trick already used for Shell Script.
  "prettier": { "allowed": true }, // Permit Zed to run the prettier CLI on PATH. Values: { allowed: true|false, command?: string }
  "languages": {
    // Prettier-handled
    "JavaScript": { "formatter": "prettier" },
    "TypeScript": { "formatter": "prettier" },
    "TSX": { "formatter": "prettier" },
    // No "JSX" entry: Zed has no such language. `.jsx` is claimed by the JavaScript
    // grammar itself (crates/grammars/src/javascript/config.toml declares
    // `path_suffixes = ["js", "jsx", "mjs", "cjs"]`), so the JavaScript pin above already
    // covers it and a "JSX" key only earns `No language with this name is installed.`
    "JSON": { "formatter": "prettier" },
    "JSONC": { "formatter": "prettier" },
    "HTML": { "formatter": "prettier" },
    "CSS": { "formatter": "prettier" },
    "SCSS": { "formatter": "prettier" }, // via the scss extension — prettier parses scss natively
    "Markdown": { "formatter": "prettier" },
    "YAML": { "formatter": "prettier" },
    // Native LSP-handled — explicit pin prevents prettier fallback (UndefinedParserError)
    "Rust": { "formatter": "language_server" }, // rust-analyzer → rustfmt
    "Python": { "formatter": "language_server", "language_servers": ["pyright", "!basedpyright", "!pylsp"] }, // pyright (no format) or ruff if attached — explicit opt-in silences Zed's "Basedpyright is now the only default language server for Python" notice; matches the binary installed by lsp/install.sh
    "Go": { "formatter": "language_server" }, // gopls → gofmt + goimports
    "Shell Script": { "formatter": "language_server" }, // bash-language-server (no format) — falls back gracefully
    "C": { "formatter": "language_server" },
    "C++": { "formatter": "language_server" },
    "Dockerfile": { "formatter": "language_server" }, // dockerfile-language-server (no format) — pin keeps prettier away
    // Grammar-only extensions — no language server exists, pin is a deliberate no-op
    "TOML": { "formatter": "language_server" },
    "XML": { "formatter": "language_server" },
    "Make": { "formatter": "language_server" },
    "ini": { "formatter": "language_server" }, // lowercase — matches the ini extension's declared name
    "LOG": { "formatter": "language_server" },
    "Git Config": { "formatter": "language_server" },
    "Git Ignore": { "formatter": "language_server" },
    "Git Attributes": { "formatter": "language_server" },
    "Git Rebase": { "formatter": "language_server" },
  },
}
