// OpenCode TUI keybinding overrides — applied on top of opencode's defaults
// (https://opencode.ai/docs/keybinds/). Only the chords listed here are
// touched; every other default is left intact via the deploy-time merge in
// software/scripts/advanced/llm/opencode/setup.js.
//
// EXPLICIT-MATCH POLICY
// ---------------------
// Every chord we want from Claude's convention is listed here EXPLICITLY,
// even if opencode's upstream default already happens to bind it. Rationale:
//   (a) An upstream default flip silently breaks our parity. Owning the
//       binding here means a re-run of opencode/setup.js always converges
//       to the Claude-aligned chord even if opencode changes defaults.
//   (b) The file is auditable in isolation — no need to consult opencode's
//       schema docs to know which chords we "have".
//   (c) The cross-tool comparison table in docs/editor-keybindings.md only
//       credits chords that are explicitly listed in our key files; no
//       "happens to align with upstream default" entries.
//
// Opencode uses "super" as its cross-platform term for the primary OS
// modifier (Cmd on macOS, Super/Windows key on Linux). All chords use
// "super" directly — no OS-specific substitution needed.
//
// Direct mirror of software/scripts/advanced/llm/claude/claude-keys.common.jsonc:
//
//   Claude action               OpenCode command            Claude chord(s)
//   ───────────────────────────  ──────────────────────────  ────────────────────────
//   chat:newline                input_newline               shift+enter, ctrl+enter
//   chat:undo                   input_undo                  OS_KEY+z
//   chat:clearInput             input_clear                 escape*
//   (*escape = single press; opencode has no double-tap, see input_clear note)
//   chat:clearScreen†           session_compact             ctrl+l, OS_KEY+l
//   (†Claude/Copilot l-chords clear the chat transcript; opencode has no
//    clear-transcript command, so ctrl+l / super+l route to session_compact —
//    the closest "reset the chat so far" that keeps continuity.)
//   chat:externalEditor         editor_open                 ctrl+g, ctrl+x
//   chat:imagePaste             input_paste                 ctrl+v
//   (readline HOME, ctrl+a null) input_line_home            ctrl+a, home
//   (readline END, ctrl+e null)  input_line_end             ctrl+e, end
//
// Claude chords with NO opencode equivalent (gaps documented in
// docs/editor-keybindings.md):
//   app:toggleTodos (ctrl+t) — opencode has no todos panel; default ctrl+t
//                              = variant_cycle, kept intact (NOT overridden
//                              below).
//
// Opencode-specific additions (no Claude equivalent — kept for cross-app
// muscle memory):
//   sidebar_toggle    ctrl+\,super+\       — matches Sublime/VS Code/Zed
//                                            sidebar toggle convention.
//   input_buffer_home ctrl+home,super+home — start of multi-line buffer.
//   input_buffer_end  ctrl+end,super+end   — end of multi-line buffer.
//   messages_copy     ctrl+y               — copy last assistant message
//                                            (bash-readline yank chord).
//   command_list      ctrl+p,super+p       — command palette (super+p matches
//                                            Sublime / VS Code / Zed).
//   session_rename    f6                   — moved off f2 so f2 is free for
//                                            future bindings.
//   history_previous  up,ctrl+r            — recall previous prompt. Upstream
//                                            default is "up"; we layer ctrl+r
//                                            (bash reverse-i-search muscle
//                                            memory). opencode has no
//                                            incremental reverse-search command;
//                                            history_previous is the nearest
//                                            analog. ctrl+r is free because
//                                            session_rename moved to f6.
//   messages_first    ctrl+alt+shift+g,home
//                                          — moved off the upstream default
//                                            "ctrl+g,home" so ctrl+g is free
//                                            for editor_open (the chord that
//                                            Claude, Copilot CLI, and Gemini
//                                            CLI all ship as their
//                                            external-editor default). Chord
//                                            shape mirrors the upstream
//                                            messages_last ("ctrl+alt+g,end").
//
// Leader move:
//   The default leader is ctrl+x — which collides with the bash-readline
//   editor-open chord we keep as editor_open's secondary alias. We move the
//   leader to ctrl+o (free in both opencode and bash readline; no tmux /
//   XON-XOFF / terminal-level conflict) so ctrl+x stays available for
//   editor_open alongside the primary ctrl+g.
//   All ~30 <leader>X chords keep working — they're just typed as
//   ctrl+o <key> now instead of ctrl+x <key>.
//
// Sidebar-hidden-by-default is NOT supported by opencode v1.14.33:
//   - The TUI schema (https://opencode.ai/tui.json) has no field for it.
//   - The opencode SQLite db has no settings table for view state.
//   - The command-palette "Hide sidebar" command (ctrl+p) is a runtime
//     toggle only, not persisted between launches.
//   - The only knob is the toggle keybind (now ctrl+\ or super+\).
//   Documented as a permanent gap in docs/editor-keybindings.md.
{
  "keybinds": {
    // Move leader off ctrl+x so we can bind ctrl+x directly to editor_open.
    // See header comment for rationale. Every <leader>X chord (~30 of them:
    // <leader>e editor, <leader>n new session, <leader>t themes, <leader>m
    // models, etc.) continues to work, just with ctrl+o as the prefix.
    // session_rename: moved off f2 (opencode default) onto f6 so f2 stays
    // free for terminal/system-level bindings.
    "session_rename": "f6",
    "leader": "ctrl+o",
    // Open $EDITOR (typically vim) to compose input. ctrl+g is the canonical
    // cross-CLI chord (Claude / Copilot / Gemini all default to it); ctrl+x is
    // the secondary alias for bash-readline muscle memory and is why the
    // leader stays moved to ctrl+o (see header). opencode's own default for
    // editor_open is <leader>e, which keeps working as ctrl+o e.
    "editor_open": "ctrl+g,ctrl+x",
    // Free ctrl+g for editor_open: opencode's upstream default binds
    // messages_first to "ctrl+g,home". We keep the physical HOME chord and
    // move the ctrl chord to ctrl+alt+shift+g, mirroring the shape of the
    // upstream messages_last chord ("ctrl+alt+g,end").
    "messages_first": "ctrl+alt+shift+g,home",
    // Newline in input. Claude binds shift+enter / ctrl+enter. We list
    // every chord explicitly (no reliance on opencode default) plus
    // alt+return / ctrl+j which opencode upstream historically shipped.
    "input_newline": "shift+return,ctrl+return,alt+return,ctrl+j",
    // Beginning of current input line. We bind both ctrl+a and the physical
    // HOME key to input_line_home so the user-visible behavior matches across
    // Sublime, VS Code, Zed, and bash readline. For multi-line input, this
    // jumps to the start of the current line; ctrl+home/super+home jump to
    // the start of the whole buffer (see input_buffer_home below).
    "input_line_home": "ctrl+a,home",
    // End of current input line. Mirror of input_line_home — binds ctrl+e
    // and the physical END key.
    "input_line_end": "ctrl+e,end",
    // Beginning of the entire input buffer (only different from
    // input_line_home for multi-line input). Bound to ctrl+home and super+home
    // since bare HOME now belongs to input_line_home above.
    "input_buffer_home": "ctrl+home,super+home",
    // End of the entire input buffer. Bound to ctrl+end and super+end since
    // bare END now belongs to input_line_end above.
    "input_buffer_end": "ctrl+end,super+end",
    // Clear current input — escape ONLY.
    //
    // Neither ctrl+l nor super+l is here — both go to session_compact below.
    // Rationale: on Claude/Copilot the l-chords (ctrl+l / cmd+l) visually clear
    // the chat transcript. opencode has NO clear-transcript command (only
    // "Clear input field" and "Clear editor context"), so the nearest "reset
    // the chat so far" that keeps continuity is session_compact — it summarizes
    // + compacts the conversation, freeing the window while preserving condensed
    // context. Both l-chords route there; input_clear keeps only escape.
    //
    // escape mirrors Claude/Copilot muscle memory: in those CLIs a double-tap of
    // escape wipes the input field. opencode has NO double-tap / key-sequence
    // mechanism (the only sequence is the leader key), so exact double-escape
    // parity is impossible — escape is bound as a SINGLE press instead. opencode
    // context-scopes chords, so this coexists with the upstream default
    // session_interrupt="escape" (kept intact, not overridden here): escape
    // clears the input when idle, and still interrupts a streaming response —
    // exactly how opencode already ships two commands on escape
    // (session_interrupt + prompt.autocomplete.hide). TRADEOFF: a single escape
    // is more aggressive than Claude's double-tap, so an accidental escape
    // clears the field; input_undo (super+z / ctrl+-) recovers it.
    "input_clear": "escape",
    // Compact the session — summarize + condense the conversation so far,
    // freeing the context window without dropping continuity. Both ctrl+l and
    // super+l are layered on for Claude/Copilot muscle memory (where the l-chords
    // clear the chat transcript); opencode has no clear-transcript command, so
    // compaction is the closest "reset the chat so far" analog. <leader>c
    // (opencode's upstream default, typed ctrl+o c after our leader move) is kept
    // explicitly so the binding this file writes doesn't drop it.
    "session_compact": "ctrl+l,super+l,<leader>c",
    // Undo last typed input. Claude binds super+z (cmd+z mac, super+z linux);
    // ctrl+- is opencode's legacy chord retained for muscle memory.
    "input_undo": "super+z,ctrl+-",
    // Paste into the input field. Claude binds ctrl+v → chat:imagePaste;
    // opencode's input_paste is text-paste (no image pipeline today).
    // Listed explicitly so a future upstream default flip can't drop it.
    "input_paste": "ctrl+v",
    // Copy messages from the assistant's response. ctrl+y matches the
    // bash-readline yank convention for muscle-memory carryover.
    "messages_copy": "ctrl+y",
    // Command list / palette. ctrl+p is the opencode upstream default
    // (file-finder); super+p is the cross-app convention matching
    // Sublime / VS Code / Zed command palette.
    "command_list": "ctrl+p,super+p",
    // Toggle sidebar (sessions / files / MCP pane). Default is "<leader>b";
    // we add ctrl+\ as the primary chord (matches cross-app sidebar-toggle
    // convention used by Sublime / VS Code / Zed) and super+\ as the
    // OS-modifier alternate. The "\\" in the JSON source represents a literal
    // backslash; after JSON parse the chords are "ctrl+\" and "super+\".
    "sidebar_toggle": "ctrl+\\,super+\\",
    // Recall previous prompt from input history. opencode's upstream default is
    // "up"; we keep up-arrow AND layer ctrl+r (bash reverse-i-search muscle
    // memory). opencode has no incremental reverse-search command — this is the
    // nearest analog (cycle back through prior prompts). ctrl+r is free because
    // session_rename (opencode's default ctrl+r) is reassigned to f6 above.
    "history_previous": "up,ctrl+r",
  },
}
