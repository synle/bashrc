{
  // Source-of-truth MCP server registry for all four LLM CLIs (Claude Code,
  // GitHub Copilot CLI, Google Gemini CLI, OpenCode). Each named entry below
  // is deployed to every CLI's native MCP config location on the next setup
  // run via `bash run.sh --preset=llm` (or any per-CLI `<cli>/setup.js`).
  //
  // Format: the standard `mcpServers` shape that Claude / Copilot / Gemini
  // already consume verbatim. Each entry uses ONE of:
  //
  //   Local stdio server:
  //     "<name>": { "command": "...", "args": ["..."], "env": { "K": "V" } }
  //
  //   Remote SSE / streamable-HTTP server:
  //     "<name>": { "url": "https://...", "headers": { "Authorization": "..." } }
  //
  // OpenCode's native shape (`mcp` key, `type: "local" | "remote"`,
  // `command` as a single array, `environment` instead of `env`) is auto-
  // translated by `opencode/setup.js` from the standard shape above — keep
  // entries authored in the standard shape and let the deploy do the rest.
  //
  // Deploy targets (additive merge — user entries with names NOT listed here
  // are preserved untouched; entries WITH a matching name get our value):
  //   Claude   → ~/.claude/settings.json   → mcpServers
  //   Copilot  → ~/.copilot/mcp-config.json → mcpServers
  //   Gemini   → ~/.gemini/settings.json   → mcpServers
  //   OpenCode → ~/.config/opencode/opencode.json → mcp (translated shape)
  //
  // Removal: dropping a name from this file does NOT auto-remove it from
  // the deployed configs (additive overlay only). Delete by hand if needed.
  //
  // Cross-cutting concerns to keep in mind when adding a server:
  //   - Secrets in `env` / `headers` leak to all four config files on disk.
  //     For anything sensitive, prefer `${VAR_NAME}` env var references that
  //     the CLI expands at launch rather than literal values here.
  //   - Local stdio servers must be installed everywhere setup.js runs
  //     (mac, linux, wsl). Verify the `command` resolves on every target OS
  //     before adding.
  //   - Remote servers must be reachable from every machine that runs setup —
  //     a corp-VPN-only endpoint will break setup on a laptop without VPN.
  "mcpServers": {
    // Microsoft MarkItDown — converts PDF / DOCX / XLSX / PPTX / images /
    // audio / html into Markdown for the agent. Exposes one tool,
    // `convert_to_markdown(uri)`, taking a file:, http:, https:, or data: URI.
    // Ships as `markitdown-mcp` on PyPI; `uvx` (installed by
    // software/scripts/advanced/uv.sh) fetches + runs it on demand, so no
    // separate persistent install is needed. Runs 100% locally over STDIO;
    // image OCR/description stays metadata-only unless an LLM client is wired
    // in, so nothing leaves the machine by default.
    //
    // `--with "mcp>=1.19,<2"` is a REQUIRED workaround, not a nicety: the
    // latest published markitdown-mcp (0.0.1a4) pins `mcp~=1.8.0`, and that old
    // MCP SDK CRASHES the whole server (exit 1) the moment a client sends the
    // non-standard `server/discover` capability probe that GitHub Copilot CLI
    // (and OpenCode) fire right after `initialize` — a pydantic ValidationError
    // escapes the stdio read loop and the process dies mid-handshake, so the
    // CLI reports "MCP server process exited before completing the MCP
    // initialize handshake". mcp >= 1.19 answers the unknown request with a
    // graceful JSON-RPC -32602 and keeps serving. The floor forces uv to pick a
    // markitdown-mcp build whose pin allows a resilient SDK (currently 0.0.1a3
    // + mcp 1.29); conversion quality is identical since both wrap the same
    // `markitdown[all]` (<0.2.0) parsers. Drop the `--with` once markitdown-mcp
    // ships a release that no longer pins `mcp~=1.8.0`.
    "markitdown": {
      "command": "uvx",
      "args": ["--with", "mcp>=1.19,<2", "markitdown-mcp"]
    },
    // Microsoft Playwright — browser automation over STDIO: navigate, click,
    // fill forms, screenshot, and capture accessibility snapshots. Useful for
    // debugging the repo's own webapp/ and any web work. `npx` (Node installed
    // cross-OS by this repo) fetches the package on first run. `--headless`
    // keeps it working on WSL/Linux/servers with no display; `--isolated` uses
    // an in-memory profile so it never touches personal browser sessions. The
    // first browser launch downloads Chromium into ms-playwright's cache; if a
    // run reports a missing browser, run `npx playwright install chromium`.
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"]
    }
    // Example (commented; uncomment + edit to enable everywhere):
    // "context7": {
    //   "command": "npx",
    //   "args": ["-y", "@upstash/context7-mcp"]
    // }
  },
}
