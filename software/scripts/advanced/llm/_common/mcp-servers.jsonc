{
  // Source-of-truth MCP server registry for all five LLM CLIs (Claude Code,
  // GitHub Copilot CLI, Google Gemini CLI, OpenCode, Pi). Each named entry below
  // is deployed to each eligible CLI's native MCP config location on the next setup
  // run via `./run --preset=llm` (or any per-CLI `<cli>/setup.js`).
  //
  // Format: the standard `mcpServers` shape that Claude / Copilot / Gemini / Pi
  // already consume verbatim. Each entry uses ONE of:
  //
  //   Local stdio server:
  //     "<name>": { "command": "...", "args": ["..."], "env": { "K": "V" } }
  //
  //   Remote streamable-HTTP server (Pi does not support legacy SSE):
  //     "<name>": { "type": "http", "url": "https://...", "headers": { "Authorization": "..." } }
  //
  // OpenCode's native shape (`mcp` key, `type: "local" | "remote"`,
  // `command` as a single array, `environment` instead of `env`) is auto-
  // translated by `deploySharedMcpServers` in llm-common.js — keep
  // entries authored in the standard shape and let the deploy do the rest.
  //
  // Deploy targets (additive merge — user entries with names NOT listed here
  // are preserved untouched; entries WITH a matching name get our value):
  //   Claude   → ~/.claude.json            → mcpServers
  //   Copilot  → ~/.copilot/mcp-config.json → mcpServers
  //   Gemini   → ~/.gemini/settings.json   → mcpServers
  //   OpenCode → ~/.config/opencode/opencode.json → mcp (translated shape)
  //   Pi       → ~/.pi/agent/mcp.json        → mcpServers
  // Malformed existing MCP config aborts deployment rather than discarding it.
  // Legacy Claude settings.json entries are left untouched; user-scoped MCP
  // belongs in ~/.claude.json.
  //
  // Registry-only excludeClients omits named clients and is stripped before deploy.
  // Exclusions preserve already-existing user entries; they do not delete them.
  // Removal: dropping a name from this file does NOT auto-remove it from
  // the deployed configs (additive overlay only). Delete by hand if needed.
  //
  // Cross-cutting concerns to keep in mind when adding a server:
  //   - Secrets in `env` / `headers` leak to all five config files on disk.
  //     For anything sensitive, prefer `${VAR_NAME}` env var references that
  //     the CLI expands at launch rather than literal values here.
  //   - Local stdio servers must be installed everywhere setup.js runs
  //     (mac, linux, wsl). Verify the `command` resolves on every target OS
  //     before adding.
  //   - Remote servers must be reachable from every machine that runs setup —
  //     a corp-VPN-only endpoint will break setup on a laptop without VPN.
  "mcpServers": {
    // TODO: EXPERIMENTAL pi-lens MCP — verify every client launches in its active
    // workspace and reports incomplete/cold diagnostics honestly before adding hooks.
    // Installed by pi-lens.sh; Pi keeps its native extension without duplicate tools.
    "pi-lens": {
      "command": "pi-lens-mcp",
      "args": [],
      "excludeClients": ["pi"],
    },
    // CodeGraph — pinned executable provisioned by codegraph.sh. Resolve the
    // active client worktree, never a fixed checkout; each owns .codegraph/.
    // Keep the shared daemon enabled for concurrent clients on the same tree.
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": { "CODEGRAPH_TELEMETRY": "0" },
    },
    // Microsoft Playwright — browser automation over STDIO: navigate, click,
    // fill forms, screenshot, and capture accessibility snapshots. Useful for
    // debugging the repo's own webapp/ and any web work. `npx` (Node installed
    // cross-OS by this repo) fetches the package on first run. `--headless`
    // keeps it working on WSL/Linux/servers with no display; `--isolated` uses
    // an in-memory profile so it never touches personal browser sessions. The
    // first browser launch downloads Chromium into ms-playwright's cache; if a
    // run reports a missing browser, run `npx playwright install chromium`.
    // `argsOnMac` (registry-only, resolved by loadSharedMcpServers) replaces
    // `args` on macOS: headed so the user can approve Okta / Touch ID SSO in
    // the window, and a persistent Playwright-owned profile (not the personal
    // browser) so that SSO login survives across sessions.
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"],
      "argsOnMac": ["-y", "@playwright/mcp@latest"],
    },
    // Context7 — current library documentation via a local stdio launcher.
    // Queries go to Context7's hosted API; do not send private source or data.
    // Keyless use has lower limits; an optional CONTEXT7_API_KEY is inherited
    // from the environment, never committed here. Disable optional telemetry
    // and npm lifecycle scripts without disabling documentation requests.
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": { "npm_config_ignore_scripts": "true", "OTEL_SDK_DISABLED": "true" },
    },
    // AnyDoc — community MCP wrapper around @firecrawl/anydoc for local
    // PDF/Office-to-Markdown conversion; no parser API key or cloud upload.
    // Converted text still enters model context. No OCR; mixed PDFs can omit
    // scanned pages. output_path writes/overwrites files: preserve originals.
    // Node >=20; published native builds cover macOS x64/arm64, Linux/WSL
    // x64/arm64 (glibc/musl), and Windows x64, not Windows ARM64 or Termux.
    // npm lifecycle scripts stay disabled; native bindings ship prebuilt.
    "anydoc": {
      "command": "npx",
      "args": ["-y", "mcp-server-anydoc@latest"],
      "env": { "npm_config_ignore_scripts": "true" },
    },
  },
}
