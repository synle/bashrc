{
  // Sy palette bound to COLOR_MAP, matching Sublime. Refresh with make format_build_include.
  "name": "Sy Dark", // {{dark.themeName}}
  "foreground": "#e8e8e8", // {{dark.foreground}}
  "muted": "#8f8f8f", // {{dark.textDisabled}}
  "border": "#6e6e6e", // {{dark.brightGray}}
  "accent": "#5ca0d7", // {{dark.blue}}
  "shimmer": "#4fc1ff", // {{dark.brightBlue}}
  "info": "#5ca0d7", // {{dark.blue}}
  "success": "#76a762", // {{dark.green}}
  "error": "#f67070", // {{dark.red}}
  "warning": "#dcdcaa", // {{dark.yellow}}
  "background": "#0a0a0a", // {{dark.background}}
  "surface": "#161616", // {{dark.surface}}
  "hover": "#2b2b2b", // {{dark.gray}}
  "selection": "#1b3c5e", // {{dark.selection}}
}
