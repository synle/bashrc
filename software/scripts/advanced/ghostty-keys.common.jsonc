// Ghostty keybindings shared across macOS and Linux.
// OS_KEY = `cmd` on macOS, `alt` on Linux. Substituted at build time by ghostty.js
// via formatEditorKeybindings(). Each entry maps to a single Ghostty
// `keybind = <trigger>=<action>` config line.
//
// Convention: see docs/editor-keybindings.md → "Terminal Emulators".
[
  // ---- Tabs ----
  { "key": "OS_KEY+t", "action": "new_tab" },
  { "key": "OS_KEY+1", "action": "goto_tab:1" },
  { "key": "OS_KEY+2", "action": "goto_tab:2" },
  { "key": "OS_KEY+3", "action": "goto_tab:3" },
  { "key": "OS_KEY+4", "action": "goto_tab:4" },
  { "key": "OS_KEY+5", "action": "goto_tab:5" },
  { "key": "OS_KEY+6", "action": "goto_tab:6" },
  { "key": "OS_KEY+7", "action": "goto_tab:7" },
  { "key": "OS_KEY+8", "action": "goto_tab:8" },
  { "key": "OS_KEY+9", "action": "goto_tab:9" },
  { "key": "OS_KEY+shift+]", "action": "next_tab" },
  { "key": "OS_KEY+shift+[", "action": "previous_tab" },
  { "key": "OS_KEY+w", "action": "close_surface" },
  // F2 prompts for a new title for the current tab (matches the common
  // editor/terminal convention where F2 = rename).
  { "key": "f2", "action": "prompt_tab_title" },

  // ---- Window ----
  { "key": "OS_KEY+n", "action": "new_window" },
  { "key": "OS_KEY+q", "action": "quit" },

  // ---- Splits ----
  { "key": "OS_KEY+d", "action": "new_split:right" },
  { "key": "OS_KEY+shift+d", "action": "new_split:down" },
  { "key": "OS_KEY+'", "action": "new_split:down" },
  { "key": "OS_KEY+up", "action": "goto_split:up" },
  { "key": "OS_KEY+down", "action": "goto_split:down" },
  { "key": "OS_KEY+left", "action": "goto_split:left" },
  { "key": "OS_KEY+right", "action": "goto_split:right" },
  { "key": "OS_KEY+shift+up", "action": "resize_split:up,10" },
  { "key": "OS_KEY+shift+down", "action": "resize_split:down,10" },
  { "key": "OS_KEY+shift+left", "action": "resize_split:left,10" },
  { "key": "OS_KEY+shift+right", "action": "resize_split:right,10" },
  { "key": "OS_KEY+shift+\\", "action": "toggle_split_zoom" },

  // ---- Scrollback / prompts ----
  // Jump the viewport to the previous/next shell prompt — the terminal equivalent
  // of "scroll back to where that build started". Needs shell integration (enabled
  // in ghostty.js) to know where prompts are.
  //
  // Ghostty's own defaults put jump_to_prompt on OS_KEY+up/down, but we relocated
  // split navigation onto those, so it is re-homed here. OS_KEY+ctrl+arrow is free:
  // Ghostty's default resize_split lived there, and we moved resize to
  // OS_KEY+shift+arrow above. Verified unbound via `ghostty +show-config --default`.
  { "key": "OS_KEY+ctrl+up", "action": "jump_to_prompt:-1" },
  { "key": "OS_KEY+ctrl+down", "action": "jump_to_prompt:1" },

  // ---- Font Zoom ----
  { "key": "OS_KEY+equal", "action": "increase_font_size:1" },
  { "key": "OS_KEY+minus", "action": "decrease_font_size:1" },
  { "key": "OS_KEY+0", "action": "reset_font_size" },

  // ---- Edit ----
  // `:mixed` (Ghostty's own default for this chord) puts BOTH plain text and a
  // styled/HTML flavor on the clipboard, so pasting into a rich-text target keeps
  // colors while pasting into a plain one is unchanged. Binding the bare
  // `copy_to_clipboard` here would silently downgrade to plain-text-only.
  { "key": "OS_KEY+c", "action": "copy_to_clipboard:mixed" },
  { "key": "OS_KEY+v", "action": "paste_from_clipboard" },
  { "key": "OS_KEY+a", "action": "select_all" },
  // Escape hatch: OS_KEY+shift+<key> does the same thing, for when the plain
  // chord is taken by an app inside the terminal (on Linux OS_KEY is alt, which
  // tmux / vim / readline may want). Overrides two Ghostty defaults:
  // OS_KEY+shift+f (end_search - escape still ends search) and OS_KEY+shift+v
  // (paste_from_selection). Verified via `ghostty +show-config --default`.
  { "key": "OS_KEY+shift+c", "action": "copy_to_clipboard:mixed" },
  { "key": "OS_KEY+shift+v", "action": "paste_from_clipboard" },
  { "key": "OS_KEY+shift+a", "action": "select_all" },
  { "key": "OS_KEY+shift+f", "action": "start_search" },
  // OS_KEY+y sends ESC y (= alt+y), which tmux binds to "copy the whole
  // scrollback". Needed on macOS where cmd never reaches tmux; on Linux
  // OS_KEY is alt, so this just re-sends the same chord. Outside tmux bash
  // reads it as yank-pop.
  { "key": "OS_KEY+y", "action": "text:\\x1by" },

  // ---- tmux ctrl twins ----
  // ctrl+<key> re-sent as alt+<key> (ESC <key>), so tmux's alt chords also answer
  // to ctrl: ctrl+1-9 = window N, ctrl+shift+1-9 = pane N, ctrl+, / ctrl+. =
  // prev / next window, ctrl+' = split. Needed because the terminal would
  // otherwise encode these as legacy control bytes or a bare character (ctrl+1
  // arrives as `1`, ctrl+3 as ESC) and tmux could never match them.
  // Deliberately NOT twinned: ctrl+m (Enter), ctrl+[ (ESC), ctrl+d (EOF),
  // ctrl+\ (SIGQUIT), ctrl+x (readline prefix), ctrl+/ (readline undo),
  // ctrl+] (telnet/ssh escape) - each is a control character every app relies on.
  // Outside tmux, bash reads ESC <digit> as a digit-argument, same as alt+<digit>.
  { "key": "ctrl+1", "action": "text:\\x1b1" },
  { "key": "ctrl+2", "action": "text:\\x1b2" },
  { "key": "ctrl+3", "action": "text:\\x1b3" },
  { "key": "ctrl+4", "action": "text:\\x1b4" },
  { "key": "ctrl+5", "action": "text:\\x1b5" },
  { "key": "ctrl+6", "action": "text:\\x1b6" },
  { "key": "ctrl+7", "action": "text:\\x1b7" },
  { "key": "ctrl+8", "action": "text:\\x1b8" },
  { "key": "ctrl+9", "action": "text:\\x1b9" },
  { "key": "ctrl+shift+1", "action": "text:\\x1b!" },
  { "key": "ctrl+shift+2", "action": "text:\\x1b@" },
  { "key": "ctrl+shift+3", "action": "text:\\x1b#" },
  { "key": "ctrl+shift+4", "action": "text:\\x1b$" },
  { "key": "ctrl+shift+5", "action": "text:\\x1b%" },
  { "key": "ctrl+shift+6", "action": "text:\\x1b^" },
  { "key": "ctrl+shift+7", "action": "text:\\x1b&" },
  { "key": "ctrl+shift+8", "action": "text:\\x1b*" },
  { "key": "ctrl+shift+9", "action": "text:\\x1b(" },
  { "key": "ctrl+,", "action": "text:\\x1b," },
  { "key": "ctrl+.", "action": "text:\\x1b." },
  { "key": "ctrl+'", "action": "text:\\x1b'" },

  // ---- View ----
  { "key": "f11", "action": "toggle_fullscreen" },
  // OS_KEY+\ toggles the title bar / tab bar (matches Windows Terminal's
  // "show/hide tab bar" gesture). With macos-titlebar-style=tabs the tabs live
  // in the title bar, so this hides both together.
  { "key": "OS_KEY+\\", "action": "toggle_window_decorations" },
]
