{
  // Sy Light — Ghostty theme source. Rendered to ~/.config/ghostty/themes/Sy Light
  // by software/scripts/advanced/ghostty.js as `key = value` lines.
  //
  // Every literal here is stamped from COLOR_MAP in software/tools/build-include.js
  // by `make format_build_include`. Edit COLOR_MAP, never these values.
  // software/tests/terminalThemes.spec.js fails if a literal drifts off its marker.
  //
  // Structure must stay identical to ghostty-color-dark.jsonc — the spec compares
  // the two key sets so a color can never be added to one mode only.

  // --- ANSI ramp ---
  // Index order is fixed by terminal convention: 0-7 normal, 8-15 bright.
  // On a light background the bases are the deep end (~10:1) and the brights sit
  // at the 7:1 floor, so tools that "dim" with the base color render darker
  // rather than washing out. `white` / `brightWhite` are the ramp anchors and are
  // exempt from the floor; the warm hues (`yellow`, `brightYellow`) are held at
  // >= 5.5:1 on purpose — a 7:1 yellow on white reads as brown.
  "palette": [
    "#000000", // {{light.black}}
    "#840000", // {{light.red}}
    "#004a15", // {{light.green}}
    "#775502", // {{light.yellow}}
    "#0033b3", // {{light.blue}}
    "#6c0099", // {{light.purple}}
    "#00416f", // {{light.cyan}}
    "#6d6d6d", // {{light.white}}
    "#4a4a4a", // {{light.brightBlack}}
    "#a12626", // {{light.brightRed}}
    "#106145", // {{light.brightGreen}}
    "#7f6000", // {{light.brightYellow}}
    "#0051ae", // {{light.brightBlue}}
    "#8700c1", // {{light.brightPurple}}
    "#145e5e", // {{light.brightCyan}}
    "#8b8b8b", // {{light.brightWhite}}
  ],

  // --- Surfaces ---
  "background": "#f8f8f8", // {{light.background}}
  "foreground": "#1e1e1e", // {{light.foreground}}

  // --- Cursor ---
  // cursor-text is the background so the glyph under a block cursor inverts cleanly.
  "cursor-color": "#0451a5", // {{light.cursorColor}}
  "cursor-text": "#f8f8f8", // {{light.background}}

  // --- Selection ---
  // Explicit foreground: without it Ghostty keeps the cell's own color, which can
  // land a dim ANSI hue on the selection fill.
  "selection-background": "#96c6fa", // {{light.selection}}
  "selection-foreground": "#1e1e1e", // {{light.foreground}}
}
