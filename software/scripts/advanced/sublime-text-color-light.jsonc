{
  // High Contrast Light - modeled after VS Code Default High Contrast Light
  "variables": {
    // Surfaces
    "bg": "#f8f8f8", // {{light.background}}
    "surface": "#ececec", // {{light.surface}}
    "fg": "#1e1e1e", // {{light.foreground}}
    "fg_dim": "#5a5a5a", // {{light.textDisabled}}
    "caret": "#0451a5", // {{light.cursorColor}}
    "accent": "#0252ad", // {{light.linkBlue}}

    // Fills
    "selection": "#96c6fa", // {{light.selection}}
    "line_highlight": "#cfe0f7", // {{light.activeLine}}
    "word_highlight": "#cacaca", // {{light.gray}}
    "match": "#ffbe3d", // {{light.matchHighlight}}

    // Strokes
    "guide": "#a4a4a4", // {{light.guide}}
    "guide_active": "#262626", // {{light.brightGray}}
    "border": "#262626", // {{light.brightGray}}
    "gutter_fg": "#5a5a5a", // {{light.textDisabled}}

    // Syntax
    "comment": "#004a15", // {{light.green}}
    "string": "#a12626", // {{light.brightRed}}
    "escape": "#734e06", // {{light.gold}}
    "number": "#03623a", // {{light.darkGreen}}
    "keyword": "#0033b3", // {{light.blue}}
    "flow": "#8700c1", // {{light.brightPurple}}
    "function": "#6a5100", // {{light.brown}}
    "type": "#145e5e", // {{light.brightCyan}}
    "variable": "#001080", // {{light.darkBlue}}
    "constant": "#00416f", // {{light.cyan}}
    "tag": "#9b2c2c", // {{light.darkRed}}
    "property": "#001080", // {{light.darkBlue}}
    "regexp": "#9b2c2c", // {{light.darkRed}}
    "link": "#a12626", // {{light.brightRed}}
    "added": "#004a15", // {{light.green}}
    "modified": "#6a5100", // {{light.brown}}
    "deleted": "#840000", // {{light.red}}
    "invalid": "#840000", // {{light.red}}
  },
  "globals": {
    // Editor chrome
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(caret)",
    "block_caret": "var(caret)",
    "invisibles": "var(guide)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(gutter_fg)",
    "gutter_foreground_highlight": "var(fg)",
    "accent": "var(accent)",
    "minimap_border": "var(accent)",
    "misspelling": "var(deleted)",

    // Selection & highlight
    "selection": "var(selection)",
    "selection_foreground": "var(fg)",
    "selection_border": "var(accent)",
    "selection_border_width": "1",
    "selection_corner_style": "round",
    "inactive_selection": "var(word_highlight)",
    "inactive_selection_foreground": "var(fg)",
    "line_highlight": "var(line_highlight)",
    "highlight": "var(word_highlight)",
    "find_highlight": "var(match)",
    "find_highlight_foreground": "#1e1e1e", // {{light.foreground}}
    "scroll_highlight": "var(match)",
    "scroll_selected_highlight": "var(accent)",

    // Guides
    "guide": "var(guide)",
    "stack_guide": "var(guide)",
    "active_guide": "var(guide_active)",
    "rulers": "var(guide)",

    // Brackets & tags
    "brackets_foreground": "var(function)",
    "brackets_options": "underline",
    "bracket_contents_foreground": "var(function)",
    "bracket_contents_options": "underline",
    "tags_foreground": "var(tag)",
    "tags_options": "underline",

    // Git diff
    "line_diff_width": "3",
    "line_diff_added": "var(added)",
    "line_diff_modified": "var(modified)",
    "line_diff_deleted": "var(deleted)",

    // Fold markers & shadow
    "fold_marker": "var(accent)",
    "shadow": "#00000066", // {{light.black_alpha40}}
    "shadow_width": "6",

    // Padding
    "block_caret_border": "0",
    "line_padding_top": "1",
    "line_padding_bottom": "1",

    "popup_css": "html { background-color: #ececec; color: #1e1e1e; border: 1px solid #262626; } a { color: #0252ad; }",
  },
  "rules": [
    // Syntax
    { "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)" },
    { "scope": "string, string.quoted", "foreground": "var(string)" },
    { "scope": "constant.character.escape", "foreground": "var(escape)" },
    { "scope": "constant.numeric", "foreground": "var(number)" },
    { "scope": "constant.language", "foreground": "var(keyword)" },
    { "scope": "keyword, keyword.control, keyword.operator.word", "foreground": "var(keyword)" },
    { "scope": "keyword.operator, punctuation.accessor", "foreground": "var(fg)" },
    { "scope": "storage, storage.type, storage.modifier", "foreground": "var(keyword)" },
    { "scope": "keyword.control.import, keyword.control.export, keyword.control.flow", "foreground": "var(flow)" },

    // Identifiers
    { "scope": "entity.name.function, meta.function-call, variable.function", "foreground": "var(function)" },
    { "scope": "support.function", "foreground": "var(function)" },
    {
      "scope": "entity.name.class, entity.name.type, entity.other.inherited-class, support.class, support.type",
      "foreground": "var(type)",
    },
    { "scope": "variable, variable.other, variable.parameter", "foreground": "var(variable)" },
    { "scope": "variable.other.constant, support.constant", "foreground": "var(constant)" },

    // HTML / XML
    { "scope": "entity.name.tag", "foreground": "var(tag)" },
    { "scope": "entity.other.attribute-name", "foreground": "var(property)" },

    // CSS
    { "scope": "support.type.property-name", "foreground": "var(property)" },
    { "scope": "support.constant.property-value, constant.other.color", "foreground": "var(string)" },
    { "scope": "entity.other.attribute-name.class, entity.other.attribute-name.id, entity.name.tag.css", "foreground": "var(escape)" },

    // Regex
    { "scope": "string.regexp", "foreground": "var(regexp)" },

    // Markdown
    { "scope": "markup.heading, punctuation.definition.heading", "foreground": "var(keyword)", "font_style": "bold" },
    { "scope": "markup.bold", "font_style": "bold" },
    { "scope": "markup.italic", "font_style": "italic" },
    { "scope": "markup.underline.link", "foreground": "var(link)" },
    { "scope": "markup.raw, markup.raw.inline", "foreground": "var(link)" },

    // Diff
    { "scope": "markup.inserted", "foreground": "var(number)" },
    { "scope": "markup.deleted", "foreground": "var(deleted)" },
    { "scope": "markup.changed", "foreground": "var(modified)" },

    // Data formats
    { "scope": "meta.mapping.key string, support.type.property-name.json", "foreground": "var(variable)" },
    { "scope": "entity.name.tag.yaml", "foreground": "var(variable)" },

    // Invalid
    { "scope": "invalid, invalid.deprecated", "foreground": "var(invalid)" },
  ],
}
