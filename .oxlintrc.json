        "is_os_wsl": "readonly",
        "is_gui": "readonly",
        "is_gui_x11": "readonly",
        "is_gui_wayland": "readonly",
        "IS_CI": "readonly",
        "IS_SETUP": "readonly",
        "IS_FORCE_REFRESH": "readonly",
        "IS_ADVANCED_PROFILE_ENABLED": "readonly",
        "IS_CUSTOM_THEME_DISABLED": "readonly",
        "IS_DEBUG": "readonly",
        "IS_VERBOSE": "readonly",
        "IS_DRYRUN": "readonly",
        "IS_REMOVE": "readonly",
        "BASHRC_TEMP_DIR": "readonly",
        "BASHRC_TEMP_ROOT_DIR": "readonly",
        "BASH_SYLE_PATH": "readonly",
        "POWERSHELL_SYLE_PATH": "readonly",
