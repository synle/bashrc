{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "no-control-regex": "off"
  },
  "ignorePatterns": ["node_modules/**", ".build/**", "dist/**", "coverage/**", "software/types/**"],
  "overrides": [
    {
      "files": ["software/scripts/**/*.js", "software/scripts/**/*.cjs"],
      "globals": {
        "code": "readonly",
        "list": "readonly",
        "set": "readonly",
        "json": "readonly",
        "text": "readonly",
        "readText": "readonly",
        "readJson": "readonly",
        "readList": "readonly",
        "readSet": "readonly",
        "requireUrl": "readonly",
        "resolvePlaceholders": "readonly",
        "writeText": "readonly",
        "writeJson": "readonly",
        "writeJsonWithMerge": "readonly",
        "writeConfigToFile": "readonly",
        "writeBuildArtifact": "readonly",
        "safeWriteText": "readonly",
        "writeTextIfSignificantChange": "readonly",
        "appendText": "readonly",
        "replaceTextLineByLine": "readonly",
        "touchFile": "readonly",
        "copyFile": "readonly",
        "safeCopyFile": "readonly",
        "safeSymlink": "readonly",
        "mkdir": "readonly",
        "deleteFile": "readonly",
        "deleteFolder": "readonly",
        "unzip": "readonly",
        "backupConfigFile": "readonly",
        "backupText": "readonly",
        "backupProfileSnapshot": "readonly",
        "findPath": "readonly",
