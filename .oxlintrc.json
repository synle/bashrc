        "downloadAndInstallBinary": "readonly",
        "installMacDmg": "readonly",
        "clearMacQuarantine": "readonly",
        "installWindowsSetupExe": "readonly",
        "installLinuxUniversalAppImage": "readonly",
        "installBrowserExtension": "readonly",
        "gitClone": "readonly",
        "fetchGitHubReleaseVersion": "readonly",
        "getGitHubRawUrl": "readonly",
        "getNativeArch": "readonly",
        "isMachOArchMismatch": "readonly",
        "isMacInstalledAppArchMismatched": "readonly",
        "getMacInstalledAppVersion": "readonly",
        "getInstalledVersionStampPath": "readonly",
        "readInstalledVersionStamp": "readonly",
        "writeInstalledVersionStamp": "readonly",
        "registerProfileBlock": "readonly",
