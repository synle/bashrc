        "exitIfPathFound": "readonly",
        "exitIfPathNotFound": "readonly",
        "exitIfNotSudo": "readonly",
        "exitIfNoChromiumBrowser": "readonly",
        "exitIfNoGui": "readonly",
        "isForceRefreshStale": "readonly",
        "isPathStale": "readonly",
        "isBashSyleStale": "readonly",
        "execBash": "readonly",
        "execBashSync": "readonly",
        "hasBinary": "readonly",
        "emitBash": "readonly",
        "log": "readonly",
        "echo": "readonly",
        "printSectionBlock": "readonly",
        "printRunInfo": "readonly",
        "printActionSummary": "readonly",
        "getRuntimeOption": "readonly",
