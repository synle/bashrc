  "sourceText": "{\n  // Sy Dark — Termux palette source. Rendered to ~/.termux/colors.properties by\n  // software/scripts/android_termux/termux-colors.js as `key: value` lines.\n  //\n  // Every literal here is stamped from COLOR_MAP in software/tools/build-include.js\n  // by `make format_build_include`. Edit COLOR_MAP, never these values.\n  //\n  // Dark-only on purpose: Termux sets `night-mode = true` in termux.properties and\n  // Android gives no per-app light/dark terminal switch, so there is no light variant\n  // to keep in sync. This replaced a hardcoded Dracula palette whose worst hue was\n  // 4.53:1 and whose color0 sat at 1.47:1 against its own background — invisible.\n\n  // --- Surfaces ---\n  \"background\": \"#0a0a0a\", // {{dark.background}}\n  \"foreground\": \"#e8e8e8\", // {{dark.foreground}}\n\n  // --- Cursor ---\n  \"cursor\": \"#5ca0d7\", // {{dark.cursorColor}}\n\n  // --- ANSI ramp ---\n  // Index order is fixed by terminal convention: 0-7 normal, 8-15 bright.\n  // `black` and `brightWhite` are the ramp anchors and are exempt from the 7:1\n  // floor; every other index is tuned against `background`.\n  \"palette\": [\n    \"#000000\", // {{dark.black}}\n    \"#f67070\", // {{dark.red}}\n    \"#76a762\", // {{dark.green}}\n    \"#dcdcaa\", // {{dark.yellow}}\n    \"#5ca0d7\", // {{dark.blue}}\n    \"#c586c0\", // {{dark.purple}}\n    \"#4ec9b0\", // {{dark.cyan}}\n    \"#cccccc\", // {{dark.white}}\n    \"#a0a0a0\", // {{dark.brightBlack}}\n    \"#ff6e6e\", // {{dark.brightRed}}\n    \"#69ff94\", // {{dark.brightGreen}}\n    \"#ffffa5\", // {{dark.brightYellow}}\n    \"#4fc1ff\", // {{dark.brightBlue}}\n    \"#ff92df\", // {{dark.brightPurple}}\n    \"#a4ffff\", // {{dark.brightCyan}}\n    \"#ffffff\", // {{dark.brightWhite}}\n  ],\n}\n",
}
