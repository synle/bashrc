/*
Sy dark palette foundation. Existing base hues plus semantic color recipes.
Variants and template literals are rendered by software/tools/build-include.js.
*/
{
  "themeName": "Sy Dark",
  "background": "#0a0a0a",
  "surface": "#161616",
  "activeLine": "#1f2a38",
  "matchHighlight": "#5c4300",
  "gray": "#2b2b2b",
  "pressed": "#3d3d3d",
  "selection": "#1b3c5e",
  "brightGray": "#6e6e6e",
  "guide": "#464646",
  "foreground": "#e8e8e8",
  "textDisabled": "#8f8f8f",
  "cursorColor": "#5ca0d7",
  "black": "#000000",
  "blue": "#5ca0d7",
  "brightBlack": "#a0a0a0",
  "brightBlue": "#4fc1ff",
  "brightCyan": "#a4ffff",
  "brightGreen": "#69ff94",
  "brightPurple": "#ff92df",
  "brightRed": "#ff6e6e",
  "brightWhite": "#ffffff",
  "brightYellow": "#ffffa5",
  "cyan": "#4ec9b0",
  "green": "#76a762",
  "purple": "#c586c0",
  "red": "#f67070",
  "white": "#cccccc",
  "yellow": "#dcdcaa",
  "lightBlue": "#9cdcfe",
  "lightGreen": "#b5cea8",
  "orange": "#ce9178",
  "gold": "#d7ba7d",
  "darkBlue": "#9cdcfe",
  "linkBlue": "#4fc1ff",
  "darkGreen": "#8fbf7a",
  "brown": "#d7ba7d",
  "darkRed": "#d98282",
  "textSecondary": {
    "from": "foreground",
    "over": "brightBlack",
    "alpha": 0.25,
  },
  "whitespaceMarker": "#b8b8b8",
  "lineEndingMarker": "#8f9e92",
  "terminalBlack": {
    "ref": "brightGray",
  },
  "selectionSyntax": {
    "from": "selection",
    "over": "background",
    "alpha": 0.75,
  },
  "matchHighlightSyntax": {
    "from": "matchHighlight",
    "over": "background",
    "alpha": 0.4,
  },
  "activeMatchSyntax": {
    "from": "blue",
    "over": "background",
    "alpha": 0.15,
  },
  "diffAddedBackground": {
    "from": "green",
    "over": "background",
    "alpha": 0.1,
  },
  "diffRemovedBackground": {
    "from": "red",
    "over": "background",
    "alpha": 0.1,
  },
  "diffAddedWordBackground": {
    "from": "green",
    "over": "background",
    "alpha": 0.2,
  },
  "diffRemovedWordBackground": {
    "from": "red",
    "over": "background",
    "alpha": 0.2,
  },
  "diffAddedMutedBackground": { "from": "green", "over": "background", "alpha": 0.05 },
  "diffRemovedMutedBackground": { "from": "red", "over": "background", "alpha": 0.05 },
  "warningBackground": {
    "from": "yellow",
    "over": "background",
    "alpha": 0.1,
  },
}
