  "sourceText": "{\n  // Sy palette bound to COLOR_MAP, matching Sublime. Refresh with make format_build_include.\n  \"name\": \"Sy Light\", // {{light.themeName}}\n  \"foreground\": \"#1e1e1e\", // {{light.foreground}}\n  \"muted\": \"#5a5a5a\", // {{light.textDisabled}}\n  \"border\": \"#262626\", // {{light.brightGray}}\n  \"accent\": \"#0252ad\", // {{light.linkBlue}}\n  \"shimmer\": \"#0051ae\", // {{light.brightBlue}}\n  \"info\": \"#0033b3\", // {{light.blue}}\n  \"success\": \"#004a15\", // {{light.green}}\n  \"error\": \"#840000\", // {{light.red}}\n  \"warning\": \"#775502\", // {{light.yellow}}\n  \"background\": \"#f8f8f8\", // {{light.background}}\n  \"surface\": \"#ececec\", // {{light.surface}}\n  \"hover\": \"#cacaca\", // {{light.gray}}\n  \"selection\": \"#96c6fa\", // {{light.selection}}\n}\n",
