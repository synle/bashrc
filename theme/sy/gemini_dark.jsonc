/*
Sy dark native template. Colors are generated from _palette_dark.jsonc.
Edit marker roles, then run make format_build_include; do not edit generated literals.
*/
{
  "name": "Sy Dark", // {{dark.themeName}}
  "type": "custom",
  "DarkGray": "#6e6e6e", // {{dark.brightGray}}
  // Native focus fallback: ui.focus is rejected by Gemini 0.64 settings validation.
  "AccentGreen": "#5ca0d7", // {{dark.blue}}
  "text": {
    "primary": "#e8e8e8", // {{dark.foreground}}
    "secondary": "#b2b2b2", // {{dark.textSecondary}}
    "link": "#4fc1ff", // {{dark.linkBlue}}
    "accent": "#5ca0d7", // {{dark.blue}}
    "response": "#e8e8e8", // {{dark.foreground}}
  },
  "background": {
    "diff": {
      "added": "#151a13", // {{dark.diffAddedBackground}}
      "removed": "#221414", // {{dark.diffRemovedBackground}}
    },
    "primary": "#0a0a0a", // {{dark.background}}
  },

  "status": {
    "error": "#f67070", // {{dark.red}}
    "success": "#76a762", // {{dark.green}}
    "warning": "#dcdcaa", // {{dark.yellow}}
  },
  "ui": {
    "comment": "#76a762", // {{dark.green}}
    "symbol": "#e8e8e8", // {{dark.foreground}}
    "gradient": [
      "#5ca0d7", // {{dark.blue}}
      "#4ec9b0", // {{dark.cyan}}
      "#c586c0", // {{dark.purple}}
    ],
  },
}
