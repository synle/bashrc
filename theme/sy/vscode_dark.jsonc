    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": ["comment", "punctuation.definition.comment"],
          "settings": {
            "foreground": "#76a762",
          },
        },
        {
          "scope": ["string", "string.quoted"],
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": "constant.character.escape",
          "settings": {
            "foreground": "#d7ba7d",
          },
        },
        {
          "scope": "constant.numeric",
          "settings": {
            "foreground": "#b5cea8",
          },
        },
        {
          "scope": "constant.language",
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["keyword", "keyword.control", "keyword.operator.word"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["keyword.operator", "punctuation.accessor"],
          "settings": {
            "foreground": "#e8e8e8",
          },
        },
        {
          "scope": ["storage", "storage.type", "storage.modifier"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.flow"],
          "settings": {
            "foreground": "#c586c0",
          },
        },
        {
          "scope": ["entity.name.function", "meta.function-call", "variable.function"],
          "settings": {
            "foreground": "#dcdcaa",
          },
        },
        {
          "scope": "support.function",
          "settings": {
            "foreground": "#dcdcaa",
          },
        },
        {
          "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"],
          "settings": {
            "foreground": "#4ec9b0",
          },
        },
        {
          "scope": ["variable", "variable.other", "variable.parameter"],
          "settings": {
            "foreground": "#9cdcfe",
          },
        },
        {
          "scope": ["variable.other.constant", "support.constant"],
          "settings": {
            "foreground": "#4fc1ff",
          },
        },
        {
          "scope": "entity.name.tag",
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": "entity.other.attribute-name",
          "settings": {
            "foreground": "#9cdcfe",
          },
        },
        {
          "scope": "support.type.property-name",
          "settings": {
            "foreground": "#9cdcfe",
          },
        },
        {
          "scope": ["support.constant.property-value", "constant.other.color"],
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css"],
          "settings": {
            "foreground": "#d7ba7d",
          },
        },
        {
          "scope": "string.regexp",
          "settings": {
            "foreground": "#d98282",
          },
        },
        {
          "scope": ["markup.heading", "punctuation.definition.heading"],
          "settings": {
            "fontStyle": "bold",
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": "markup.bold",
          "settings": {
            "fontStyle": "bold",
          },
        },
        {
          "scope": "markup.italic",
          "settings": {
            "fontStyle": "italic",
          },
        },
        {
          "scope": "markup.underline.link",
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": ["markup.raw", "markup.raw.inline"],
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": "markup.inserted",
          "settings": {
            "foreground": "#b5cea8",
          },
        },
        {
          "scope": "markup.deleted",
          "settings": {
            "foreground": "#f67070",
          },
        },
        {
          "scope": "markup.changed",
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": ["meta.mapping.key string", "support.type.property-name.json"],
          "settings": {
            "foreground": "#9cdcfe",
          },
        },
        {
          "scope": "entity.name.tag.yaml",
          "settings": {
            "foreground": "#9cdcfe",
          },
        },
        {
          "scope": ["invalid", "invalid.deprecated"],
          "settings": {
            "foreground": "#f67070",
          },
        },
        {
          "scope": ["meta.diff.header", "meta.diff.header.from-file", "meta.diff.header.to-file"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["constant.character", "variable.language.this"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.cast"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": ["source.cpp keyword.operator.new", "source.cpp keyword.operator.delete", "keyword.other.using"],
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": "token.info-token",
          "settings": {
            "foreground": "#5ca0d7",
          },
        },
        {
          "scope": "meta.preprocessor",
          "settings": {
            "foreground": "#c586c0",
          },
        },
        {
          "scope": "punctuation.definition.tag",
          "settings": {
            "foreground": "#e8e8e8",
          },
        },
        {
          "scope": [
            "punctuation.definition.template-expression.begin",
            "punctuation.definition.template-expression.end",
            "punctuation.section.embedded",
          ],
          "settings": {
            "foreground": "#d7ba7d",
          },
        },
        {
          "scope": "token.warn-token",
          "settings": {
            "foreground": "#dcdcaa",
          },
        },
        {
          "scope": "token.error-token",
          "settings": {
            "foreground": "#f67070",
          },
        },
        {
          "scope": "constant.regexp",
          "settings": {
            "foreground": "#d98282",
          },
        },
        {
          "scope": [
            "punctuation.definition.group.regexp",
            "punctuation.definition.group.assertion.regexp",
            "punctuation.definition.character-class.regexp",
            "keyword.operator.or.regexp",
            "keyword.control.anchor.regexp",
            "punctuation.character.set.begin.regexp",
            "punctuation.character.set.end.regexp",
            "keyword.operator.negation.regexp",
            "support.other.parenthesis.regexp",
          ],
          "settings": {
            "foreground": "#d98282",
          },
        },
        {
          "scope": ["variable.other.enummember", "keyword.operator.plus.exponent", "keyword.operator.minus.exponent"],
          "settings": {
            "foreground": "#b5cea8",
          },
        },
        {
          "scope": ["constant.sha.git-rebase", "keyword.other.unit", "meta.preprocessor.numeric"],
          "settings": {
            "foreground": "#b5cea8",
          },
        },
        {
          "scope": "meta.preprocessor.string",
          "settings": {
            "foreground": "#ce9178",
          },
        },
        {
          "scope": [
            "entity.name.namespace",
            "entity.other.attribute",
            "entity.name.scope-resolution",
            "meta.type.cast.expr",
            "meta.type.new.expr",
            "support.constant.math",
          ],
          "settings": {
            "foreground": "#4ec9b0",
          },
        },
        {
          "scope": [
            "storage.type.numeric.go",
            "storage.type.byte.go",
            "storage.type.boolean.go",
            "storage.type.string.go",
            "storage.type.uintptr.go",
            "storage.type.error.go",
