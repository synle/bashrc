    },
  },
  "sourceText": "{\n  // High Contrast Dark - modeled after VS Code Default High Contrast\n  \"workbench.colorCustomizations\": {\n    // --- Base ---\n    \"foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"disabledForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"descriptionForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"errorForeground\": \"#f67070\", // {{dark.red}}\n    \"focusBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"contrastBorder\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"contrastActiveBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"widget.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"widget.shadow\": \"#00000066\", // {{dark.black_alpha40}}\n    \"sash.hoverBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"selection.background\": \"#1b3c5e\", // {{dark.selection}}\n    \"textLink.foreground\": \"#4fc1ff\", // {{dark.linkBlue}}\n    \"textLink.activeForeground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"progressBar.background\": \"#5ca0d7\", // {{dark.cursorColor}}\n\n    // --- Editor Chrome ---\n    \"editor.background\": \"#0a0a0a\", // {{dark.background}}\n    \"editor.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorCursor.foreground\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"editorGutter.background\": \"#0a0a0a\", // {{dark.background}}\n    \"editorLineNumber.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"editorLineNumber.activeForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorLineNumber.dimmedForeground\": \"#464646\", // {{dark.guide}}\n    \"editorRuler.foreground\": \"#464646\", // {{dark.guide}}\n    \"editorWhitespace.foreground\": \"#464646\", // {{dark.guide}}\n    \"editorCodeLens.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"editorGhostText.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"editorInlayHint.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"editorInlayHint.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"editorStickyScroll.background\": \"#161616\", // {{dark.surface}}\n    \"editorStickyScrollHover.background\": \"#2b2b2b\", // {{dark.gray}}\n\n    // --- Selection & Highlight ---\n    \"editor.selectionBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"editor.selectionForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editor.selectionHighlightBackground\": \"#1b3c5e99\", // {{dark.selection_alpha60}}\n    \"editor.inactiveSelectionBackground\": \"#1b3c5e99\", // {{dark.selection_alpha60}}\n    \"editor.lineHighlightBackground\": \"#1f2a38\", // {{dark.activeLine}}\n    \"editor.findMatchBackground\": \"#5c4300\", // {{dark.matchHighlight}}\n    \"editor.findMatchHighlightBackground\": \"#5c430066\", // {{dark.matchHighlight_alpha40}}\n    \"editor.findMatchBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"editor.hoverHighlightBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"editor.rangeHighlightBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"editor.wordHighlightBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"editor.wordHighlightStrongBackground\": \"#3d3d3d\", // {{dark.pressed}}\n\n    // --- Indent Guides ---\n    \"editorIndentGuide.background1\": \"#464646\", // {{dark.guide}}\n    \"editorIndentGuide.activeBackground1\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"tree.indentGuidesStroke\": \"#464646\", // {{dark.guide}}\n    \"tree.inactiveIndentGuidesStroke\": \"#464646\", // {{dark.guide}}\n\n    // --- Brackets ---\n    \"editorBracketMatch.background\": \"#3d3d3d\", // {{dark.pressed}}\n    \"editorBracketMatch.border\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"editorBracketHighlight.foreground1\": \"#dcdcaa\", // {{dark.yellow}}\n    \"editorBracketHighlight.foreground2\": \"#c586c0\", // {{dark.purple}}\n    \"editorBracketHighlight.foreground3\": \"#4ec9b0\", // {{dark.cyan}}\n    \"editorBracketHighlight.foreground4\": \"#b5cea8\", // {{dark.lightGreen}}\n    \"editorBracketHighlight.foreground5\": \"#ce9178\", // {{dark.orange}}\n    \"editorBracketHighlight.foreground6\": \"#9cdcfe\", // {{dark.lightBlue}}\n    \"editorBracketHighlight.unexpectedBracket.foreground\": \"#f67070\", // {{dark.red}}\n\n    // --- Side Bar ---\n    \"sideBar.background\": \"#161616\", // {{dark.surface}}\n    \"sideBar.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"sideBar.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"sideBarTitle.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"sideBarSectionHeader.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"sideBarSectionHeader.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"sideBarSectionHeader.border\": \"#6e6e6e\", // {{dark.brightGray}}\n\n    // --- Activity Bar ---\n    \"activityBar.background\": \"#161616\", // {{dark.surface}}\n    \"activityBar.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"activityBar.inactiveForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"activityBar.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"activityBar.activeBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"activityBarBadge.background\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"activityBarBadge.foreground\": \"#0a0a0a\", // {{dark.background}}\n    \"badge.background\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"badge.foreground\": \"#0a0a0a\", // {{dark.background}}\n\n    // --- Panel & Status Bar ---\n    \"panel.background\": \"#161616\", // {{dark.surface}}\n    \"panel.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"panelTitle.activeForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"panelTitle.inactiveForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"panelTitle.activeBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"statusBar.background\": \"#161616\", // {{dark.surface}}\n    \"statusBar.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"statusBar.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"statusBar.noFolderBackground\": \"#161616\", // {{dark.surface}}\n    \"statusBarItem.hoverBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"statusBarItem.activeBackground\": \"#3d3d3d\", // {{dark.pressed}}\n    \"statusBarItem.remoteBackground\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"statusBarItem.remoteForeground\": \"#0a0a0a\", // {{dark.background}}\n    \"statusBarItem.errorBackground\": \"#f67070\", // {{dark.red}}\n    \"statusBarItem.errorForeground\": \"#0a0a0a\", // {{dark.background}}\n\n    // --- Title Bar & Menu ---\n    \"titleBar.activeBackground\": \"#161616\", // {{dark.surface}}\n    \"titleBar.activeForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"titleBar.inactiveBackground\": \"#0a0a0a\", // {{dark.background}}\n    \"titleBar.inactiveForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"titleBar.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"menu.background\": \"#161616\", // {{dark.surface}}\n    \"menu.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"menu.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"menu.selectionBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"menu.selectionForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"menu.separatorBackground\": \"#464646\", // {{dark.guide}}\n    \"menubar.selectionBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"menubar.selectionForeground\": \"#e8e8e8\", // {{dark.foreground}}\n\n    // --- Tabs ---\n    \"tab.activeBackground\": \"#0a0a0a\", // {{dark.background}}\n    \"tab.activeForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"tab.activeBorderTop\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"tab.inactiveBackground\": \"#161616\", // {{dark.surface}}\n    \"tab.inactiveForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"tab.hoverBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"tab.hoverForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"tab.unfocusedActiveBackground\": \"#0a0a0a\", // {{dark.background}}\n    \"tab.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorGroupHeader.tabsBackground\": \"#161616\", // {{dark.surface}}\n    \"editorGroupHeader.tabsBorder\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorGroup.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"breadcrumb.background\": \"#0a0a0a\", // {{dark.background}}\n    \"breadcrumb.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"breadcrumb.focusForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"breadcrumb.activeSelectionForeground\": \"#5ca0d7\", // {{dark.cursorColor}}\n\n    // --- Input & Dropdown ---\n    \"input.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"input.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"input.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"input.placeholderForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"inputOption.activeBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"inputOption.activeBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"inputOption.activeForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"inputValidation.errorBackground\": \"#161616\", // {{dark.surface}}\n    \"inputValidation.errorForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"inputValidation.errorBorder\": \"#f67070\", // {{dark.red}}\n    \"inputValidation.warningBackground\": \"#161616\", // {{dark.surface}}\n    \"inputValidation.warningForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"inputValidation.warningBorder\": \"#dcdcaa\", // {{dark.yellow}}\n    \"inputValidation.infoBackground\": \"#161616\", // {{dark.surface}}\n    \"inputValidation.infoForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"inputValidation.infoBorder\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"dropdown.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"dropdown.listBackground\": \"#161616\", // {{dark.surface}}\n    \"dropdown.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"dropdown.border\": \"#6e6e6e\", // {{dark.brightGray}}\n\n    // --- Buttons ---\n    \"button.background\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"button.foreground\": \"#0a0a0a\", // {{dark.background}}\n    \"button.hoverBackground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"button.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"button.secondaryBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"button.secondaryForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"button.secondaryHoverBackground\": \"#3d3d3d\", // {{dark.pressed}}\n\n    // --- Lists ---\n    \"list.activeSelectionBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"list.activeSelectionForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"list.inactiveSelectionBackground\": \"#3d3d3d\", // {{dark.pressed}}\n    \"list.inactiveSelectionForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"list.hoverBackground\": \"#2b2b2b\", // {{dark.gray}}\n    \"list.hoverForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"list.focusBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"list.focusForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"list.focusOutline\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"list.highlightForeground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"list.dropBackground\": \"#3d3d3d\", // {{dark.pressed}}\n    \"list.errorForeground\": \"#f67070\", // {{dark.red}}\n    \"list.warningForeground\": \"#dcdcaa\", // {{dark.yellow}}\n\n    // --- Scrollbar & Minimap ---\n    \"scrollbar.shadow\": \"#00000066\", // {{dark.black_alpha40}}\n    \"scrollbarSlider.background\": \"#6e6e6e99\", // {{dark.brightGray_alpha60}}\n    \"scrollbarSlider.hoverBackground\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"scrollbarSlider.activeBackground\": \"#a0a0a0\", // {{dark.brightBlack}}\n    \"minimap.background\": \"#0a0a0a\", // {{dark.background}}\n    \"minimap.selectionHighlight\": \"#1b3c5e\", // {{dark.selection}}\n    \"minimap.findMatchHighlight\": \"#5c4300\", // {{dark.matchHighlight}}\n    \"minimap.errorHighlight\": \"#f67070\", // {{dark.red}}\n    \"minimapSlider.background\": \"#6e6e6e33\", // {{dark.brightGray_alpha20}}\n    \"minimapSlider.hoverBackground\": \"#6e6e6e66\", // {{dark.brightGray_alpha40}}\n    \"minimapSlider.activeBackground\": \"#6e6e6e99\", // {{dark.brightGray_alpha60}}\n    \"editorOverviewRuler.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorOverviewRuler.addedForeground\": \"#76a762\", // {{dark.green}}\n    \"editorOverviewRuler.modifiedForeground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"editorOverviewRuler.deletedForeground\": \"#f67070\", // {{dark.red}}\n    \"editorOverviewRuler.errorForeground\": \"#f67070\", // {{dark.red}}\n    \"editorOverviewRuler.warningForeground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"editorOverviewRuler.findMatchForeground\": \"#5c4300\", // {{dark.matchHighlight}}\n    \"editorOverviewRuler.selectionHighlightForeground\": \"#6e6e6e\", // {{dark.brightGray}}\n\n    // --- Git & Diff ---\n    \"diffEditor.insertedTextBackground\": \"#76a76233\", // {{dark.green_alpha20}}\n    \"diffEditor.removedTextBackground\": \"#f6707033\", // {{dark.red_alpha20}}\n    \"diffEditor.insertedLineBackground\": \"#76a7621a\", // {{dark.green_alpha10}}\n    \"diffEditor.removedLineBackground\": \"#f670701a\", // {{dark.red_alpha10}}\n    \"diffEditor.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorGutter.addedBackground\": \"#76a762\", // {{dark.green}}\n    \"editorGutter.modifiedBackground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"editorGutter.deletedBackground\": \"#f67070\", // {{dark.red}}\n    \"gitDecoration.addedResourceForeground\": \"#76a762\", // {{dark.green}}\n    \"gitDecoration.modifiedResourceForeground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"gitDecoration.deletedResourceForeground\": \"#f67070\", // {{dark.red}}\n    \"gitDecoration.untrackedResourceForeground\": \"#76a762\", // {{dark.green}}\n    \"gitDecoration.ignoredResourceForeground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"gitDecoration.conflictingResourceForeground\": \"#ce9178\", // {{dark.orange}}\n\n    // --- Diagnostics ---\n    \"editorError.foreground\": \"#f67070\", // {{dark.red}}\n    \"editorWarning.foreground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"editorInfo.foreground\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"editorHint.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"problemsErrorIcon.foreground\": \"#f67070\", // {{dark.red}}\n    \"problemsWarningIcon.foreground\": \"#dcdcaa\", // {{dark.yellow}}\n    \"problemsInfoIcon.foreground\": \"#5ca0d7\", // {{dark.cursorColor}}\n\n    // --- Widgets & Popups ---\n    \"editorWidget.background\": \"#161616\", // {{dark.surface}}\n    \"editorWidget.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorWidget.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorSuggestWidget.background\": \"#161616\", // {{dark.surface}}\n    \"editorSuggestWidget.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorSuggestWidget.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"editorSuggestWidget.selectedBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"editorSuggestWidget.selectedForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorSuggestWidget.highlightForeground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"editorSuggestWidget.focusHighlightForeground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"editorHoverWidget.background\": \"#161616\", // {{dark.surface}}\n    \"editorHoverWidget.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"editorHoverWidget.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"quickInput.background\": \"#161616\", // {{dark.surface}}\n    \"quickInput.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"quickInputList.focusBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"quickInputList.focusForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"pickerGroup.foreground\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"pickerGroup.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"keybindingLabel.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"keybindingLabel.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"keybindingLabel.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"keybindingLabel.bottomBorder\": \"#464646\", // {{dark.guide}}\n    \"notifications.background\": \"#161616\", // {{dark.surface}}\n    \"notifications.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"notifications.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"notificationCenterHeader.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"notificationCenterHeader.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"notificationLink.foreground\": \"#4fc1ff\", // {{dark.linkBlue}}\n    \"peekView.border\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"peekViewEditor.background\": \"#161616\", // {{dark.surface}}\n    \"peekViewEditor.matchHighlightBackground\": \"#5c4300\", // {{dark.matchHighlight}}\n    \"peekViewResult.background\": \"#161616\", // {{dark.surface}}\n    \"peekViewResult.selectionBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"peekViewResult.lineForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"peekViewResult.fileForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"peekViewTitle.background\": \"#2b2b2b\", // {{dark.gray}}\n    \"peekViewTitleLabel.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"peekViewTitleDescription.foreground\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"debugToolBar.background\": \"#161616\", // {{dark.surface}}\n    \"debugToolBar.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"settings.headerForeground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"settings.modifiedItemIndicator\": \"#5ca0d7\", // {{dark.cursorColor}}\n\n    // --- Terminal ---\n    \"terminal.background\": \"#0a0a0a\", // {{dark.background}}\n    \"terminal.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n    \"terminal.border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"terminal.selectionBackground\": \"#1b3c5e\", // {{dark.selection}}\n    \"terminalCursor.foreground\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"terminalCursor.background\": \"#0a0a0a\", // {{dark.background}}\n    \"terminal.ansiBlack\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"terminal.ansiRed\": \"#f67070\", // {{dark.red}}\n    \"terminal.ansiGreen\": \"#76a762\", // {{dark.green}}\n    \"terminal.ansiYellow\": \"#dcdcaa\", // {{dark.yellow}}\n    \"terminal.ansiBlue\": \"#5ca0d7\", // {{dark.blue}}\n    \"terminal.ansiMagenta\": \"#c586c0\", // {{dark.purple}}\n    \"terminal.ansiCyan\": \"#4ec9b0\", // {{dark.cyan}}\n    \"terminal.ansiWhite\": \"#cccccc\", // {{dark.white}}\n    \"terminal.ansiBrightBlack\": \"#a0a0a0\", // {{dark.brightBlack}}\n    \"terminal.ansiBrightRed\": \"#ff6e6e\", // {{dark.brightRed}}\n    \"terminal.ansiBrightGreen\": \"#69ff94\", // {{dark.brightGreen}}\n    \"terminal.ansiBrightYellow\": \"#ffffa5\", // {{dark.brightYellow}}\n    \"terminal.ansiBrightBlue\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"terminal.ansiBrightMagenta\": \"#ff92df\", // {{dark.brightPurple}}\n    \"terminal.ansiBrightCyan\": \"#a4ffff\", // {{dark.brightCyan}}\n    \"terminal.ansiBrightWhite\": \"#ffffff\", // {{dark.brightWhite}}\n  },\n  \"editor.tokenColorCustomizations\": {\n    \"textMateRules\": [\n      // --- Syntax ---\n      { \"scope\": [\"comment\", \"punctuation.definition.comment\"], \"settings\": { \"foreground\": \"#76a762\" } }, // {{dark.green}}\n      { \"scope\": [\"string\", \"string.quoted\"], \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n      { \"scope\": \"constant.character.escape\", \"settings\": { \"foreground\": \"#d7ba7d\" } }, // {{dark.gold}}\n      { \"scope\": \"constant.numeric\", \"settings\": { \"foreground\": \"#b5cea8\" } }, // {{dark.lightGreen}}\n      { \"scope\": \"constant.language\", \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": [\"keyword\", \"keyword.control\", \"keyword.operator.word\"], \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": [\"keyword.operator\", \"punctuation.accessor\"], \"settings\": { \"foreground\": \"#e8e8e8\" } }, // {{dark.foreground}}\n      { \"scope\": [\"storage\", \"storage.type\", \"storage.modifier\"], \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": [\"keyword.control.import\", \"keyword.control.export\", \"keyword.control.flow\"], \"settings\": { \"foreground\": \"#c586c0\" } }, // {{dark.purple}}\n\n      // --- Identifiers ---\n      { \"scope\": [\"entity.name.function\", \"meta.function-call\", \"variable.function\"], \"settings\": { \"foreground\": \"#dcdcaa\" } }, // {{dark.yellow}}\n      { \"scope\": \"support.function\", \"settings\": { \"foreground\": \"#dcdcaa\" } }, // {{dark.yellow}}\n      {\n        \"scope\": [\"entity.name.class\", \"entity.name.type\", \"entity.other.inherited-class\", \"support.class\", \"support.type\"],\n        \"settings\": { \"foreground\": \"#4ec9b0\" },\n      }, // {{dark.cyan}}\n      { \"scope\": [\"variable\", \"variable.other\", \"variable.parameter\"], \"settings\": { \"foreground\": \"#9cdcfe\" } }, // {{dark.lightBlue}}\n      { \"scope\": [\"variable.other.constant\", \"support.constant\"], \"settings\": { \"foreground\": \"#4fc1ff\" } }, // {{dark.brightBlue}}\n\n      // --- HTML / XML ---\n      { \"scope\": \"entity.name.tag\", \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": \"entity.other.attribute-name\", \"settings\": { \"foreground\": \"#9cdcfe\" } }, // {{dark.lightBlue}}\n\n      // --- CSS ---\n      { \"scope\": \"support.type.property-name\", \"settings\": { \"foreground\": \"#9cdcfe\" } }, // {{dark.lightBlue}}\n      { \"scope\": [\"support.constant.property-value\", \"constant.other.color\"], \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n      {\n        \"scope\": [\"entity.other.attribute-name.class\", \"entity.other.attribute-name.id\", \"entity.name.tag.css\"],\n        \"settings\": { \"foreground\": \"#d7ba7d\" },\n      }, // {{dark.gold}}\n\n      // --- Regex ---\n      { \"scope\": \"string.regexp\", \"settings\": { \"foreground\": \"#d98282\" } }, // {{dark.darkRed}}\n\n      // --- Markdown ---\n      { \"scope\": [\"markup.heading\", \"punctuation.definition.heading\"], \"settings\": { \"fontStyle\": \"bold\", \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": \"markup.bold\", \"settings\": { \"fontStyle\": \"bold\" } },\n      { \"scope\": \"markup.italic\", \"settings\": { \"fontStyle\": \"italic\" } },\n      { \"scope\": \"markup.underline.link\", \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n      { \"scope\": [\"markup.raw\", \"markup.raw.inline\"], \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n\n      // --- Diff ---\n      { \"scope\": \"markup.inserted\", \"settings\": { \"foreground\": \"#b5cea8\" } }, // {{dark.lightGreen}}\n      { \"scope\": \"markup.deleted\", \"settings\": { \"foreground\": \"#f67070\" } }, // {{dark.red}}\n      { \"scope\": \"markup.changed\", \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n\n      // --- Data formats ---\n      { \"scope\": [\"meta.mapping.key string\", \"support.type.property-name.json\"], \"settings\": { \"foreground\": \"#9cdcfe\" } }, // {{dark.lightBlue}}\n      { \"scope\": \"entity.name.tag.yaml\", \"settings\": { \"foreground\": \"#9cdcfe\" } }, // {{dark.lightBlue}}\n\n      // --- Invalid ---\n      { \"scope\": [\"invalid\", \"invalid.deprecated\"], \"settings\": { \"foreground\": \"#f67070\" } }, // {{dark.red}}\n\n      // --- Base theme overrides ---\n      // These rules exist only to stop the underlying VS Code \"Default High Contrast\"\n      // theme from leaking through. tokenColorCustomizations is a *merge*, not a\n      // replacement: any scope not named here keeps the base theme's color while sitting\n      // on our `editor.background`, which the base theme was never tuned against. The\n      // worst offender was `meta.diff.header` at #000080 on #0a0a0a — 1.24:1, invisible.\n      // Every scope below was measured under 7:1 in that state; the list is kept\n      // identical in the light theme so the two stay structurally in sync, and\n      // `editorThemes.spec.js` re-measures the base theme on every run so a VS Code\n      // upgrade that adds a new low-contrast scope fails the suite instead of shipping.\n      { \"scope\": [\"meta.diff.header\", \"meta.diff.header.from-file\", \"meta.diff.header.to-file\"], \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": [\"constant.character\", \"variable.language.this\"], \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      {\n        \"scope\": [\"keyword.operator.new\", \"keyword.operator.expression\", \"keyword.operator.cast\"],\n        \"settings\": { \"foreground\": \"#5ca0d7\" },\n      }, // {{dark.blue}}\n      {\n        \"scope\": [\"source.cpp keyword.operator.new\", \"source.cpp keyword.operator.delete\", \"keyword.other.using\"],\n        \"settings\": { \"foreground\": \"#5ca0d7\" },\n      }, // {{dark.blue}}\n      { \"scope\": \"token.info-token\", \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": \"meta.preprocessor\", \"settings\": { \"foreground\": \"#c586c0\" } }, // {{dark.purple}}\n      { \"scope\": \"punctuation.definition.tag\", \"settings\": { \"foreground\": \"#e8e8e8\" } }, // {{dark.foreground}}\n      {\n        \"scope\": [\n          \"punctuation.definition.template-expression.begin\",\n          \"punctuation.definition.template-expression.end\",\n          \"punctuation.section.embedded\",\n        ],\n        \"settings\": { \"foreground\": \"#d7ba7d\" },\n      }, // {{dark.gold}}\n      { \"scope\": \"token.warn-token\", \"settings\": { \"foreground\": \"#dcdcaa\" } }, // {{dark.yellow}}\n      { \"scope\": \"token.error-token\", \"settings\": { \"foreground\": \"#f67070\" } }, // {{dark.red}}\n      { \"scope\": \"constant.regexp\", \"settings\": { \"foreground\": \"#d98282\" } }, // {{dark.darkRed}}\n      {\n        \"scope\": [\n          \"punctuation.definition.group.regexp\",\n          \"punctuation.definition.group.assertion.regexp\",\n          \"punctuation.definition.character-class.regexp\",\n          \"keyword.operator.or.regexp\",\n          \"keyword.control.anchor.regexp\",\n          \"punctuation.character.set.begin.regexp\",\n          \"punctuation.character.set.end.regexp\",\n          \"keyword.operator.negation.regexp\",\n          \"support.other.parenthesis.regexp\",\n        ],\n        \"settings\": { \"foreground\": \"#d98282\" },\n      }, // {{dark.darkRed}}\n      {\n        \"scope\": [\"variable.other.enummember\", \"keyword.operator.plus.exponent\", \"keyword.operator.minus.exponent\"],\n        \"settings\": { \"foreground\": \"#b5cea8\" },\n      }, // {{dark.lightGreen}}\n      { \"scope\": [\"constant.sha.git-rebase\", \"keyword.other.unit\", \"meta.preprocessor.numeric\"], \"settings\": { \"foreground\": \"#b5cea8\" } }, // {{dark.lightGreen}}\n      { \"scope\": \"meta.preprocessor.string\", \"settings\": { \"foreground\": \"#ce9178\" } }, // {{dark.orange}}\n      {\n        \"scope\": [\n          \"entity.name.namespace\",\n          \"entity.other.attribute\",\n          \"entity.name.scope-resolution\",\n          \"meta.type.cast.expr\",\n          \"meta.type.new.expr\",\n          \"support.constant.math\",\n        ],\n        \"settings\": { \"foreground\": \"#4ec9b0\" },\n      }, // {{dark.cyan}}\n\n      // TextMate resolves the *most specific* selector, so the base theme's four-segment\n      // `storage.type.primitive.java` outranks our two-segment `storage.type` and the\n      // language-specific variants below all have to be named explicitly to be reclaimed.\n      {\n        \"scope\": [\n          \"storage.type.numeric.go\",\n          \"storage.type.byte.go\",\n          \"storage.type.boolean.go\",\n          \"storage.type.string.go\",\n          \"storage.type.uintptr.go\",\n          \"storage.type.error.go\",\n          \"storage.type.rune.go\",\n          \"storage.type.cs\",\n          \"storage.type.generic.cs\",\n          \"storage.type.modifier.cs\",\n          \"storage.type.variable.cs\",\n          \"storage.type.annotation.java\",\n          \"storage.type.generic.java\",\n          \"storage.type.java\",\n          \"storage.type.object.array.java\",\n          \"storage.type.primitive.array.java\",\n          \"storage.type.primitive.java\",\n          \"storage.type.token.java\",\n          \"storage.type.groovy\",\n          \"storage.type.annotation.groovy\",\n          \"storage.type.parameters.groovy\",\n          \"storage.type.generic.groovy\",\n          \"storage.type.object.array.groovy\",\n          \"storage.type.primitive.array.groovy\",\n          \"storage.type.primitive.groovy\",\n        ],\n        \"settings\": { \"foreground\": \"#5ca0d7\" },\n      }, // {{dark.blue}}\n      { \"scope\": [\"keyword.other.directive.using\", \"keyword.other.operator\"], \"settings\": { \"foreground\": \"#5ca0d7\" } }, // {{dark.blue}}\n      { \"scope\": [\"support.constant.dom\", \"support.constant.json\"], \"settings\": { \"foreground\": \"#4fc1ff\" } }, // {{dark.brightBlue}}\n      {\n        \"scope\": [\n          \"punctuation.separator.namespace.ruby\",\n          \"entity.name.operator\",\n          \"keyword.operator.sizeof\",\n          \"keyword.operator.logical.python\",\n        ],\n        \"settings\": { \"foreground\": \"#e8e8e8\" },\n      }, // {{dark.foreground}}\n    ],\n  },\n}\n",
}
