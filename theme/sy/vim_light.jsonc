  "sourceText": "{\n  // Shared Sy palette. Regenerate COLOR_MAP markers with make format_build_include.\n  \"name\": \"Sy Light\", // {{light.themeName}}\n  \"background\": \"#f8f8f8\", // {{light.background}}\n  \"foreground\": \"#1e1e1e\", // {{light.foreground}}\n  \"surface\": \"#ececec\", // {{light.surface}}\n  \"muted\": \"#5a5a5a\", // {{light.textDisabled}}\n  \"border\": \"#262626\", // {{light.brightGray}}\n  \"selection\": \"#96c6fa\", // {{light.selection}}\n  \"activeLine\": \"#cfe0f7\", // {{light.activeLine}}\n  \"match\": \"#ffbe3d\", // {{light.matchHighlight}}\n  \"accent\": \"#0252ad\", // {{light.linkBlue}}\n  \"comment\": \"#004a15\", // {{light.green}}\n  \"string\": \"#a12626\", // {{light.brightRed}}\n  \"number\": \"#03623a\", // {{light.darkGreen}}\n  \"keyword\": \"#0033b3\", // {{light.blue}}\n  \"flow\": \"#8700c1\", // {{light.brightPurple}}\n  \"function\": \"#6a5100\", // {{light.brown}}\n  \"type\": \"#145e5e\", // {{light.brightCyan}}\n  \"variable\": \"#001080\", // {{light.darkBlue}}\n  \"constant\": \"#00416f\", // {{light.cyan}}\n  \"tag\": \"#9b2c2c\", // {{light.darkRed}}\n  \"special\": \"#734e06\", // {{light.gold}}\n  \"error\": \"#840000\", // {{light.red}}\n  \"warning\": \"#6a5100\", // {{light.brown}}\n}\n",
