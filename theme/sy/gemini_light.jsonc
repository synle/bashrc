/*
Sy light native template. Colors are generated from _palette_light.jsonc.
Edit marker roles, then run make format_build_include; do not edit generated literals.
*/
{
  "name": "Sy Light", // {{light.themeName}}
  "type": "custom",
  "DarkGray": "#262626", // {{light.brightGray}}
  // Native focus fallback: ui.focus is rejected by Gemini 0.64 settings validation.
  "AccentGreen": "#0033b3", // {{light.blue}}
  "text": {
    "primary": "#1e1e1e", // {{light.foreground}}
    "secondary": "#3f3f3f", // {{light.textSecondary}}
    "link": "#0252ad", // {{light.linkBlue}}
    "accent": "#0033b3", // {{light.blue}}
    "response": "#1e1e1e", // {{light.foreground}}
  },
  "background": {
    "diff": {
      "added": "#dfe7e1", // {{light.diffAddedBackground}}
      "removed": "#ecdfdf", // {{light.diffRemovedBackground}}
    },
    "primary": "#f8f8f8", // {{light.background}}
  },

  "status": {
    "error": "#840000", // {{light.red}}
    "success": "#004a15", // {{light.green}}
    "warning": "#775502", // {{light.yellow}}
  },
  "ui": {
    "comment": "#004a15", // {{light.green}}
    "symbol": "#1e1e1e", // {{light.foreground}}
    "gradient": [
      "#0033b3", // {{light.blue}}
      "#00416f", // {{light.cyan}}
      "#6c0099", // {{light.purple}}
    ],
  },
}
