{
  "app": "sublime",
  "appearance": "dark",
  "captureStatus": "captured",
  "kind": "native-jsonc",
  "source": {
    "kind": "local-source",
    "path": "software/scripts/advanced/sublime-text-color-dark.jsonc",
    "sha256": "555a7de81302aa3fca69188bb02f5410a4d58bbbdbfd0923d86a593fa818ca99",
    "revision": "f628baa5af88c5684725c94a1ac85cc59f2f4476",
  },
  "definition": {
    "variables": {
      "bg": "#0a0a0a",
      "surface": "#161616",
      "fg": "#e8e8e8",
      "fg_dim": "#8f8f8f",
      "caret": "#5ca0d7",
      "accent": "#5ca0d7",
      "selection": "#1b3c5e",
      "line_highlight": "#1f2a38",
      "word_highlight": "#2b2b2b",
      "match": "#5c4300",
      "guide": "#464646",
      "guide_active": "#6e6e6e",
      "border": "#6e6e6e",
      "gutter_fg": "#8f8f8f",
      "comment": "#76a762",
      "string": "#ce9178",
      "escape": "#d7ba7d",
      "number": "#b5cea8",
      "keyword": "#5ca0d7",
      "flow": "#c586c0",
      "function": "#dcdcaa",
      "type": "#4ec9b0",
      "variable": "#9cdcfe",
      "constant": "#4fc1ff",
      "tag": "#5ca0d7",
      "property": "#9cdcfe",
      "regexp": "#d98282",
      "link": "#ce9178",
      "added": "#76a762",
      "modified": "#dcdcaa",
      "deleted": "#f67070",
      "invalid": "#f67070",
    },
    "globals": {
      "background": "var(bg)",
      "foreground": "var(fg)",
      "caret": "var(caret)",
      "block_caret": "var(caret)",
      "invisibles": "var(guide)",
      "gutter": "var(bg)",
      "gutter_foreground": "var(gutter_fg)",
      "gutter_foreground_highlight": "var(fg)",
      "accent": "var(accent)",
      "minimap_border": "var(accent)",
      "misspelling": "var(deleted)",
      "selection": "var(selection)",
      "selection_foreground": "var(fg)",
      "selection_border": "var(accent)",
      "selection_border_width": "1",
      "selection_corner_style": "round",
      "inactive_selection": "var(word_highlight)",
      "inactive_selection_foreground": "var(fg)",
      "line_highlight": "var(line_highlight)",
      "highlight": "var(word_highlight)",
      "find_highlight": "var(match)",
      "find_highlight_foreground": "#0a0a0a",
      "scroll_highlight": "var(match)",
      "scroll_selected_highlight": "var(accent)",
      "guide": "var(guide)",
      "stack_guide": "var(guide)",
      "active_guide": "var(guide_active)",
      "rulers": "var(guide)",
      "brackets_foreground": "var(function)",
      "brackets_options": "underline",
      "bracket_contents_foreground": "var(function)",
      "bracket_contents_options": "underline",
      "tags_foreground": "var(tag)",
      "tags_options": "underline",
      "line_diff_width": "3",
      "line_diff_added": "var(added)",
      "line_diff_modified": "var(modified)",
      "line_diff_deleted": "var(deleted)",
      "fold_marker": "var(accent)",
      "shadow": "#00000066",
      "shadow_width": "6",
      "block_caret_border": "#00000000",
      "line_padding_top": "1",
      "line_padding_bottom": "1",
      "popup_css": "html { background-color: #161616; color: #e8e8e8; border: 1px solid #6e6e6e; } a { color: #5ca0d7; }",
    },
    "rules": [
      {
        "scope": "comment, punctuation.definition.comment",
        "foreground": "var(comment)",
      },
      {
        "scope": "string, string.quoted",
        "foreground": "var(string)",
      },
      {
        "scope": "constant.character.escape",
        "foreground": "var(escape)",
      },
      {
        "scope": "constant.numeric",
        "foreground": "var(number)",
      },
      {
        "scope": "constant.language",
        "foreground": "var(keyword)",
      },
      {
        "scope": "keyword, keyword.control, keyword.operator.word",
        "foreground": "var(keyword)",
      },
      {
        "scope": "keyword.operator, punctuation.accessor",
        "foreground": "var(fg)",
      },
      {
        "scope": "storage, storage.type, storage.modifier",
        "foreground": "var(keyword)",
      },
      {
        "scope": "keyword.control.import, keyword.control.export, keyword.control.flow",
        "foreground": "var(flow)",
      },
      {
        "scope": "entity.name.function, meta.function-call, variable.function",
        "foreground": "var(function)",
      },
      {
        "scope": "support.function",
        "foreground": "var(function)",
      },
      {
        "scope": "entity.name.class, entity.name.type, entity.other.inherited-class, support.class, support.type",
        "foreground": "var(type)",
      },
      {
        "scope": "variable, variable.other, variable.parameter",
        "foreground": "var(variable)",
      },
      {
        "scope": "variable.other.constant, support.constant",
        "foreground": "var(constant)",
      },
      {
        "scope": "entity.name.tag",
        "foreground": "var(tag)",
      },
      {
        "scope": "entity.other.attribute-name",
        "foreground": "var(property)",
      },
      {
        "scope": "support.type.property-name",
        "foreground": "var(property)",
      },
      {
        "scope": "support.constant.property-value, constant.other.color",
        "foreground": "var(string)",
      },
      {
        "scope": "entity.other.attribute-name.class, entity.other.attribute-name.id, entity.name.tag.css",
        "foreground": "var(escape)",
      },
      {
        "scope": "string.regexp",
        "foreground": "var(regexp)",
      },
      {
        "scope": "markup.heading, punctuation.definition.heading",
        "foreground": "var(keyword)",
        "font_style": "bold",
      },
      {
        "scope": "markup.bold",
        "font_style": "bold",
      },
      {
        "scope": "markup.italic",
        "font_style": "italic",
      },
      {
        "scope": "markup.underline.link",
        "foreground": "var(link)",
      },
      {
        "scope": "markup.raw, markup.raw.inline",
        "foreground": "var(link)",
      },
      {
        "scope": "markup.inserted",
        "foreground": "var(number)",
      },
      {
        "scope": "markup.deleted",
        "foreground": "var(deleted)",
      },
      {
        "scope": "markup.changed",
        "foreground": "var(modified)",
      },
      {
        "scope": "meta.mapping.key string, support.type.property-name.json",
        "foreground": "var(variable)",
      },
      {
        "scope": "entity.name.tag.yaml",
        "foreground": "var(variable)",
      },
      {
        "scope": "invalid, invalid.deprecated",
        "foreground": "var(invalid)",
      },
    ],
  },
  "sourceText": "{\n  // High Contrast Dark - modeled after VS Code Default High Contrast\n  \"variables\": {\n    // Surfaces\n    \"bg\": \"#0a0a0a\", // {{dark.background}}\n    \"surface\": \"#161616\", // {{dark.surface}}\n    \"fg\": \"#e8e8e8\", // {{dark.foreground}}\n    \"fg_dim\": \"#8f8f8f\", // {{dark.textDisabled}}\n    \"caret\": \"#5ca0d7\", // {{dark.cursorColor}}\n    \"accent\": \"#5ca0d7\", // {{dark.blue}}\n\n    // Fills\n    \"selection\": \"#1b3c5e\", // {{dark.selection}}\n    \"line_highlight\": \"#1f2a38\", // {{dark.activeLine}}\n    \"word_highlight\": \"#2b2b2b\", // {{dark.gray}}\n    \"match\": \"#5c4300\", // {{dark.matchHighlight}}\n\n    // Strokes\n    \"guide\": \"#464646\", // {{dark.guide}}\n    \"guide_active\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"border\": \"#6e6e6e\", // {{dark.brightGray}}\n    \"gutter_fg\": \"#8f8f8f\", // {{dark.textDisabled}}\n\n    // Syntax\n    \"comment\": \"#76a762\", // {{dark.green}}\n    \"string\": \"#ce9178\", // {{dark.orange}}\n    \"escape\": \"#d7ba7d\", // {{dark.gold}}\n    \"number\": \"#b5cea8\", // {{dark.lightGreen}}\n    \"keyword\": \"#5ca0d7\", // {{dark.blue}}\n    \"flow\": \"#c586c0\", // {{dark.purple}}\n    \"function\": \"#dcdcaa\", // {{dark.yellow}}\n    \"type\": \"#4ec9b0\", // {{dark.cyan}}\n    \"variable\": \"#9cdcfe\", // {{dark.lightBlue}}\n    \"constant\": \"#4fc1ff\", // {{dark.brightBlue}}\n    \"tag\": \"#5ca0d7\", // {{dark.blue}}\n    \"property\": \"#9cdcfe\", // {{dark.lightBlue}}\n    \"regexp\": \"#d98282\", // {{dark.darkRed}}\n    \"link\": \"#ce9178\", // {{dark.orange}}\n    \"added\": \"#76a762\", // {{dark.green}}\n    \"modified\": \"#dcdcaa\", // {{dark.yellow}}\n    \"deleted\": \"#f67070\", // {{dark.red}}\n    \"invalid\": \"#f67070\", // {{dark.red}}\n  },\n  \"globals\": {\n    // Editor chrome\n    \"background\": \"var(bg)\",\n    \"foreground\": \"var(fg)\",\n    \"caret\": \"var(caret)\",\n    \"block_caret\": \"var(caret)\",\n    \"invisibles\": \"var(guide)\",\n    \"gutter\": \"var(bg)\",\n    \"gutter_foreground\": \"var(gutter_fg)\",\n    \"gutter_foreground_highlight\": \"var(fg)\",\n    \"accent\": \"var(accent)\",\n    \"minimap_border\": \"var(accent)\",\n    \"misspelling\": \"var(deleted)\",\n\n    // Selection & highlight\n    \"selection\": \"var(selection)\",\n    \"selection_foreground\": \"var(fg)\",\n    \"selection_border\": \"var(accent)\",\n    \"selection_border_width\": \"1\",\n    \"selection_corner_style\": \"round\",\n    \"inactive_selection\": \"var(word_highlight)\",\n    \"inactive_selection_foreground\": \"var(fg)\",\n    \"line_highlight\": \"var(line_highlight)\",\n    \"highlight\": \"var(word_highlight)\",\n    \"find_highlight\": \"var(match)\",\n    \"find_highlight_foreground\": \"#0a0a0a\", // {{dark.background}}\n    \"scroll_highlight\": \"var(match)\",\n    \"scroll_selected_highlight\": \"var(accent)\",\n\n    // Guides\n    \"guide\": \"var(guide)\",\n    \"stack_guide\": \"var(guide)\",\n    \"active_guide\": \"var(guide_active)\",\n    \"rulers\": \"var(guide)\",\n\n    // Brackets & tags\n    \"brackets_foreground\": \"var(function)\",\n    \"brackets_options\": \"underline\",\n    \"bracket_contents_foreground\": \"var(function)\",\n    \"bracket_contents_options\": \"underline\",\n    \"tags_foreground\": \"var(tag)\",\n    \"tags_options\": \"underline\",\n\n    // Git diff\n    \"line_diff_width\": \"3\",\n    \"line_diff_added\": \"var(added)\",\n    \"line_diff_modified\": \"var(modified)\",\n    \"line_diff_deleted\": \"var(deleted)\",\n\n    // Fold markers & shadow\n    \"fold_marker\": \"var(accent)\",\n    \"shadow\": \"#00000066\", // {{dark.black_alpha40}}\n    \"shadow_width\": \"6\",\n\n    // Block caret border — a color, not a width. Fully transparent keeps the border invisible.\n    \"block_caret_border\": \"#00000000\",\n\n    // Padding\n    \"line_padding_top\": \"1\",\n    \"line_padding_bottom\": \"1\",\n\n    \"popup_css\": \"html { background-color: #161616; color: #e8e8e8; border: 1px solid #6e6e6e; } a { color: #5ca0d7; }\",\n  },\n  \"rules\": [\n    // Syntax\n    { \"scope\": \"comment, punctuation.definition.comment\", \"foreground\": \"var(comment)\" },\n    { \"scope\": \"string, string.quoted\", \"foreground\": \"var(string)\" },\n    { \"scope\": \"constant.character.escape\", \"foreground\": \"var(escape)\" },\n    { \"scope\": \"constant.numeric\", \"foreground\": \"var(number)\" },\n    { \"scope\": \"constant.language\", \"foreground\": \"var(keyword)\" },\n    { \"scope\": \"keyword, keyword.control, keyword.operator.word\", \"foreground\": \"var(keyword)\" },\n    { \"scope\": \"keyword.operator, punctuation.accessor\", \"foreground\": \"var(fg)\" },\n    { \"scope\": \"storage, storage.type, storage.modifier\", \"foreground\": \"var(keyword)\" },\n    { \"scope\": \"keyword.control.import, keyword.control.export, keyword.control.flow\", \"foreground\": \"var(flow)\" },\n\n    // Identifiers\n    { \"scope\": \"entity.name.function, meta.function-call, variable.function\", \"foreground\": \"var(function)\" },\n    { \"scope\": \"support.function\", \"foreground\": \"var(function)\" },\n    {\n      \"scope\": \"entity.name.class, entity.name.type, entity.other.inherited-class, support.class, support.type\",\n      \"foreground\": \"var(type)\",\n    },\n    { \"scope\": \"variable, variable.other, variable.parameter\", \"foreground\": \"var(variable)\" },\n    { \"scope\": \"variable.other.constant, support.constant\", \"foreground\": \"var(constant)\" },\n\n    // HTML / XML\n    { \"scope\": \"entity.name.tag\", \"foreground\": \"var(tag)\" },\n    { \"scope\": \"entity.other.attribute-name\", \"foreground\": \"var(property)\" },\n\n    // CSS\n    { \"scope\": \"support.type.property-name\", \"foreground\": \"var(property)\" },\n    { \"scope\": \"support.constant.property-value, constant.other.color\", \"foreground\": \"var(string)\" },\n    { \"scope\": \"entity.other.attribute-name.class, entity.other.attribute-name.id, entity.name.tag.css\", \"foreground\": \"var(escape)\" },\n\n    // Regex\n    { \"scope\": \"string.regexp\", \"foreground\": \"var(regexp)\" },\n\n    // Markdown\n    { \"scope\": \"markup.heading, punctuation.definition.heading\", \"foreground\": \"var(keyword)\", \"font_style\": \"bold\" },\n    { \"scope\": \"markup.bold\", \"font_style\": \"bold\" },\n    { \"scope\": \"markup.italic\", \"font_style\": \"italic\" },\n    { \"scope\": \"markup.underline.link\", \"foreground\": \"var(link)\" },\n    { \"scope\": \"markup.raw, markup.raw.inline\", \"foreground\": \"var(link)\" },\n\n    // Diff\n    { \"scope\": \"markup.inserted\", \"foreground\": \"var(number)\" },\n    { \"scope\": \"markup.deleted\", \"foreground\": \"var(deleted)\" },\n    { \"scope\": \"markup.changed\", \"foreground\": \"var(modified)\" },\n\n    // Data formats\n    { \"scope\": \"meta.mapping.key string, support.type.property-name.json\", \"foreground\": \"var(variable)\" },\n    { \"scope\": \"entity.name.tag.yaml\", \"foreground\": \"var(variable)\" },\n\n    // Invalid\n    { \"scope\": \"invalid, invalid.deprecated\", \"foreground\": \"var(invalid)\" },\n  ],\n}\n",
}
