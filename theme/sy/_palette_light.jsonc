/*
Sy light palette foundation. Existing base hues plus semantic color recipes.
Variants and template literals are rendered by software/tools/build-include.js.
*/
{
  "themeName": "Sy Light",
  "background": "#f8f8f8",
  "surface": "#ececec",
  "activeLine": "#cfe0f7",
  "matchHighlight": "#ffbe3d",
  "gray": "#cacaca",
  "pressed": "#b0b0b0",
  "selection": "#96c6fa",
  "brightGray": "#262626",
  "guide": "#a4a4a4",
  "foreground": "#1e1e1e",
  "textDisabled": "#5a5a5a",
  "cursorColor": "#0451a5",
  "black": "#000000",
  "blue": "#0033b3",
  "brightBlack": "#4a4a4a",
  "brightBlue": "#0051ae",
  "brightCyan": "#145e5e",
  "brightGreen": "#106145",
  "brightPurple": "#8700c1",
  "brightRed": "#a12626",
  "brightWhite": "#8b8b8b",
  "brightYellow": "#7f6000",
  "cyan": "#00416f",
  "green": "#004a15",
  "purple": "#6c0099",
  "red": "#840000",
  "white": "#6d6d6d",
  "yellow": "#775502",
  "lightBlue": "#245690",
  "lightGreen": "#05623b",
  "orange": "#8a3f20",
  "gold": "#734e06",
  "darkBlue": "#001080",
  "linkBlue": "#0252ad",
  "darkGreen": "#03623a",
  "brown": "#6a5100",
  "darkRed": "#9b2c2c",
  "textSecondary": {
    "from": "foreground",
    "over": "brightBlack",
    "alpha": 0.25,
  },
  "terminalBlack": {
    "ref": "black",
  },
  "selectionSyntax": {
    "from": "selection",
    "over": "background",
    "alpha": 0.75,
  },
  "matchHighlightSyntax": {
    "from": "matchHighlight",
    "over": "background",
    "alpha": 0.5,
  },
  "activeMatchSyntax": {
    "from": "blue",
    "over": "background",
    "alpha": 0.1,
  },
  "diffAddedBackground": {
    "from": "green",
    "over": "background",
    "alpha": 0.1,
  },
  "diffRemovedBackground": {
    "from": "red",
    "over": "background",
    "alpha": 0.1,
  },
  "diffAddedWordBackground": {
    "from": "green",
    "over": "background",
    "alpha": 0.2,
  },
  "diffRemovedWordBackground": {
    "from": "red",
    "over": "background",
    "alpha": 0.2,
  },
  "diffAddedMutedBackground": { "from": "green", "over": "background", "alpha": 0.05 },
  "diffRemovedMutedBackground": { "from": "red", "over": "background", "alpha": 0.05 },
  "warningBackground": {
    "from": "yellow",
    "over": "background",
    "alpha": 0.1,
  },
}
