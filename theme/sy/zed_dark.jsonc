  "sourceText": "{\n  // High Contrast Dark - modeled after VS Code Default High Contrast.\n  // Values are generated: every `// {{dark.key}}` marker is rewritten from COLOR_MAP in\n  // software/tools/build-include.js by `make format_build_include`. Edit the marker, not the hex.\n  //\n  // Layering rules (see the COLOR_MAP JSDoc for the FILL / STROKE / FOREGROUND split):\n  // - editor surfaces stay on `background`; chrome (title bar, tabs, panels, status bar) sits on\n  //   `surface` so the editor visually pops out of the frame.\n  // - every `*.background` is an `_alpha10` tint of its matching foreground, never the solid color -\n  //   Zed paints text ON these, so a solid fill makes the text invisible.\n  // - interactive fills ladder up `surface` -> `gray` (hover) -> `pressed` (active) -> `selection`;\n  //   `activeLine` is editor-only and must not be reused for chrome states.\n  \"$schema\": \"https://zed.dev/schema/themes/v0.2.0.json\",\n  \"name\": \"Sy Dark\", // {{dark.themeName}}\n  \"author\": \"synle\",\n  \"themes\": [\n    {\n      \"name\": \"Sy Dark\", // {{dark.themeName}}\n      \"appearance\": \"dark\",\n      \"style\": {\n        // --- Editor Chrome ---\n        \"background.appearance\": \"opaque\",\n        \"background\": \"#161616\", // {{dark.surface}}\n        \"editor.background\": \"#0a0a0a\", // {{dark.background}}\n        \"editor.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n        \"editor.gutter.background\": \"#0a0a0a\", // {{dark.background}}\n        \"editor.subheader.background\": \"#161616\", // {{dark.surface}}\n        \"editor.active_line.background\": \"#1f2a38\", // {{dark.activeLine}}\n        \"editor.highlighted_line.background\": \"#1f2a38\", // {{dark.activeLine}}\n        \"editor.line_number\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"editor.active_line_number\": \"#5ca0d7\", // {{dark.blue}}\n        \"editor.hover_line_number\": \"#e8e8e8\", // {{dark.foreground}}\n        \"editor.invisible\": \"#464646\", // {{dark.guide}}\n        \"editor.wrap_guide\": \"#464646\", // {{dark.guide}}\n        \"editor.active_wrap_guide\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"editor.indent_guide\": \"#464646\", // {{dark.guide}}\n        \"editor.indent_guide_active\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"editor.document_highlight.read_background\": \"#5ca0d733\", // {{dark.blue_alpha20}}\n        \"editor.document_highlight.write_background\": \"#ce917833\", // {{dark.orange_alpha20}}\n        \"editor.document_highlight.bracket_background\": \"#6e6e6e66\", // {{dark.brightGray_alpha40}}\n\n        // --- Text ---\n        \"text\": \"#e8e8e8\", // {{dark.foreground}}\n        \"text.muted\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"text.placeholder\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"text.disabled\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"text.accent\": \"#5ca0d7\", // {{dark.blue}}\n\n        // --- Icons ---\n        \"icon\": \"#e8e8e8\", // {{dark.foreground}}\n        \"icon.muted\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"icon.disabled\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"icon.placeholder\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"icon.accent\": \"#5ca0d7\", // {{dark.blue}}\n\n        // --- UI Elements ---\n        // Disabled reuses the base fill (no state change) so it cannot be mistaken for hover.\n        \"element.background\": \"#161616\", // {{dark.surface}}\n        \"element.hover\": \"#2b2b2b\", // {{dark.gray}}\n        \"element.active\": \"#3d3d3d\", // {{dark.pressed}}\n        \"element.selected\": \"#1b3c5e\", // {{dark.selection}}\n        \"element.disabled\": \"#161616\", // {{dark.surface}}\n        \"ghost_element.background\": \"#0a0a0a00\", // {{dark.background_alpha0}}\n        \"ghost_element.hover\": \"#2b2b2b\", // {{dark.gray}}\n        \"ghost_element.active\": \"#3d3d3d\", // {{dark.pressed}}\n        \"ghost_element.selected\": \"#1b3c5e\", // {{dark.selection}}\n        \"ghost_element.disabled\": \"#161616\", // {{dark.surface}}\n        \"drop_target.background\": \"#5ca0d733\", // {{dark.blue_alpha20}}\n\n        // --- Surface / Panel ---\n        \"surface.background\": \"#161616\", // {{dark.surface}}\n        \"elevated_surface.background\": \"#161616\", // {{dark.surface}}\n        \"panel.background\": \"#161616\", // {{dark.surface}}\n        \"panel.focused_border\": \"#5ca0d7\", // {{dark.blue}}\n        \"panel.indent_guide\": \"#464646\", // {{dark.guide}}\n        \"panel.indent_guide_active\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"panel.indent_guide_hover\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"pane.focused_border\": \"#5ca0d7\", // {{dark.blue}}\n        \"pane_group.border\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"title_bar.background\": \"#161616\", // {{dark.surface}}\n        \"title_bar.inactive_background\": \"#0a0a0a\", // {{dark.background}}\n        \"toolbar.background\": \"#161616\", // {{dark.surface}}\n        \"tab_bar.background\": \"#161616\", // {{dark.surface}}\n        \"tab.inactive_background\": \"#161616\", // {{dark.surface}}\n        \"tab.active_background\": \"#0a0a0a\", // {{dark.background}}\n        \"search.match_background\": \"#5c4300\", // {{dark.matchHighlight}}\n        \"search.active_match_background\": \"#5ca0d766\", // {{dark.blue_alpha40}}\n        \"status_bar.background\": \"#161616\", // {{dark.surface}}\n        \"scrollbar.thumb.background\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"scrollbar.thumb.hover_background\": \"#e8e8e8\", // {{dark.foreground}}\n        \"scrollbar.thumb.border\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"scrollbar.track.background\": \"#0a0a0a\", // {{dark.background}}\n        \"scrollbar.track.border\": \"#0a0a0a\", // {{dark.background}}\n\n        // --- Borders ---\n        \"border\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"border.variant\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"border.focused\": \"#5ca0d7\", // {{dark.blue}}\n        \"border.selected\": \"#5ca0d7\", // {{dark.blue}}\n        \"border.transparent\": \"#0a0a0a00\", // {{dark.background_alpha0}}\n        \"border.disabled\": \"#464646\", // {{dark.guide}}\n\n        // --- Links ---\n        \"link_text.hover\": \"#4fc1ff\", // {{dark.linkBlue}}\n\n        // --- Conflict / Diff ---\n        \"conflict\": \"#ce9178\", // {{dark.orange}}\n        \"conflict.background\": \"#ce91781a\", // {{dark.orange_alpha10}}\n        \"conflict.border\": \"#ce9178\", // {{dark.orange}}\n        \"created\": \"#76a762\", // {{dark.green}}\n        \"created.background\": \"#76a7621a\", // {{dark.green_alpha10}}\n        \"created.border\": \"#76a762\", // {{dark.green}}\n        \"deleted\": \"#f67070\", // {{dark.red}}\n        \"deleted.background\": \"#f670701a\", // {{dark.red_alpha10}}\n        \"deleted.border\": \"#f67070\", // {{dark.red}}\n        \"modified\": \"#dcdcaa\", // {{dark.yellow}}\n        \"modified.background\": \"#dcdcaa1a\", // {{dark.yellow_alpha10}}\n        \"modified.border\": \"#dcdcaa\", // {{dark.yellow}}\n        \"renamed\": \"#5ca0d7\", // {{dark.blue}}\n        \"renamed.background\": \"#5ca0d71a\", // {{dark.blue_alpha10}}\n        \"renamed.border\": \"#5ca0d7\", // {{dark.blue}}\n\n        // --- Version Control ---\n        \"version_control.added\": \"#76a762\", // {{dark.green}}\n        \"version_control.modified\": \"#dcdcaa\", // {{dark.yellow}}\n        \"version_control.deleted\": \"#f67070\", // {{dark.red}}\n        \"version_control.word_added\": \"#76a76233\", // {{dark.green_alpha20}}\n        \"version_control.word_deleted\": \"#f6707033\", // {{dark.red_alpha20}}\n        \"version_control.conflict_marker.ours\": \"#76a76233\", // {{dark.green_alpha20}}\n        \"version_control.conflict_marker.theirs\": \"#5ca0d733\", // {{dark.blue_alpha20}}\n\n        // --- Diagnostics ---\n        \"error\": \"#f67070\", // {{dark.red}}\n        \"error.background\": \"#f670701a\", // {{dark.red_alpha10}}\n        \"error.border\": \"#f67070\", // {{dark.red}}\n        \"warning\": \"#dcdcaa\", // {{dark.yellow}}\n        \"warning.background\": \"#dcdcaa1a\", // {{dark.yellow_alpha10}}\n        \"warning.border\": \"#dcdcaa\", // {{dark.yellow}}\n        \"info\": \"#5ca0d7\", // {{dark.blue}}\n        \"info.background\": \"#5ca0d71a\", // {{dark.blue_alpha10}}\n        \"info.border\": \"#5ca0d7\", // {{dark.blue}}\n        \"hint\": \"#4ec9b0\", // {{dark.cyan}}\n        \"hint.background\": \"#4ec9b01a\", // {{dark.cyan_alpha10}}\n        \"hint.border\": \"#4ec9b0\", // {{dark.cyan}}\n        \"success\": \"#76a762\", // {{dark.green}}\n        \"success.background\": \"#76a7621a\", // {{dark.green_alpha10}}\n        \"success.border\": \"#76a762\", // {{dark.green}}\n        \"predictive\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"predictive.background\": \"#8f8f8f1a\", // {{dark.textDisabled_alpha10}}\n        \"predictive.border\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"unreachable\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"unreachable.background\": \"#8f8f8f1a\", // {{dark.textDisabled_alpha10}}\n        \"unreachable.border\": \"#8f8f8f\", // {{dark.textDisabled}}\n        \"hidden\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"hidden.background\": \"#a0a0a01a\", // {{dark.brightBlack_alpha10}}\n        \"hidden.border\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"ignored\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"ignored.background\": \"#a0a0a01a\", // {{dark.brightBlack_alpha10}}\n        \"ignored.border\": \"#6e6e6e\", // {{dark.brightGray}}\n\n        // --- Players (local cursor + selection; Zed reads selection from players[0], not selection.background) ---\n        \"players\": [\n          {\n            \"cursor\": \"#5ca0d7\", // {{dark.cursorColor}}\n            \"background\": \"#5ca0d7\", // {{dark.cursorColor}}\n            \"selection\": \"#1b3c5e\", // {{dark.selection}}\n          },\n        ],\n\n        // --- Accents (collaborator cursors, rainbow indent) — spaced around the hue wheel ---\n        \"accents\": [\n          \"#5ca0d7\", // {{dark.blue}}\n          \"#76a762\", // {{dark.green}}\n          \"#ce9178\", // {{dark.orange}}\n          \"#c586c0\", // {{dark.purple}}\n          \"#4ec9b0\", // {{dark.cyan}}\n          \"#dcdcaa\", // {{dark.yellow}}\n          \"#f67070\", // {{dark.red}}\n        ],\n\n        // --- Syntax ---\n        \"syntax\": {\n          \"attribute\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"boolean\": { \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"comment\": { \"color\": \"#76a762\" }, // {{dark.green}}\n          \"comment.doc\": { \"color\": \"#76a762\" }, // {{dark.green}}\n          \"constant\": { \"color\": \"#4fc1ff\" }, // {{dark.brightBlue}}\n          \"constructor\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n          \"diff.minus\": { \"color\": \"#f67070\" }, // {{dark.red}}\n          \"diff.plus\": { \"color\": \"#76a762\" }, // {{dark.green}}\n          \"embedded\": { \"color\": \"#ce9178\" }, // {{dark.orange}}\n          \"emphasis\": { \"font_style\": \"italic\", \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"emphasis.strong\": { \"font_weight\": 700, \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"enum\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n          \"function\": { \"color\": \"#dcdcaa\" }, // {{dark.yellow}}\n          \"function.builtin\": { \"color\": \"#dcdcaa\" }, // {{dark.yellow}}\n          \"hint\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n          \"keyword\": { \"font_weight\": 700, \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"label\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"link_text\": { \"color\": \"#ce9178\" }, // {{dark.orange}}\n          \"link_uri\": { \"color\": \"#4fc1ff\" }, // {{dark.linkBlue}}\n          \"namespace\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n          \"number\": { \"color\": \"#b5cea8\" }, // {{dark.lightGreen}}\n          \"operator\": { \"color\": \"#e8e8e8\" }, // {{dark.foreground}}\n          \"predictive\": { \"font_style\": \"italic\", \"color\": \"#8f8f8f\" }, // {{dark.textDisabled}}\n          \"preproc\": { \"color\": \"#c586c0\" }, // {{dark.purple}}\n          \"primary\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"property\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"punctuation\": { \"color\": \"#e8e8e8\" }, // {{dark.foreground}}\n          \"punctuation.bracket\": { \"color\": \"#e8e8e8\" }, // {{dark.foreground}}\n          \"punctuation.delimiter\": { \"color\": \"#e8e8e8\" }, // {{dark.foreground}}\n          \"punctuation.list_marker\": { \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"punctuation.markup\": { \"color\": \"#a0a0a0\" }, // {{dark.brightBlack}}\n          \"punctuation.special\": { \"color\": \"#d7ba7d\" }, // {{dark.gold}}\n          \"selector\": { \"color\": \"#d7ba7d\" }, // {{dark.gold}}\n          \"selector.pseudo\": { \"color\": \"#c586c0\" }, // {{dark.purple}}\n          \"string\": { \"color\": \"#ce9178\" }, // {{dark.orange}}\n          \"string.escape\": { \"color\": \"#d7ba7d\" }, // {{dark.gold}}\n          \"string.regex\": { \"color\": \"#d98282\" }, // {{dark.darkRed}}\n          \"string.special\": { \"color\": \"#d7ba7d\" }, // {{dark.gold}}\n          \"string.special.symbol\": { \"color\": \"#d7ba7d\" }, // {{dark.gold}}\n          \"tag\": { \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"text.literal\": { \"color\": \"#ce9178\" }, // {{dark.orange}}\n          \"title\": { \"font_weight\": 700, \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"type\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n          \"variable\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"variable.parameter\": { \"color\": \"#9cdcfe\" }, // {{dark.lightBlue}}\n          \"variable.special\": { \"color\": \"#5ca0d7\" }, // {{dark.blue}}\n          \"variant\": { \"color\": \"#4ec9b0\" }, // {{dark.cyan}}\n        },\n\n        // --- Terminal ---\n        // ANSI black is lifted to the stroke gray rather than #000000: the terminal background is\n        // #0a0a0a, so true black renders invisible and any CLI that dims with ANSI 30 disappears.\n        // The ramp still ascends (black < bright_black) so relative ordering is preserved.\n        // `dim_*` is the base hue at 60% over the terminal background — SGR 2 must read as a\n        // faded version of its base, so it is derived from the base rather than picked by hand.\n        \"terminal.background\": \"#0a0a0a\", // {{dark.background}}\n        \"terminal.ansi.background\": \"#0a0a0a\", // {{dark.background}}\n        \"terminal.foreground\": \"#e8e8e8\", // {{dark.foreground}}\n        \"terminal.bright_foreground\": \"#ffffff\", // {{dark.brightWhite}}\n        \"terminal.dim_foreground\": \"#cccccc\", // {{dark.white}}\n        \"terminal.ansi.black\": \"#6e6e6e\", // {{dark.brightGray}}\n        \"terminal.ansi.red\": \"#f67070\", // {{dark.red}}\n        \"terminal.ansi.green\": \"#76a762\", // {{dark.green}}\n        \"terminal.ansi.yellow\": \"#dcdcaa\", // {{dark.yellow}}\n        \"terminal.ansi.blue\": \"#5ca0d7\", // {{dark.blue}}\n        \"terminal.ansi.magenta\": \"#c586c0\", // {{dark.purple}}\n        \"terminal.ansi.cyan\": \"#4ec9b0\", // {{dark.cyan}}\n        \"terminal.ansi.white\": \"#cccccc\", // {{dark.white}}\n        \"terminal.ansi.bright_black\": \"#a0a0a0\", // {{dark.brightBlack}}\n        \"terminal.ansi.bright_red\": \"#ff6e6e\", // {{dark.brightRed}}\n        \"terminal.ansi.bright_green\": \"#69ff94\", // {{dark.brightGreen}}\n        \"terminal.ansi.bright_yellow\": \"#ffffa5\", // {{dark.brightYellow}}\n        \"terminal.ansi.bright_blue\": \"#4fc1ff\", // {{dark.brightBlue}}\n        \"terminal.ansi.bright_magenta\": \"#ff92df\", // {{dark.brightPurple}}\n        \"terminal.ansi.bright_cyan\": \"#a4ffff\", // {{dark.brightCyan}}\n        \"terminal.ansi.bright_white\": \"#ffffff\", // {{dark.brightWhite}}\n        \"terminal.ansi.dim_black\": \"#6e6e6e99\", // {{dark.brightGray_alpha60}}\n        \"terminal.ansi.dim_red\": \"#f6707099\", // {{dark.red_alpha60}}\n        \"terminal.ansi.dim_green\": \"#76a76299\", // {{dark.green_alpha60}}\n        \"terminal.ansi.dim_yellow\": \"#dcdcaa99\", // {{dark.yellow_alpha60}}\n        \"terminal.ansi.dim_blue\": \"#5ca0d799\", // {{dark.blue_alpha60}}\n        \"terminal.ansi.dim_magenta\": \"#c586c099\", // {{dark.purple_alpha60}}\n        \"terminal.ansi.dim_cyan\": \"#4ec9b099\", // {{dark.cyan_alpha60}}\n        \"terminal.ansi.dim_white\": \"#cccccc99\", // {{dark.white_alpha60}}\n      },\n    },\n  ],\n}\n",
}
