        "hint.background": "#4ec9b01a", // {{dark.cyan_alpha10}}
        "hint.border": "#4ec9b0", // {{dark.cyan}}
        "success": "#76a762", // {{dark.green}}
        "success.background": "#76a7621a", // {{dark.green_alpha10}}
        "success.border": "#76a762", // {{dark.green}}
        "predictive": "#b2b2b2", // {{dark.textSecondary}}
        "predictive.background": "#b2b2b21a", // {{dark.textSecondary_alpha10}}
        "predictive.border": "#b2b2b2", // {{dark.textSecondary}}
        "unreachable": "#8f8f8f", // {{dark.textDisabled}}
        "unreachable.background": "#8f8f8f1a", // {{dark.textDisabled_alpha10}}
        "unreachable.border": "#8f8f8f", // {{dark.textDisabled}}
        "hidden": "#a0a0a0", // {{dark.brightBlack}}
        "hidden.background": "#a0a0a01a", // {{dark.brightBlack_alpha10}}
        "hidden.border": "#6e6e6e", // {{dark.brightGray}}
        "ignored": "#a0a0a0", // {{dark.brightBlack}}
        "ignored.background": "#a0a0a01a", // {{dark.brightBlack_alpha10}}
        "ignored.border": "#6e6e6e", // {{dark.brightGray}}
        "players": [
          {
            "cursor": "#5ca0d7", // {{dark.cursorColor}}
            "background": "#5ca0d7", // {{dark.cursorColor}}
            "selection": "#173049", // {{dark.selectionSyntax}}
          },
          {
            "cursor": "#76a762", // {{dark.green}}
            "background": "#76a762", // {{dark.green}}
            "selection": "#76a7621a", // {{dark.green_alpha10}}
          },
          {
            "cursor": "#ce9178", // {{dark.orange}}
            "background": "#ce9178", // {{dark.orange}}
            "selection": "#ce91781a", // {{dark.orange_alpha10}}
          },
          {
            "cursor": "#c586c0", // {{dark.purple}}
            "background": "#c586c0", // {{dark.purple}}
            "selection": "#c586c01a", // {{dark.purple_alpha10}}
          },
          {
            "cursor": "#4ec9b0", // {{dark.cyan}}
            "background": "#4ec9b0", // {{dark.cyan}}
            "selection": "#4ec9b01a", // {{dark.cyan_alpha10}}
          },
          {
            "cursor": "#dcdcaa", // {{dark.yellow}}
            "background": "#dcdcaa", // {{dark.yellow}}
            "selection": "#dcdcaa1a", // {{dark.yellow_alpha10}}
          },
          {
            "cursor": "#f67070", // {{dark.red}}
            "background": "#f67070", // {{dark.red}}
            "selection": "#f670701a", // {{dark.red_alpha10}}
          },
          {
            "cursor": "#d7ba7d", // {{dark.gold}}
            "background": "#d7ba7d", // {{dark.gold}}
            "selection": "#d7ba7d1a", // {{dark.gold_alpha10}}
          },
        ],
        "accents": [
          "#5ca0d7", // {{dark.blue}}
          "#76a762", // {{dark.green}}
          "#ce9178", // {{dark.orange}}
          "#c586c0", // {{dark.purple}}
          "#4ec9b0", // {{dark.cyan}}
          "#dcdcaa", // {{dark.yellow}}
          "#f67070", // {{dark.red}}
        ],
