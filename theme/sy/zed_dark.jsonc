/*
Sy dark native template. Colors are generated from _palette_dark.jsonc.
Edit marker roles, then run make format_build_include; do not edit generated literals.
*/
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Sy Dark", // {{dark.themeName}}
  "author": "synle",
  "themes": [
    {
      "name": "Sy Dark", // {{dark.themeName}}
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "background": "#161616", // {{dark.surface}}
        "editor.background": "#0a0a0a", // {{dark.background}}
        "editor.foreground": "#e8e8e8", // {{dark.foreground}}
        "editor.gutter.background": "#0a0a0a", // {{dark.background}}
        "editor.subheader.background": "#161616", // {{dark.surface}}
        "editor.active_line.background": "#1f2a38", // {{dark.activeLine}}
        "editor.highlighted_line.background": "#1f2a38", // {{dark.activeLine}}
        "editor.line_number": "#a0a0a0", // {{dark.brightBlack}}
        "editor.active_line_number": "#5ca0d7", // {{dark.blue}}
        "editor.hover_line_number": "#e8e8e8", // {{dark.foreground}}
        "editor.invisible": "#464646", // {{dark.guide}}
        "editor.wrap_guide": "#464646", // {{dark.guide}}
        "editor.active_wrap_guide": "#6e6e6e", // {{dark.brightGray}}
        "editor.indent_guide": "#464646", // {{dark.guide}}
        "editor.indent_guide_active": "#6e6e6e", // {{dark.brightGray}}
        "editor.document_highlight.read_background": "#5ca0d733", // {{dark.blue_alpha20}}
        "editor.document_highlight.write_background": "#ce917833", // {{dark.orange_alpha20}}
        "editor.document_highlight.bracket_background": "#6e6e6e66", // {{dark.brightGray_alpha40}}
        "text": "#e8e8e8", // {{dark.foreground}}
        "text.muted": "#b2b2b2", // {{dark.textSecondary}}
        "text.placeholder": "#b2b2b2", // {{dark.textSecondary}}
        "text.disabled": "#8f8f8f", // {{dark.textDisabled}}
        "text.accent": "#5ca0d7", // {{dark.blue}}
        "icon": "#e8e8e8", // {{dark.foreground}}
        "icon.muted": "#b2b2b2", // {{dark.textSecondary}}
        "icon.disabled": "#8f8f8f", // {{dark.textDisabled}}
        "icon.placeholder": "#b2b2b2", // {{dark.textSecondary}}
        "icon.accent": "#5ca0d7", // {{dark.blue}}
        "element.background": "#161616", // {{dark.surface}}
        "element.hover": "#2b2b2b", // {{dark.gray}}
        "element.active": "#3d3d3d", // {{dark.pressed}}
        "element.selected": "#1b3c5e", // {{dark.selection}}
        "element.disabled": "#161616", // {{dark.surface}}
        "ghost_element.background": "#0a0a0a00", // {{dark.background_alpha0}}
        "ghost_element.hover": "#2b2b2b", // {{dark.gray}}
        "ghost_element.active": "#3d3d3d", // {{dark.pressed}}
        "ghost_element.selected": "#1b3c5e", // {{dark.selection}}
        "ghost_element.disabled": "#161616", // {{dark.surface}}
        "drop_target.background": "#5ca0d733", // {{dark.blue_alpha20}}
        "surface.background": "#161616", // {{dark.surface}}
        "elevated_surface.background": "#161616", // {{dark.surface}}
        "panel.background": "#161616", // {{dark.surface}}
        "panel.focused_border": "#5ca0d7", // {{dark.blue}}
        "panel.indent_guide": "#464646", // {{dark.guide}}
        "panel.indent_guide_active": "#6e6e6e", // {{dark.brightGray}}
        "panel.indent_guide_hover": "#a0a0a0", // {{dark.brightBlack}}
        "pane.focused_border": "#5ca0d7", // {{dark.blue}}
        "pane_group.border": "#6e6e6e", // {{dark.brightGray}}
        "title_bar.background": "#161616", // {{dark.surface}}
        "title_bar.inactive_background": "#0a0a0a", // {{dark.background}}
        "toolbar.background": "#161616", // {{dark.surface}}
        "tab_bar.background": "#161616", // {{dark.surface}}
        "tab.inactive_background": "#161616", // {{dark.surface}}
        "tab.active_background": "#0a0a0a", // {{dark.background}}
        "search.match_background": "#2b2106", // {{dark.matchHighlightSyntax}}
        "search.active_match_background": "#162129", // {{dark.activeMatchSyntax}}
        "status_bar.background": "#161616", // {{dark.surface}}
        "scrollbar.thumb.background": "#a0a0a0", // {{dark.brightBlack}}
        "scrollbar.thumb.hover_background": "#e8e8e8", // {{dark.foreground}}
        "scrollbar.thumb.border": "#6e6e6e", // {{dark.brightGray}}
        "scrollbar.track.background": "#0a0a0a", // {{dark.background}}
        "scrollbar.track.border": "#0a0a0a", // {{dark.background}}
        "border": "#6e6e6e", // {{dark.brightGray}}
        "border.variant": "#6e6e6e", // {{dark.brightGray}}
        "border.focused": "#5ca0d7", // {{dark.blue}}
        "border.selected": "#5ca0d7", // {{dark.blue}}
        "border.transparent": "#0a0a0a00", // {{dark.background_alpha0}}
        "border.disabled": "#464646", // {{dark.guide}}
        "link_text.hover": "#4fc1ff", // {{dark.linkBlue}}
        "conflict": "#ce9178", // {{dark.orange}}
        "conflict.background": "#ce91781a", // {{dark.orange_alpha10}}
        "conflict.border": "#ce9178", // {{dark.orange}}
        "created": "#76a762", // {{dark.green}}
        "created.background": "#76a7621a", // {{dark.green_alpha10}}
        "created.border": "#76a762", // {{dark.green}}
        "deleted": "#f67070", // {{dark.red}}
        "deleted.background": "#f670701a", // {{dark.red_alpha10}}
        "deleted.border": "#f67070", // {{dark.red}}
        "modified": "#dcdcaa", // {{dark.yellow}}
        "modified.background": "#dcdcaa1a", // {{dark.yellow_alpha10}}
        "modified.border": "#dcdcaa", // {{dark.yellow}}
        "renamed": "#5ca0d7", // {{dark.blue}}
        "renamed.background": "#5ca0d71a", // {{dark.blue_alpha10}}
        "renamed.border": "#5ca0d7", // {{dark.blue}}
        "version_control.added": "#76a762", // {{dark.green}}
        "version_control.modified": "#dcdcaa", // {{dark.yellow}}
        "version_control.deleted": "#f67070", // {{dark.red}}
        "version_control.word_added": "#76a76233", // {{dark.green_alpha20}}
        "version_control.word_deleted": "#f6707033", // {{dark.red_alpha20}}
        "version_control.conflict_marker.ours": "#76a76233", // {{dark.green_alpha20}}
        "version_control.conflict_marker.theirs": "#5ca0d733", // {{dark.blue_alpha20}}
        "error": "#f67070", // {{dark.red}}
        "error.background": "#f670701a", // {{dark.red_alpha10}}
        "error.border": "#f67070", // {{dark.red}}
        "warning": "#dcdcaa", // {{dark.yellow}}
        "warning.background": "#dcdcaa1a", // {{dark.yellow_alpha10}}
        "warning.border": "#dcdcaa", // {{dark.yellow}}
        "info": "#5ca0d7", // {{dark.blue}}
        "info.background": "#5ca0d71a", // {{dark.blue_alpha10}}
        "info.border": "#5ca0d7", // {{dark.blue}}
