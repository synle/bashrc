          },
          "number": {
            "color": "#b5cea8", // {{dark.lightGreen}}
          },
          "operator": {
            "color": "#e8e8e8", // {{dark.foreground}}
          },
          "predictive": {
            "font_style": "italic",
            "color": "#b2b2b2", // {{dark.textSecondary}}
          },
