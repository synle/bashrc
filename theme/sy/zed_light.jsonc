  "sourceText": "{\n  // High Contrast Light - modeled after VS Code Default High Contrast Light.\n  // Values are generated: every `// {{light.key}}` marker is rewritten from COLOR_MAP in\n  // software/tools/build-include.js by `make format_build_include`. Edit the marker, not the hex.\n  //\n  // Layering rules (see the COLOR_MAP JSDoc for the FILL / STROKE / FOREGROUND split):\n  // - editor surfaces stay on `background`; chrome (title bar, tabs, panels, status bar) sits on\n  //   `surface` so the editor visually pops out of the frame.\n  // - every `*.background` is an `_alpha10` tint of its matching foreground, never the solid color -\n  //   Zed paints text ON these, so a solid fill makes the text invisible.\n  // - interactive fills ladder up `surface` -> `gray` (hover) -> `pressed` (active) -> `selection`;\n  //   `activeLine` is editor-only and must not be reused for chrome states.\n  \"$schema\": \"https://zed.dev/schema/themes/v0.2.0.json\",\n  \"name\": \"Sy Light\", // {{light.themeName}}\n  \"author\": \"synle\",\n  \"themes\": [\n    {\n      \"name\": \"Sy Light\", // {{light.themeName}}\n      \"appearance\": \"light\",\n      \"style\": {\n        // --- Editor Chrome ---\n        \"background.appearance\": \"opaque\",\n        \"background\": \"#ececec\", // {{light.surface}}\n        \"editor.background\": \"#f8f8f8\", // {{light.background}}\n        \"editor.foreground\": \"#1e1e1e\", // {{light.foreground}}\n        \"editor.gutter.background\": \"#f8f8f8\", // {{light.background}}\n        \"editor.subheader.background\": \"#ececec\", // {{light.surface}}\n        \"editor.active_line.background\": \"#cfe0f7\", // {{light.activeLine}}\n        \"editor.highlighted_line.background\": \"#cfe0f7\", // {{light.activeLine}}\n        \"editor.line_number\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"editor.active_line_number\": \"#0033b3\", // {{light.blue}}\n        \"editor.hover_line_number\": \"#1e1e1e\", // {{light.foreground}}\n        \"editor.invisible\": \"#a4a4a4\", // {{light.guide}}\n        \"editor.wrap_guide\": \"#a4a4a4\", // {{light.guide}}\n        \"editor.active_wrap_guide\": \"#262626\", // {{light.brightGray}}\n        \"editor.indent_guide\": \"#a4a4a4\", // {{light.guide}}\n        \"editor.indent_guide_active\": \"#262626\", // {{light.brightGray}}\n        \"editor.document_highlight.read_background\": \"#0033b333\", // {{light.blue_alpha20}}\n        \"editor.document_highlight.write_background\": \"#8a3f2033\", // {{light.orange_alpha20}}\n        \"editor.document_highlight.bracket_background\": \"#26262666\", // {{light.brightGray_alpha40}}\n\n        // --- Text ---\n        \"text\": \"#1e1e1e\", // {{light.foreground}}\n        \"text.muted\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"text.placeholder\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"text.disabled\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"text.accent\": \"#0033b3\", // {{light.blue}}\n\n        // --- Icons ---\n        \"icon\": \"#1e1e1e\", // {{light.foreground}}\n        \"icon.muted\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"icon.disabled\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"icon.placeholder\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"icon.accent\": \"#0033b3\", // {{light.blue}}\n\n        // --- UI Elements ---\n        // Disabled reuses the base fill (no state change) so it cannot be mistaken for hover.\n        \"element.background\": \"#ececec\", // {{light.surface}}\n        \"element.hover\": \"#cacaca\", // {{light.gray}}\n        \"element.active\": \"#b0b0b0\", // {{light.pressed}}\n        \"element.selected\": \"#96c6fa\", // {{light.selection}}\n        \"element.disabled\": \"#ececec\", // {{light.surface}}\n        \"ghost_element.background\": \"#f8f8f800\", // {{light.background_alpha0}}\n        \"ghost_element.hover\": \"#cacaca\", // {{light.gray}}\n        \"ghost_element.active\": \"#b0b0b0\", // {{light.pressed}}\n        \"ghost_element.selected\": \"#96c6fa\", // {{light.selection}}\n        \"ghost_element.disabled\": \"#ececec\", // {{light.surface}}\n        \"drop_target.background\": \"#0033b333\", // {{light.blue_alpha20}}\n\n        // --- Surface / Panel ---\n        \"surface.background\": \"#ececec\", // {{light.surface}}\n        \"elevated_surface.background\": \"#ececec\", // {{light.surface}}\n        \"panel.background\": \"#ececec\", // {{light.surface}}\n        \"panel.focused_border\": \"#0033b3\", // {{light.blue}}\n        \"panel.indent_guide\": \"#a4a4a4\", // {{light.guide}}\n        \"panel.indent_guide_active\": \"#262626\", // {{light.brightGray}}\n        \"panel.indent_guide_hover\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"pane.focused_border\": \"#0033b3\", // {{light.blue}}\n        \"pane_group.border\": \"#262626\", // {{light.brightGray}}\n        \"title_bar.background\": \"#ececec\", // {{light.surface}}\n        \"title_bar.inactive_background\": \"#f8f8f8\", // {{light.background}}\n        \"toolbar.background\": \"#ececec\", // {{light.surface}}\n        \"tab_bar.background\": \"#ececec\", // {{light.surface}}\n        \"tab.inactive_background\": \"#ececec\", // {{light.surface}}\n        \"tab.active_background\": \"#f8f8f8\", // {{light.background}}\n        \"search.match_background\": \"#ffbe3d\", // {{light.matchHighlight}}\n        \"search.active_match_background\": \"#0033b366\", // {{light.blue_alpha40}}\n        \"status_bar.background\": \"#ececec\", // {{light.surface}}\n        \"scrollbar.thumb.background\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"scrollbar.thumb.hover_background\": \"#1e1e1e\", // {{light.foreground}}\n        \"scrollbar.thumb.border\": \"#262626\", // {{light.brightGray}}\n        \"scrollbar.track.background\": \"#f8f8f8\", // {{light.background}}\n        \"scrollbar.track.border\": \"#f8f8f8\", // {{light.background}}\n\n        // --- Borders ---\n        \"border\": \"#262626\", // {{light.brightGray}}\n        \"border.variant\": \"#262626\", // {{light.brightGray}}\n        \"border.focused\": \"#0033b3\", // {{light.blue}}\n        \"border.selected\": \"#0033b3\", // {{light.blue}}\n        \"border.transparent\": \"#f8f8f800\", // {{light.background_alpha0}}\n        \"border.disabled\": \"#a4a4a4\", // {{light.guide}}\n\n        // --- Links ---\n        \"link_text.hover\": \"#0252ad\", // {{light.linkBlue}}\n\n        // --- Conflict / Diff ---\n        \"conflict\": \"#6a5100\", // {{light.brown}}\n        \"conflict.background\": \"#6a51001a\", // {{light.brown_alpha10}}\n        \"conflict.border\": \"#6a5100\", // {{light.brown}}\n        \"created\": \"#004a15\", // {{light.green}}\n        \"created.background\": \"#004a151a\", // {{light.green_alpha10}}\n        \"created.border\": \"#004a15\", // {{light.green}}\n        \"deleted\": \"#840000\", // {{light.red}}\n        \"deleted.background\": \"#8400001a\", // {{light.red_alpha10}}\n        \"deleted.border\": \"#840000\", // {{light.red}}\n        \"modified\": \"#775502\", // {{light.yellow}}\n        \"modified.background\": \"#7755021a\", // {{light.yellow_alpha10}}\n        \"modified.border\": \"#775502\", // {{light.yellow}}\n        \"renamed\": \"#0033b3\", // {{light.blue}}\n        \"renamed.background\": \"#0033b31a\", // {{light.blue_alpha10}}\n        \"renamed.border\": \"#0033b3\", // {{light.blue}}\n\n        // --- Version Control ---\n        \"version_control.added\": \"#004a15\", // {{light.green}}\n        \"version_control.modified\": \"#775502\", // {{light.yellow}}\n        \"version_control.deleted\": \"#840000\", // {{light.red}}\n        \"version_control.word_added\": \"#004a1533\", // {{light.green_alpha20}}\n        \"version_control.word_deleted\": \"#84000033\", // {{light.red_alpha20}}\n        \"version_control.conflict_marker.ours\": \"#004a1533\", // {{light.green_alpha20}}\n        \"version_control.conflict_marker.theirs\": \"#0033b333\", // {{light.blue_alpha20}}\n\n        // --- Diagnostics ---\n        \"error\": \"#840000\", // {{light.red}}\n        \"error.background\": \"#8400001a\", // {{light.red_alpha10}}\n        \"error.border\": \"#840000\", // {{light.red}}\n        \"warning\": \"#775502\", // {{light.yellow}}\n        \"warning.background\": \"#7755021a\", // {{light.yellow_alpha10}}\n        \"warning.border\": \"#775502\", // {{light.yellow}}\n        \"info\": \"#0033b3\", // {{light.blue}}\n        \"info.background\": \"#0033b31a\", // {{light.blue_alpha10}}\n        \"info.border\": \"#0033b3\", // {{light.blue}}\n        \"hint\": \"#145e5e\", // {{light.brightCyan}}\n        \"hint.background\": \"#145e5e1a\", // {{light.brightCyan_alpha10}}\n        \"hint.border\": \"#145e5e\", // {{light.brightCyan}}\n        \"success\": \"#004a15\", // {{light.green}}\n        \"success.background\": \"#004a151a\", // {{light.green_alpha10}}\n        \"success.border\": \"#004a15\", // {{light.green}}\n        \"predictive\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"predictive.background\": \"#5a5a5a1a\", // {{light.textDisabled_alpha10}}\n        \"predictive.border\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"unreachable\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"unreachable.background\": \"#5a5a5a1a\", // {{light.textDisabled_alpha10}}\n        \"unreachable.border\": \"#5a5a5a\", // {{light.textDisabled}}\n        \"hidden\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"hidden.background\": \"#4a4a4a1a\", // {{light.brightBlack_alpha10}}\n        \"hidden.border\": \"#262626\", // {{light.brightGray}}\n        \"ignored\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"ignored.background\": \"#4a4a4a1a\", // {{light.brightBlack_alpha10}}\n        \"ignored.border\": \"#262626\", // {{light.brightGray}}\n\n        // --- Players (local cursor + selection; Zed reads selection from players[0], not selection.background) ---\n        \"players\": [\n          {\n            \"cursor\": \"#0451a5\", // {{light.cursorColor}}\n            \"background\": \"#0451a5\", // {{light.cursorColor}}\n            \"selection\": \"#96c6fa\", // {{light.selection}}\n          },\n        ],\n\n        // --- Accents (collaborator cursors, rainbow indent) — spaced around the hue wheel ---\n        \"accents\": [\n          \"#0033b3\", // {{light.blue}}\n          \"#004a15\", // {{light.green}}\n          \"#8a3f20\", // {{light.orange}}\n          \"#8700c1\", // {{light.brightPurple}}\n          \"#145e5e\", // {{light.brightCyan}}\n          \"#775502\", // {{light.yellow}}\n          \"#840000\", // {{light.red}}\n        ],\n\n        // --- Syntax ---\n        \"syntax\": {\n          \"attribute\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"boolean\": { \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"comment\": { \"color\": \"#004a15\" }, // {{light.green}}\n          \"comment.doc\": { \"color\": \"#004a15\" }, // {{light.green}}\n          \"constant\": { \"color\": \"#00416f\" }, // {{light.cyan}}\n          \"constructor\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n          \"diff.minus\": { \"color\": \"#840000\" }, // {{light.red}}\n          \"diff.plus\": { \"color\": \"#004a15\" }, // {{light.green}}\n          \"embedded\": { \"color\": \"#a12626\" }, // {{light.brightRed}}\n          \"emphasis\": { \"font_style\": \"italic\", \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"emphasis.strong\": { \"font_weight\": 700, \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"enum\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n          \"function\": { \"color\": \"#6a5100\" }, // {{light.brown}}\n          \"function.builtin\": { \"color\": \"#6a5100\" }, // {{light.brown}}\n          \"hint\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n          \"keyword\": { \"font_weight\": 700, \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"label\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"link_text\": { \"color\": \"#a12626\" }, // {{light.brightRed}}\n          \"link_uri\": { \"color\": \"#0252ad\" }, // {{light.linkBlue}}\n          \"namespace\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n          \"number\": { \"color\": \"#03623a\" }, // {{light.darkGreen}}\n          \"operator\": { \"color\": \"#1e1e1e\" }, // {{light.foreground}}\n          \"predictive\": { \"font_style\": \"italic\", \"color\": \"#5a5a5a\" }, // {{light.textDisabled}}\n          \"preproc\": { \"color\": \"#8700c1\" }, // {{light.brightPurple}}\n          \"primary\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"property\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"punctuation\": { \"color\": \"#1e1e1e\" }, // {{light.foreground}}\n          \"punctuation.bracket\": { \"color\": \"#1e1e1e\" }, // {{light.foreground}}\n          \"punctuation.delimiter\": { \"color\": \"#1e1e1e\" }, // {{light.foreground}}\n          \"punctuation.list_marker\": { \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"punctuation.markup\": { \"color\": \"#4a4a4a\" }, // {{light.brightBlack}}\n          \"punctuation.special\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"selector\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"selector.pseudo\": { \"color\": \"#8700c1\" }, // {{light.brightPurple}}\n          \"string\": { \"color\": \"#a12626\" }, // {{light.brightRed}}\n          \"string.escape\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"string.regex\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"string.special\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"string.special.symbol\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"tag\": { \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"text.literal\": { \"color\": \"#a12626\" }, // {{light.brightRed}}\n          \"title\": { \"font_weight\": 700, \"color\": \"#9b2c2c\" }, // {{light.darkRed}}\n          \"type\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n          \"variable\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"variable.parameter\": { \"color\": \"#001080\" }, // {{light.darkBlue}}\n          \"variable.special\": { \"color\": \"#0033b3\" }, // {{light.blue}}\n          \"variant\": { \"color\": \"#145e5e\" }, // {{light.brightCyan}}\n        },\n\n        // --- Terminal ---\n        // `dim_*` is the base hue at 60% over the terminal background — SGR 2 must read as a\n        // faded version of its base, so it is derived from the base rather than picked by hand.\n        \"terminal.background\": \"#f8f8f8\", // {{light.background}}\n        \"terminal.ansi.background\": \"#f8f8f8\", // {{light.background}}\n        \"terminal.foreground\": \"#1e1e1e\", // {{light.foreground}}\n        \"terminal.bright_foreground\": \"#000000\", // {{light.black}}\n        \"terminal.dim_foreground\": \"#6d6d6d\", // {{light.white}}\n        \"terminal.ansi.black\": \"#000000\", // {{light.black}}\n        \"terminal.ansi.red\": \"#840000\", // {{light.red}}\n        \"terminal.ansi.green\": \"#004a15\", // {{light.green}}\n        \"terminal.ansi.yellow\": \"#775502\", // {{light.yellow}}\n        \"terminal.ansi.blue\": \"#0033b3\", // {{light.blue}}\n        \"terminal.ansi.magenta\": \"#6c0099\", // {{light.purple}}\n        \"terminal.ansi.cyan\": \"#00416f\", // {{light.cyan}}\n        \"terminal.ansi.white\": \"#6d6d6d\", // {{light.white}}\n        \"terminal.ansi.bright_black\": \"#4a4a4a\", // {{light.brightBlack}}\n        \"terminal.ansi.bright_red\": \"#a12626\", // {{light.brightRed}}\n        \"terminal.ansi.bright_green\": \"#106145\", // {{light.brightGreen}}\n        \"terminal.ansi.bright_yellow\": \"#7f6000\", // {{light.brightYellow}}\n        \"terminal.ansi.bright_blue\": \"#0051ae\", // {{light.brightBlue}}\n        \"terminal.ansi.bright_magenta\": \"#8700c1\", // {{light.brightPurple}}\n        \"terminal.ansi.bright_cyan\": \"#145e5e\", // {{light.brightCyan}}\n        \"terminal.ansi.bright_white\": \"#8b8b8b\", // {{light.brightWhite}}\n        \"terminal.ansi.dim_black\": \"#00000099\", // {{light.black_alpha60}}\n        \"terminal.ansi.dim_red\": \"#84000099\", // {{light.red_alpha60}}\n        \"terminal.ansi.dim_green\": \"#004a1599\", // {{light.green_alpha60}}\n        \"terminal.ansi.dim_yellow\": \"#77550299\", // {{light.yellow_alpha60}}\n        \"terminal.ansi.dim_blue\": \"#0033b399\", // {{light.blue_alpha60}}\n        \"terminal.ansi.dim_magenta\": \"#6c009999\", // {{light.purple_alpha60}}\n        \"terminal.ansi.dim_cyan\": \"#00416f99\", // {{light.cyan_alpha60}}\n        \"terminal.ansi.dim_white\": \"#6d6d6d99\", // {{light.white_alpha60}}\n      },\n    },\n  ],\n}\n",
}
