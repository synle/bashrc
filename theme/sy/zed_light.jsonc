          },
          "terminal.background": "#f8f8f8",
          "terminal.ansi.background": "#f8f8f8",
          "terminal.foreground": "#1e1e1e",
          "terminal.bright_foreground": "#000000",
          "terminal.dim_foreground": "#6d6d6d",
